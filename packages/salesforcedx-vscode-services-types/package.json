{
  "name": "@salesforce/vscode-services",
  "version": "67.27.1",
  "description": "TypeScript type definitions for Salesforce VS Code Services extension API",
  "author": "Salesforce",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-vscode"
  },
  "bugs": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode/issues"
  },
  "homepage": "https://github.com/forcedotcom/salesforcedx-vscode/tree/develop/packages/salesforcedx-vscode-services-types",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out/**",
    "README.md",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate-entry": "ts-node scripts/generateEntry.ts",
    "sync-deps": "ts-node scripts/syncDeps.ts",
    "compile": "wireit",
    "clean": "shx rm -rf src out dist node_modules .wireit .eslintcache *.tgz",
    "check:knip": "wireit"
  },
  "wireit": {
    "generate-src": {
      "command": "ts-node scripts/generateEntry.ts && ts-node scripts/syncDeps.ts",
      "files": [
        "../salesforcedx-vscode-services/src/**/*.ts",
        "scripts/*.ts"
      ],
      "output": [
        "src/index.ts",
        "src/icons.ts"
      ]
    },
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "dependencies": [
        "generate-src",
        "../salesforcedx-vscode-services:compile"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "check:knip": {
      "command": "../../node_modules/.bin/knip --directory ../.. --workspace packages/salesforcedx-vscode-services-types --cache --cache-location ../../node_modules/.cache/knip-salesforcedx-vscode-services-types --include exports,types,nsExports,nsTypes --no-config-hints",
      "files": [
        "../../*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../../.gitignore",
        "../../.pnpmfile.cjs",
        "../../{scripts,test,test-workspaces,config,.github,.opencode}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org/.gitignore",
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        ".gitignore",
        "../salesforcedx-vscode-soql/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/.gitignore",
        "../soql-builder-ui/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../soql-builder-ui/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../soql-builder-ui/.gitignore"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.43",
    "@effect/opentelemetry": "0.63.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@opentelemetry/sdk-trace-web": "2.8.0",
    "@salesforce/core": "^9.1.9",
    "@salesforce/source-deploy-retrieve": "^13.2.0",
    "@salesforce/source-tracking": "^8.0.0",
    "@types/vscode": "^1.90.0",
    "effect": "^3.21.2",
    "jsforce": "^3.10.24",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "shx": "^0.4.0",
    "ts-node": "^10.9.2"
  }
}
