{
  "name": "@salesforce/soql-model",
  "version": "1.0.0",
  "private": true,
  "description": "SOQL query model, serialization, and field validators",
  "publisher": "salesforce",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-vscode.git",
    "directory": "packages/soql-model"
  },
  "bugs": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode/issues"
  },
  "homepage": "https://github.com/forcedotcom/salesforcedx-vscode/tree/main/packages/soql-model#readme",
  "main": "out/src/index.js",
  "types": "out/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.d.ts",
      "default": "./out/src/index.js"
    }
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-root-install.js",
    "compile": "wireit",
    "lint": "wireit",
    "clean": "shx rm -rf node_modules out dist coverage .wireit .eslintcache .circular-deps.json",
    "test": "wireit",
    "check:knip": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "dependencies": [
        "../soql-common:compile"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "test": {
      "command": "jest",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "jest.config.js",
        "../../config/jest.base.config.js"
      ],
      "output": [
        "coverage"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "check:circular-deps",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test/tsconfig.json",
        "../../eslint.config.mjs",
        "package.json"
      ],
      "output": []
    },
    "check:circular-deps": {
      "command": "dpdm --no-warning --no-tree --exit-code circular:1 --output .circular-deps.json src/index.ts",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "package.json"
      ],
      "output": [
        ".circular-deps.json"
      ]
    },
    "check:knip": {
      "command": "../../node_modules/.bin/knip --directory ../.. --workspace packages/soql-model --cache --cache-location ../../node_modules/.cache/knip-soql-model --include exports,types,nsExports,nsTypes --no-config-hints",
      "files": [
        "../../*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../../.gitignore",
        "../../.pnpmfile.cjs",
        "../../{scripts,test,test-workspaces,config,.github,.opencode}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/.gitignore",
        "../soql-common/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../soql-common/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../soql-common/.gitignore",
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        ".gitignore"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@salesforce/soql-common": "*",
    "antlr4ts": "^0.5.0-alpha.3"
  }
}
