# Exclude test and development files
**/.vscode-test/**
**/test/**
**/*.test.*
**/*.spec.*

# Exclude source files (keep only compiled output)
src/**/*.ts
!src/**/*.d.ts

# Exclude build artifacts
*.log
.eslintcache
.nyc_output/
coverage/
.wireit/

# Exclude config files
tsconfig*.json
.eslintrc*
.prettierrc*
.mocharc*
webpack*.js

# Exclude monorepo root files and sibling packages
# These get included when vsce resolves workspace dependencies
**/../*.json
**/../*.md
**/../*.txt
**/../*.js
**/../*.mjs
**/../**/node_modules/**
