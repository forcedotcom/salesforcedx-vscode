     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="MarketSegmentDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents the field values for MarketSegmentDefinition. MarketSegmentDefinition is used to store the exportable metadata of a segment, such as segment criteria and other attributes. Developers can create segment definition packages, pass segment definition in the form of data build tool (DBT), and publish it on AppExchange for subscriber organizations to install and instantiate these segments.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_marketsegmentdefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="additionalMetadata" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>An XML CLOB to hold name-value pairs for storing additional metadata. Not applicable for DBT type segment.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="excludeCriteria" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Holds the JSON exclude criteria for UI based segments. Not applicable for DBT or Lookalike segments.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="includeCriteria" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>An XML wrapped in a CDATA section that captures DBT definition. Only single model DBT is supported.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the display name of the field value.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="segmentOn" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required when segmentType is UI. Points to relevant MktDataModelObject entity instance. A valid developerName for an MktDataModelObject instance of Profile type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="segmentType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the type of the segment to be created. Only DBT is supported via API. Values are: DBT Dynamic Lookalike UI EinsteinGPTSegmentsUI</xsd:documentation>
       <xsd:appinfo>Type: MarketSegmentType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="MktDataTranField">
  <xsd:annotation>
   <xsd:documentation>This is a sub-type to MktDataTranObject.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_mktdatatranobject.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="creationType" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Optional: Was this object added as a result of the Customer, part of a Standard Taxonomy. Valid values available in API version 62.0 and later are: ADG Calculated_Insight CG_Audience Chunk Directory_Table External Semantic Transform Vector_Embedding Available in API version 67.0 and later: Ad_Audience_Insights Auxiliary Clean_Room Deletion_Records Problem_Records</xsd:documentation>
       <xsd:appinfo>Type: DefinitionCreationType</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="datatype" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Phone, currency, number, or other assigned type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dateFormat" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Optional: The Date format of date, time, date/time fields in this Transport field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Optional. Name of the object in the external system (different from Developer Name).</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDataRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Optional. If true, data is required for this field.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="length" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Optional. Length of a string column</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Optional? Field label.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="precision" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Optional. Used for currency and numeric accuracy.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="primaryIndexOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Optional. If supplied, indicates this field is part of the primary key where the number value (starting at 1) indicates the order of attributes if this happens to be a compound primary key. Missing value means this field is not part of the primary key.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="scale" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Optional. Used for currency and numeric accuracy.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sequence" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Optional. The sequence of this source schema.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="MktDataTranObject">
  <xsd:annotation>
   <xsd:documentation>An entity that is used to deliver (aka transport) information from the source to a target (target will be called a landing entity).This can be the schema of a file, API, Event, or other means of transporting data, such as SubscriberFile1.csv, or SubscriberCDCEvent.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_mktdatatranobject.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="connector" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Data 360 connector name that allows you to connect the data source to Data 360.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="creationType" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Required. Describe whether this object was added as the result of the Customer or as part of a Standard Taxonomy. Valid values available in API version 62.0 and later are: ADG Calculated_Insight CG_Audience Chunk Directory_Table External Semantic Transform Vector_Embedding Valid values available in API version 67.0 and later are: Ad_Audience_Insights Auxiliary Clean_Room Deletion_Records Problem_Records</xsd:documentation>
       <xsd:appinfo>Type: DefinitionCreationType</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataSource" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Your reference to the data source from which the data originated (source of that data such as the name of a CRM Org. Example: MC Enterprise.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataSourceObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the object name from where the data is sourced. Example: ecommerce-OrderItem.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The UI name for the Data Transport Object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the Object Category. For Transport, these are Profile, Engagement, or Other.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ObjectSourceTargetMap">
  <xsd:annotation>
   <xsd:documentation>Contains the object-level mappings between the source and the target objects. The source and target objects can be an MktDataLakeObject or an MktDataModelObject. For example, an Email source object can be mapped to the ContactPointEmail object.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_objectsourcetargetmap.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="creationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Describes whether this object was added by the user or as part of a standard taxonomy. Valid values are: ADG Activation_Audience Bridge Calculated_Insight CG_Audience (Available in API version 62.0 and later) Chunk Curated Custom Derived Directory_Table External Ml_Prediction Segment_Membership Semantic Standard System Transform Vector_Embedding</xsd:documentation>
       <xsd:appinfo>Type: DefinitionCreationType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fieldSourceTargetMaps" minOccurs="0" maxOccurs="unbounded" type="FieldSourceTargetMap">
      <xsd:annotation>
       <xsd:documentation>Contains the field-level mappings associated with this object mapping.</xsd:documentation>
       <xsd:appinfo>Type: FieldSourceTargetMap[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The UI name for the target map.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sequenceNbr" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Use this field to display multiple mappings between the same two objects, for a consistent customer experience when presenting the mappings.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceObjectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the source object that’s mapped, such as Email, or SfmcEnt1_Subscriber.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetObjectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the target object that’s mapped, such as ContactPointEmail or Individual.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="StreamingAppDataConnector">
  <xsd:annotation>
   <xsd:documentation>Represents the connection information specific to Web and Mobile Connectors.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_streamingappdataconnector.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="appIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique app identifier (UUID).</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataConnectorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The value of the field is restricted to SteamingApp.Possible values are: DataCloud StreamingApp</xsd:documentation>
       <xsd:appinfo>Type: DataConnectorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t impact the behavior of the metadata type.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The display name of the connector.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="streamingAppDataConnectorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of connector.Possible values are: MobileApp WebApp</xsd:documentation>
       <xsd:appinfo>Type: StreamingAppDataConnectorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
