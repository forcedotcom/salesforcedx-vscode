       <xsd:documentation>The parameters for the navigation widget. This is a JSON String.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AnalyticsParamWidgetDef">
  <xsd:annotation>
   <xsd:documentation>Represents a parameters widget definition for a Tableau Next dashboard.</xsd:documentation>
