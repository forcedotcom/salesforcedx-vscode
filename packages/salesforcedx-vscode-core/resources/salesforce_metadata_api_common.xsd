   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="PermissionSet">
  <xsd:annotation>
   <xsd:documentation>Represents a set of permissions that&apos;s used to grant more access to one or more users without changing their profile or reassigning profiles. You can use permission sets to grant access but not to deny access. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_permissionset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="agentAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetAgentAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates which agents are visible to users assigned to this permission set. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetAgentAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="applicationVisibilities" minOccurs="0" maxOccurs="unbounded" type="PermissionSetApplicationVisibility">
      <xsd:annotation>
       <xsd:documentation>Indicates which apps are visible to users assigned to this permission set. Available in API version 29.0 and later. In API version 29.0, this field supports custom apps only. In API version 30.0 and later, this field supports both standard and custom apps.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetApplicationVisibility[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="classAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetApexClassAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates which top-level Apex classes have methods that users assigned to this permission set can execute. Available in API version 23.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetApexClassAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customMetadataTypeAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetCustomMetadataTypeAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates the custom metadata types that are read-accessible to a user assigned to this permission set. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetCustomMetadataTypeAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customPermissions" minOccurs="0" maxOccurs="unbounded" type="PermissionSetCustomPermissions">
      <xsd:annotation>
       <xsd:documentation>Indicates which custom permissions are available to users assigned to this permission set. Available in API version 31.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetCustomPermissions[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customSettingAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetCustomSettingAccesses">
      <xsd:annotation>
       <xsd:documentation>Indicates the custom settings that are read-accessible to a user assigned to this permission set. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetCustomSettingAccesses[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The permission set description. Limit: 255 characters.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="emailRoutingAddressAccesses" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Indicates the Email Routing Address permissions that are available to users assigned to a permission set. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetEmailRoutingAddressAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalCredentialPrincipalAccesses" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Indicates which external credential principals are available to users assigned to this permission set. Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetExternalCredentialPrincipalAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalDataSourceAccesses" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Indicates which data sources with identity type of Per User are available to users assigned to this permission set. Available in API version 27.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetExternal DataSourceAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fieldPermissions" minOccurs="0" maxOccurs="unbounded" type="PermissionSetFieldPermissions">
      <xsd:annotation>
       <xsd:documentation>Indicates which fields are accessible to a user assigned to this permission set, and the kind of access available (readable or editable). Available in API version 23.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetFieldPermissions[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="flowAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetFlowAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates which flows can be accessed by a user assigned to this permission set. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetFlowAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="hasActivationRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the permission set requires an associated active session (true) or not (false). Available in API version 37.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The permission set label. Limit: 80 characters.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="license" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Either the related permission set license or the user license associated with this permission set. Available in API version 38.0 and later. Use this field instead of userLicense, which is deprecated and only available up to API Version 37.0.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="genComputingSummaryDefAccess" minOccurs="0" maxOccurs="unbounded" type="PermissionSetGenComputingSummaryDefAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates the enhanced summary access configuration for users assigned through a permission set. Available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetGenComputingSummaryDefAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectPermissions" minOccurs="0" maxOccurs="unbounded" type="PermissionSetObjectPermissions">
      <xsd:annotation>
       <xsd:documentation>Indicates the objects that are accessible to a user assigned to this permission set, and the kind of access available (create, read, edit, delete, and so on). Available in API version 23.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetObjectPermissions[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="pageAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetApexPageAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates which Visualforce pages that users assigned to this permission set can execute. Available in API version 23.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetApexPageAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recordTypeVisibilities" minOccurs="0" maxOccurs="unbounded" type="PermissionSetRecordTypeVisibility">
      <xsd:annotation>
       <xsd:documentation>Indicates which record types are visible to users assigned to this permission set. Available in API version 29.0 and later. This field is never retrieved or deployed for inactive record types.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetRecordTypeVisibility[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ServicePresenceStatusAccesses" minOccurs="0" maxOccurs="unbounded" type="PermissionSetServicePresenceStatusAccess">
      <xsd:annotation>
       <xsd:documentation>Indicates which Service presence statuses that the user assigned to this profile can execute. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetServicePresenceStatusAccess[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="tabSettings" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Indicates the tab visibility settings for this permission set. Available in API version 26.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetTabVisibility[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userLicense" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Deprecated. The user license for the permission set. A user license determines the baseline of features that the user can access. Every user must have exactly one user license. Available up to API version 37.0. In API version 38.0 and later, use license.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userPermissions" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Specifies an app or system permission (such as “API Enabled”) and whether it&apos;s enabled for this permission set. In API version 28.0 and earlier, this field retrieves all user permissions, enabled or disabled. In API version 29.0 and later, this field retrieves only enabled user permissions. In API Version 40.0 and later, if a permission isn’t specified for a deployment, it’s disabled.</xsd:documentation>
       <xsd:appinfo>Type: PermissionSetUserPermissions[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SharingBaseRule">
  <xsd:annotation>
   <xsd:documentation>Represents sharing rule settings such as access level and to whom access is granted. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingbaserule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The access level that the sharing rule grants.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="accountSettings" minOccurs="0" maxOccurs="unbounded" type="AccountSharingRuleSettings">
      <xsd:annotation>
       <xsd:documentation>The access level for the account’s children (case, contact, and opportunity).</xsd:documentation>
       <xsd:appinfo>Type: AccountSharingRuleSettings[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Describes the sharing rule. Maximum of 1000 characters.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label for the sharing rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sharedTo" minOccurs="0" maxOccurs="unbounded" type="SharedTo">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies who the record is shared with.</xsd:documentation>
       <xsd:appinfo>Type: SharedTo</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SharingOwnerRule">
  <xsd:annotation>
   <xsd:documentation>Defines an ownership-based sharing rule. It extends SharingBaseRule and inherits all its fields. Available in API version 33.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="SharingBaseRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="sharedFrom" minOccurs="0" maxOccurs="unbounded" type="SharedTo">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the record owners. If you’re using Sales Territories, use modelName.territoryName for the shared-to and shared-from territory and territoryAndSubordinates values on the SharedTo type, where: modelName equals the name of the active territory model in the API. territoryName equals the territory’s name in the API.</xsd:documentation>
       <xsd:appinfo>Type: SharedTo</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SharingRules">
  <xsd:annotation>
   <xsd:documentation>Represents the base container for sharing rules, which can be criteria-based, ownership-based, territory-based, or for guest user access. SharingRules enables you to share records with a set of users, using rules that specify the access level for the target user group. This type extends the Metadata metadata type and inherits its fullName field. For more information, see “Sharing Rules” in Salesforce Help.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="sharingCriteriaRules" minOccurs="0" maxOccurs="unbounded" type="SharingCriteriaRule">
      <xsd:annotation>
       <xsd:documentation>An array of criteria-based sharing rules. Available in API version 33.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SharingCriteriaRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sharingGuestRules" minOccurs="0" maxOccurs="unbounded" type="SharingGuestRule">
      <xsd:annotation>
       <xsd:documentation>An array of guest user sharing rules. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SharingGuestRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sharingOwnerRules" minOccurs="0" maxOccurs="unbounded" type="SharingOwnerRule">
      <xsd:annotation>
       <xsd:documentation>An array of ownership-based sharing rules. Available in API version 33.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SharingOwnerRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sharingTerritoryRules" minOccurs="0" maxOccurs="unbounded" type="SharingTerritoryRule">
      <xsd:annotation>
       <xsd:documentation>An array of territory-based sharing rules. Available in API version 33.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SharingTerritoryRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="StrategyNodeBase">
  <xsd:annotation>
   <xsd:documentation>Base class for all strategy nodes. This is an abstract class.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_recommendationstrategy.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="childNode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Array of child node names, in order of execution.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Description of the node.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Label of the node.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Unique name of the node.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="StrategyNodeUnionBase">
  <xsd:annotation>
   <xsd:documentation>Base class for nodes that perform a union of their children. Union nodes combine the outputs of their children to form the input to themselves. StrategyNodeUnionBase extends StrategyNodeBase and inherits all of its fields. This is an abstract class.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_recommendationstrategy.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="StrategyNodeBase">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="limit" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Maximum number of results to output.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIApplication">
  <xsd:annotation>
   <xsd:documentation>Represents an instance of an AI application. For example, Einstein Prediction Builder. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiapplication.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the name of the application. Can contain only underscores and alphanumeric characters and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores.Only users with View DeveloperName OR View Setup and Configuration permission can view, group, sort, and filter this field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Label that identifies the AI application throughout the Salesforce user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The status of the application. Valid values are: Disabled Draft Enabled Migrated</xsd:documentation>
       <xsd:appinfo>Type: AIApplicationStatus (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The type of AI application. Valid values are: PredictionBuilder</xsd:documentation>
       <xsd:appinfo>Type: AIApplicationType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIApplicationConfig">
  <xsd:annotation>
   <xsd:documentation>Additional prediction information related to an AI application. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiapplicationconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiApplicationDeveloperName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the AIApplication to which AIApplicationConfig belongs. Can contain only underscores and alphanumeric characters and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. Available in API version 51.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="applicationId" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The ID of the parent AI application.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the name of the application config. Can contain only underscores and alphanumeric characters and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="insightReasonEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. When true, generates the predictors, or field values, that were used to generate the prediction value.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label that identifies the AI application configuration throughout the Salesforce user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rank" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Reserved for future use.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="scoringMode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Frequency with which the prediction scores are written back. Valid values are: Batch OnDemand Streaming</xsd:documentation>
       <xsd:appinfo>Type: AIScoringMode (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIFeatureExtractor">
  <xsd:annotation>
   <xsd:documentation>Represents information about the feature extractor that’s used to retrieve the input data for the use case model that’s used to generate predictions.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiusecasedefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="batchInputSourceIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The identifier of the input source of the features computed by batch jobs, which can be used by a model for generating predictions. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="batchInputSourceInformation" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The information about the batch input source, including query parameters, objects, field mappings, and filter criteria. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="batchInputSourceType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The input source of the features computed in batch jobs. Possible values are: CRMA Data Cloud The default value is CRMA.</xsd:documentation>
       <xsd:appinfo>Type: BatchInputSourceType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="className" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The ID of the Apex class created for the feature extractor.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The unique name for the feature extractor. Required. The unique name of the object in the API. This name can contain only underscores and alphanumeric characters, and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. In managed packages, this field prevents naming conflicts on package installations. With this field, a developer can change the object’s name in a managed package and the changes are reflected in a subscriber’s organization. Label is Record Type Name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="extractorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of the feature extractor. Valid values are: APEX JAVA HYBRID The default value is APEX.</xsd:documentation>
       <xsd:appinfo>Type: ExtractorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="featureInputType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of feature input that’s used in generating predictions. Valid values are: Realtime_Input Sample_Input Batch_Input Batch_And_Realtime_Input Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="inputContext" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The JSON file with features that act as context for the feature extractor. This data can also include the data in the uploaded CSV file. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the feature extractor, which is defined when the feature extractor is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIReplyRecommendationsSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata used to manage settings for Einstein Reply Recommendations. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aireplyrecommendationssettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableAIReplyRecommendations" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true (default), Einstein Reply Recommendations is enabled. If false, it is disabled.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableGenReplyRecommendations" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true (default), Einstein Service Replies is enabled. If false, it is disabled. Available in API version 58.0 or later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableServiceEinsteinGPTGrounding" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true (default), Service AI Grounding is enabled. If false, it is disabled. Available in API version 58.0 or later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIScoringModelDefVersion">
  <xsd:annotation>
   <xsd:documentation>Represents information about a version of an AI scoring model.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiscoringmodeldefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiScoringModelDefinition" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Parent AIScoringModelDefinition record that’s related to an AIScoringModelDefVersion record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="aiScoringSteps" minOccurs="0" maxOccurs="unbounded" type="AIScoringStep">
      <xsd:annotation>
       <xsd:documentation>Represents information about a step associated with an AI scoring model version.</xsd:documentation>
       <xsd:appinfo>Type: AIScoringStep[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique name of the object in the API. This name can contain only underscores and alphanumeric characters, and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. In managed packages, this field prevents naming conflicts on package installations. With this field, a developer can change the object’s name in a managed package and the changes are reflected in a subscriber’s organization. Label is Record Type Name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the AIScoringModelDefVersion component name, which is defined when the AIScoringModelDefVersion component name is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="modelMode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Mode of an AI scoring model.Values are: DEPLOY TRAIN TRAIN_AND_DEPLOY</xsd:documentation>
       <xsd:appinfo>Type: AIScoringModelDefVersionMode (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIScoringModelDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents information about a machine learning model that’s used by the Scoring Framework for Industries Cloud Einstein. The machine learning model is used for scoring, including its configuration.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiscoringmodeldefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiModelConfig" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. ID of an AI model configuration related to the AI scoring model record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="aiScoringModelDefVersions" minOccurs="0" maxOccurs="unbounded" type="AIScoringModelDefVersion">
      <xsd:annotation>
       <xsd:documentation>Represents information of various versions of a model.</xsd:documentation>
       <xsd:appinfo>Type: AIScoringModelDefVersion[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Description for an AIScoringModelDefinition record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the AIScoringModelDefinition metadata component, which is defined when the AIScoringModelDefinition metadata component is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIScoringStep">
  <xsd:annotation>
   <xsd:documentation>Represents information about a step associated with an AI scoring model version. For example, an AI scoring step can include steps, such as propensity to purchase products or prediction scores for accounts.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiscoringmodeldefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiModelConfigStep" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. ID of the AI model config step that’s related to the AIScoringStep record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="stepDetail" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Scoring step details in JSON format.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIUsecaseDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents a collection of fields in your Salesforce org used to define a machine learning use case and get real-time predictions.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiusecasedefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiUsecaseFieldMappings" minOccurs="0" maxOccurs="unbounded" type="AIUsecaseFieldMapping">
      <xsd:annotation>
       <xsd:documentation>The field mappings for the use case definition. Each use case definition can have multiple field mappings.</xsd:documentation>
       <xsd:appinfo>Type: AIUsecaseFieldMapping[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="aiUsecaseModels" minOccurs="0" maxOccurs="unbounded" type="AIUsecaseModel">
      <xsd:annotation>
       <xsd:documentation>The models for the use case definition. Each use case definition can have multiple use case models.</xsd:documentation>
       <xsd:appinfo>Type: AIUsecaseModel[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="creatorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of user who created the use case definition that&apos;s used by AI Accelerator. Valid values are: INTERNAL_USER SALESFORCE_ADMIN Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: CreatorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the use case definition, which is defined when the use case definition is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="maximumInsightCount" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The maximum number of insights returned by the scoring response.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="maximumRecommendationCount" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The maximum number of recommendations returned by the Next Best Action Strategy.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="maximumSuggestionCount" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The maximum number of suggestions returned by the scoring response.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="primaryResponseObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The primary object in which the scoring response is stored based on the specified field mapping.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recommendationResponseObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The recommendation response object associated with the use case definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recommendationSource" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The tool or platform that generates recommendations. Valid values are: Next_Best_Action_Flow None Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: RcmdSourceType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="secondaryResponseObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The object in which the scoring response is stored based on the specified field mapping.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="shouldSaveFeatures" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to save the features extracted for the scoring request (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="shouldSaveInsights" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to save the prediction insights that are used to generate the score (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="shouldSaveRecommendation" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to save the recommendation (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="shouldSaveRequestResponse" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to save the request response (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="shouldSaveScore" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to save the prediction score (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="shouldSaveSuggestions" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to save the suggestions for improving the prediction score (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="suggestionImpactMinimumPct" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The minimum eligible percentage for improving the existing prediction score based on the suggestions. Suggestions with an impact greater than the specified percentage on the score are displayed on the prediction scorecard.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="usecaseName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the use case definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIUsecaseFieldMapping">
  <xsd:annotation>
   <xsd:documentation>Represents information about the field mapping to store extracted features, prediction scores, prediction insights, and use case suggestions in the response object.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiusecasedefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The unique name for the field mapping in the use case definition. Required. The unique name of the object in the API. This name can contain only underscores and alphanumeric characters, and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. In managed packages, this field prevents naming conflicts on package installations. With this field, a developer can change the object’s name in a managed package and the changes are reflected in a subscriber’s organization. Label is Record Type Name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="mappedFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the field where the scoring response is stored.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="mappedFieldType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of the mapped field. Valid values are: FEATURE PREDICTION_SCORE INSIGHT SUGGESTION SECONDARY_RESPONSE_RECORD_ID RECOMMENDATION_RESPONSE_RECORD_ID RECOMMENDATION The default value is FEATURE.</xsd:documentation>
       <xsd:appinfo>Type: MappedFieldType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the use case field mapping, which is defined when the field mapping is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="responseFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the response object’s field that’s mapped to the field storing the score.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="responseObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object whose field is mapped to the field storing the score. It’s either the PrimaryResponseObject or the SecondaryResponseObject specified in the AIUsecaseDefinition object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sequenceNumber" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The sequence number for the information stored in the field mapping.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AIUsecaseModel">
  <xsd:annotation>
   <xsd:documentation>Represents information about the machine learning models that generate predictions for your use case.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_aiusecasedefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiFeatureExtractors" minOccurs="0" maxOccurs="unbounded" type="AIFeatureExtractor">
      <xsd:annotation>
       <xsd:documentation>The AI feature extractors to retrieve the input data.</xsd:documentation>
       <xsd:appinfo>Type: AIFeatureExtractor[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultFeatureExtractor" minOccurs="0" maxOccurs="unbounded" type="AIFeatureExtractor">
      <xsd:annotation>
       <xsd:documentation>The default AI feature extractor to retrieve the input data.</xsd:documentation>
       <xsd:appinfo>Type: AIFeatureExtractor</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The unique name for the use case model. Required. The unique name of the object in the API. This name can contain only underscores and alphanumeric characters, and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. In managed packages, this field prevents naming conflicts on package installations. With this field, a developer can change the object’s name in a managed package and the changes are reflected in a subscriber’s organization. Label is Record Type Name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the use case model, which is defined when the use case model is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="predictionDefinition" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique identifier of the prediction definition that’s related to the use case model. This identifier can be an external ID. If you use Einstein Discovery to create models, the predictionDefinition field stores the developer name of the record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="predictionPlatform" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The platform on which the machine learning model is created and deployed. Valid values are: Data_Cloud Default—For internal use only. Einstein_Discovery Einstein_on_Data_Cloud—Available in API version 63.0 and later. The default value is Einstein_Discovery. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PredictionPlatform (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccessMapping">
  <xsd:annotation>
   <xsd:documentation>AccessMapping</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The target object access level granted to the portal user. Valid values are: Read Edit</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A lookup to the target object, which supports standard or custom fields, or an ID. For accounts or cases associated with entitlements, use Entitlement.Account or Entitlement.Case.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="object" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The target object to which the portal user is gaining access, and refers to one of the following: Account Campaign Contact Case Custom Objects (for example, ObjA__c) Opportunity Order ServiceContract User WorkOrder Portal users gain access to all order entitlements and order items under an account to which they have access.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The user’s lookup to an account, contact, or a standard or custom field derived from an account or contact. Either the user or the user’s manager can be used in the lookup. Valid values are: Account Account.Field Contact Contact.Field Contact.RelatedAccount Manager.Account Manager.Contact Field refers to a standard or custom field based on an account or contact.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountCriteriaBasedSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a criteria-based sharing rule for accounts. It extends the CriteriaBasedSharingRule metadata type and inherits its criteriaItems field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cbsrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="CriteriaBasedSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that the user or group has to the account. The possible values are: Read Edit All</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoNone (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the filter logic of the sharing rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that the user or group has to cases associated with the account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contactAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that the user or group has to contacts associated with the account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters. This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="opportunityAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a target group is granted for any associated opportunity. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountInsightsSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s Einstein Account Insights settings. This setting controls features that help your reps maintain their relationships with their customers. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountinsightssettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableAccountInsights" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Einstein Account Insights is enabled (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountIntelligenceSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s Account Intelligence settings. These settings control features that make it easy for sales reps to create accounts, see relevant news articles, and add logos to account records. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountintelligencesettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableAccountLogos" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether your sales reps can see available company logos (true) or not (false). The logos are for US-based companies only. The default value is false.enableAutomatedAccountFields must be true to use this setting.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAutomatedAccountFields" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Automated Account Fields is enabled (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableNewsStories" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether News is enabled (true) or not (false). The default value is false. enableAutomatedAccountFields must be true to use this setting.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountOwnerSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a sharing rule for an account with users other than the owner. It extends the OwnerSharingRule metadata type and inherits its fullName, sharedFrom, and sharedTo fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_ownersharingrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="OwnerSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a group or role has to the account. The possible values are: Read Edit All</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoNone (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a group or role has to cases associated with the account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contactAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a group or role has to contacts associated with the account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters.This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="opportunityAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a group or role is granted for any associated opportunity. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountPlanObjMeasCalcCond">
  <xsd:annotation>
   <xsd:documentation>Represents a field and value combination for filtering records to include in the calculation of a sales account plan objective measure’s current value.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountplanobjmeascalcdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="fieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A field on the calculation definition’s TargetObject that you want to filter by. Fields on the Campaign, Case, Contact, or Opportunity objects are supported.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="operation" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The logical operator for matching records with the specified field value. Possible values are: Contains Equals GreaterOrEqual GreaterThan LessOrEqual LessThan NotContain NotEqual StartsWith</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The value to match for the specified field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountPlanObjMeasCalcDef">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with an account plan objective measure calculation definition. An account plan objective measure calculation definition contains a target object, rollup field, and logic for calculating the current value of a sales account plan objective measure.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountplanobjmeascalcdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="conditions" minOccurs="0" maxOccurs="unbounded" type="AccountPlanObjMeasCalcCond">
      <xsd:annotation>
       <xsd:documentation>The field and value combinations for filtering records to include in the calculation definition.</xsd:documentation>
       <xsd:appinfo>Type: AccountPlanObjMeasCalcCond</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A summary of the calculation definition that’s visible to users when they select the definition for an account plan objective measure.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique name of the object in the API. The name: must be 40 characters or fewer must begin with a letter can contain only underscores and alphanumeric characters can’t include spaces can’t end with an underscore can’t contain 2 consecutive underscores</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label for this calculation definition. This display value is the internal label that doesn&apos;t get translated.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rollupType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The method for calculating the account plan objective measure’s current value from records that match the calculation definition and any optional conditions. Possible values are: Count Max Min Sum In Setup, this field’s label is Calculation Type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the status of the calculation definition. Possible values are: Active Draft Inactive Only active calculation definitions are available for users to select when they specify an account plan objective measure.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field on TargetObject to use for calculating the account plan objective measure’s current value. Rollup fields on the Campaign, Case, Contact, or Opportunity object are supported. In Setup, this field’s label is Rollup Field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object to use for calculating the account plan objective measure’s current value. Possible values are: Campaign Case Contact Opportunity</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountPlanSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s account plan settings. These settings control features that make it easy for sales reps to set objectives with actionable metrics and to store account research and analysis.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountplansettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableAccountPlan" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Account Plans is enabled (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountRelationshipShareRule">
  <xsd:annotation>
   <xsd:documentation>The rule that determines which object records are shared, how they’re shared, the account relationship type that shares the records, and the level of access granted to the records.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountrelationshipsharerule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Type of access granted by the share rule. Valid values are: Read Edit</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="accountToCriteriaField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Criteria that must be met for the data to be shared. Valid values include any custom or standard lookup to Account or User on top-level objects. To get the full list for your org, do a Describe on the ARSR entity.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A meaningful explanation of the sharing rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="entityType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The type of data shared by this share rule. Valid values are: Account Campaign Case Contact Custom Object Lead Opportunity Order Quote API names of top-level custom objects in the org can also be used, for example, CustomObject__c.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The label assigned to the sharing rule to identify it.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="staticFormulaCriteria" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A way to further filter what data gets shared. This string must be a deterministic formula, and spanning isn’t allowed.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Match the type of an account relationship for data to be shared according to the accountToCriteriaField and the staticFormulaCriteria fields.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s account settings for account teams, account owner report, and the View Hierarchy link. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableAccountDiscovery" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>When true, sets up Einstein Account Management dashboards and installs the related CRM Analytics and Customer Insights apps. The dashboards give users access to account health analytics including metrics on open pipeline, risk, and engagement scores. Einstein Account Management is part of Revenue Intelligence, which is available for an additional cost. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAccountHistoryTracking" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether history tracking is enabled for accounts (true) or not (false). The default value is false. If history tracking is disabled, the History related list is removed from account page layouts. However, history data is still available for reporting up to the date and time when tracking was disabled. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAccountInsightsInMobile" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Deprecated in API version 59.0 and later because the feature is no longer available. Indicates whether users can see Einstein Account Insights on their mobile device (true) or not (false). Insights appear in the Einstein Insights component, which is on account records and the Home page.To use this feature, users must have the Einstein Account Insights permission. Available in API version 47.0 to 58.0.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAccountOwnerReport" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Account Owner Report can (true) or can’t (false) be run by all users.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAccountTeams" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether account teams are enabled (true) or not (false).The Metadata API can’t be used to disable account teams.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableContactHistoryTracking" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether history tracking is enabled for contacts (true) or not (false). Available in API version 46.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRelateContactToMultipleAccounts" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can relate a contact to multiple accounts (true) or only one account (false). The default value is false. If this feature (Contacts to Multiple Accounts) is disabled, secondary contact–account relationships created while the feature was enabled are deleted. Available in API version 47.0 and later.Avoid using the Metadata API to enable this feature. Use the Account Settings page in Setup to enable Contacts to Multiple Accounts.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableReportsToOnPersonAccount" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Reports To field on Person Account, which corresponds to the PersonReportsToId field on the Account object, is enabled. The field allows users to associate person accounts and contacts with other person accounts or contacts that they report to.Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showViewHierarchyLink" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the default View Hierarchy link on all business account detail pages is visible (true) or hidden (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountSharingRuleSettings">
  <xsd:annotation>
   <xsd:documentation>Defines the access level for the case, contact, and opportunity associated with the account.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingbaserule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The access level that the user or group has to cases associated with the account. Possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contactAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The access level that the user or group has to contacts associated with the account. Possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="opportunityAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The access level that the user or group has to opportunities associated with the account. Possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountSharingRules">
  <xsd:annotation>
   <xsd:documentation>Represents the sharing rules for accounts. It extends the SharingRules metadata type and inherits its fullName field. Only available in API version 32.0 and earlier.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="SharingRules">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="criteriaBasedRules" minOccurs="0" maxOccurs="unbounded" type="AccountCriteriaBasedSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user criteria-based rules.</xsd:documentation>
       <xsd:appinfo>Type: AccountCriteriaBasedSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ownerRules" minOccurs="0" maxOccurs="unbounded" type="AccountOwnerSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user membership-based rules.</xsd:documentation>
       <xsd:appinfo>Type: AccountOwnerSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountTerritorySharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a rule for sharing an account within a territory. It extends the OwnerSharingRule metadata type and inherits its fullName, sharedFrom, and sharedTo fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_ownersharingrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="OwnerSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a Territory or TerritoryAndSubordinates group is granted for an account territory. The possible values are: Read Edit All</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoNone (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a Territory or TerritoryAndSubordinates group is granted for all child cases to an account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contactAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a Territory or TerritoryAndSubordinates group is granted for all related contacts on an account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters.This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="opportunityAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a Territory or TerritoryAndSubordinates group is granted for all opportunities associated with an account. The possible values are: None Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoAll (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountTerritorySharingRules">
  <xsd:annotation>
   <xsd:documentation>Represents the sharing rules for account territories in the original territory management feature. It extends the SharingRules metadata type and inherits its fullName field. Only available in API version 32.0 and earlier.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="SharingRules">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="rules" minOccurs="0" maxOccurs="unbounded" type="AccountTerritorySharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user membership-based rules. The list of acceptable values for the sharedFrom fields are: territory territoryAndSubordinates</xsd:documentation>
       <xsd:appinfo>Type: AccountTerritorySharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountingFieldMapping">
  <xsd:annotation>
   <xsd:documentation>Represents the accounting field mappings to organize your data and bring it to ledger entry records.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountingfieldmapping.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountingModelConfig" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Record ID of the AccountingModelConfig record that the Field Mapping is associated with.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isForAllocationType" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isForPaymentType" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isForTransactionType" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this component is protected (true) or not protected (false).Default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="mappingBehavior" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies how the target’s field data is mapped from the source field only when the journal entry is created. When set to CurrentValue, Subledger reverses and replaces journal entries whose value differs from the value in sourceField.Valid values are: CurrentValue PointInTime</xsd:documentation>
       <xsd:appinfo>Type: MappingBehaviorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for AccountingFieldMapping, which is defined when the AccountingFieldMapping is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The API name of the field on the source object that is mapped to the target field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API name of the field on the Transaction Journal record for this mapping.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountingModelConfig">
  <xsd:annotation>
   <xsd:documentation>Represents the mapping of the financial data model to a logical data model and configuration for the generation of Transaction Journal records.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountingmodelconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountingType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Determines whether the accounting set generates revenue or expense type transaction journal records.Valid values are: Expense Revenue</xsd:documentation>
       <xsd:appinfo>Type: AccountingType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultAccrualAccountCode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The code for your accounting system&apos;s default accrual account.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultWriteOffAccountCode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the name of your account for written off payments.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="earliestCreatedDate" minOccurs="0" maxOccurs="unbounded" type="xsd:dateTime">
      <xsd:annotation>
       <xsd:documentation>Required. The date used to filter source records for processing. The Accounting Subledger only considers records created on or after this date.</xsd:documentation>
       <xsd:appinfo>Type: dateTime</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="expectedCashFlowGrouping" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Determines whether Accounting Subledger groups transaction journal records by fund account or by a combination of fund account and due date. Changing this setting doesn&apos;t impact existing records; it only affects records created or reversed afterward. Valid values are: GroupByFundAccount GroupByFundAndDueDate</xsd:documentation>
       <xsd:appinfo>Type: ExpectedCashFlowGrouping (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="financeBook" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="internalMappingDetails" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the structure of your financial data in JSON format.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether only records that are true are processed when the Subledger Job runs.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isGroupedByFundAccount" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isUsed" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the Accounting Model has been used or activated at least once (true) or not (false). If the value is set to true, you can’t select another object for the object model or change the number of objects associated with that Accounting Model.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="jobFilterCriteria" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for AccountingModelConfig, which is defined when the AccountingModelConfig is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="paidCashFlowGrouping" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Determines the level of detail for generated transaction journal records.Valid values are: GroupByFundAccount—Accounting Subledger splits all transaction journal records into fund accounts. Secondary records are created for payment type records but not for transaction type records. GroupBySummary—Accounting Subledger only splits credits for revenue and debits for expenses by fund accounts.</xsd:documentation>
       <xsd:appinfo>Type: PaidCashFlowGrouping (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recordTypeFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specify the record type IDs from the primary object to be processed. This field is case-sensitive.If no record type is specified in the filter, all records are processed.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="runOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Determines the load order sequence of the multiple Accounting Model. The lower number runs first. For example, load order 1 runs before load order 2.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AccountingSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the settings for the Accounting Subledger feature.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_accountingsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableAccountingSubledger" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Transaction Journal creation is enabled for the organization (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAslDataCloud" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Requires Data Cloud and Accounting Subledger access. Indicates whether Data Cloud Runtime for Accounting Subledger feature is enabled for the organization (true) or not (false). This field is available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFinancePeriod" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enablePaymentMethodAdjust" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether changes to the Payment Method generate adjustments on Transaction Journal records (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableScheduledJob" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSkipReversalLogicEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Skip Reversal Logic is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionLinkGroupTemplate">
  <xsd:annotation>
   <xsd:documentation>Represents the action link group template. Action link templates let you reuse action link definitions and package and distribute action links. An action link is a button on a feed element. Clicking on an action link can take a user to another Web page, initiate a file download, or invoke an API call to an external server or Salesforce. Use action links to integrate Salesforce and third-party services into the feed. Every action link belongs to an action link group and action links within the group are mutually exclusive. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionlinkgrouptemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionLinkTemplates" minOccurs="0" maxOccurs="unbounded" type="ActionLinkTemplate">
      <xsd:annotation>
       <xsd:documentation>Action link templates that are associated with the action link group template.</xsd:documentation>
       <xsd:appinfo>Type: ActionLinkTemplate[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="category" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The location of the action link group within the feed element. Values are: Primary—The action link group is displayed in the body of the feed element. Overflow—The action link group is displayed in the overflow menu of the feed element.</xsd:documentation>
       <xsd:appinfo>Type: PlatformActionGroupCategory (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="executionsAllowed" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The number of times an action link can be executed. Values are: Once—An action link can be executed only once across all users. OncePerUser—An action link can be executed only once for each user. Unlimited—An action link can be executed an unlimited number of times by each user. If the action link’s actionType is Api or ApiAsync, you can’t use this value.</xsd:documentation>
       <xsd:appinfo>Type: ActionLinkExecutionsAllowed (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="hoursUntilExpiration" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The number of hours from when the action link group is created until it&apos;s removed from associated feed elements and can no longer be executed. The maximum value is 8,760.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isPublished" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. If true, the action link group template is published. Action link group templates shouldn’t be published until at least one action link template is associated with it.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the action link group template to use in code.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionLinkTemplate">
  <xsd:annotation>
   <xsd:documentation>ActionLinkTemplate components are used to create multiple action links that share properties.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionlinkgrouptemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionUrl" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The action link URL. For example, a Ui action link URL is a Web page. A Download action link URL is a link to the file to download. Ui and Download action link URLs are provided to clients. An Api or ApiAsync action link URL is a REST resource. Api and ApiAsync action link URLs aren’t provided to clients. Links to Salesforce can be relative. All other links must be absolute and start with https://.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="headers" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Template for the HTTP headers sent when corresponding action links are invoked. This field can be used only for Api and ApiAsync action links. This field can contain context variables and binding variables in the form {!Bindings.key}.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isConfirmationRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. If true, a confirmation dialog appears before the action is executed.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isGroupDefault" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. If true, action links derived from this template are the default or primary action in their action groups. There can be only one default action per action group.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A custom label to display on the action link button. If none of the LabelKey values make sense for an action link, use a custom label. Set the LabelKey field to None and enter a label name in the Label field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="labelKey" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Key for the set of labels to display for these action link states: new, pending, success, failed. For example, the Approve set contains these labels: Approve, Pending, Approved, Failed. For a complete list of keys and labels, see Action Link Labels in the Connect REST API Developer Guide.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="linkType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of action link. One of these values: Api—The action link calls a synchronous API at the action URL. Salesforce sets the status to SuccessfulStatus or FailedStatus based on the HTTP status code returned by your server. ApiAsync—The action link calls an asynchronous API at the action URL. The action remains in a PendingStatus state until a third party makes a request to /connect/action-links/actionLinkId to set the status to SuccessfulStatus or FailedStatus when the asynchronous operation is complete. Download—The action link downloads a file from the action URL. Ui—The action link takes the user to a web page at the action URL.</xsd:documentation>
       <xsd:appinfo>Type: ActionLinkType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="method" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. HTTP method for the action URL. One of these values: HttpDelete—Returns HTTP 204 on success. Response body or output class is empty. HttpGet—Returns HTTP 200 on success. HttpHead—Returns HTTP 200 on success. Response body or output class is empty. HttpPatch—Returns HTTP 200 on success or HTTP 204 if the response body or output class is empty. HttpPost—Returns HTTP 201 on success or HTTP 204 if the response body or output class is empty. Exceptions are the batch posting resources and methods, which return HTTP 200 on success. HttpPut—Return HTTP 200 on success or HTTP 204 if the response body or output class is empty. Ui and Download action links must use HttpGet.</xsd:documentation>
       <xsd:appinfo>Type: ActionLinkHttpMethod (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="position" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. An integer specifying the position of the action link template relative to other action links in the group. 0 is the first position.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="requestBody" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Template for the HTTP request body sent when corresponding action links are invoked. This field can be used only for Api and ApiAsync action links. This field can contain context variables and binding variables in the form {!Bindings.key}.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAlias" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If you selected CustomUser or CustomExcludedUser for UserVisibility, this field is the alias for the custom user. Use the alias in a template binding to specify the custom user when an action link group is created using the template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userVisibility" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Who can see the action link. This value is set per action link, not per action link group. Values are: Creator—Only the creator of the action link can see the action link. Everyone—Everyone can see the action link. EveryoneButCreator—Everyone but the creator of the action link can see the action link. Manager—Only the manager of the creator of the action link can see the action link. CustomUser—Only the custom user can see the action link. CustomExcludedUser—Everyone but the custom user can see the action link.</xsd:documentation>
       <xsd:appinfo>Type: ActionLinkUserVisibility (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionOverride">
  <xsd:annotation>
   <xsd:documentation>Represents an action override on a standard or custom object. Use it to create, update, edit, or delete action overrides. You can access ActionOverride only by accessing its encompassing CustomObject.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/actionoverride.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The possible values are the same as the actions you can override: accept clone delete edit list new tab view</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="comment" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Any comments you want associated with the override.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="content" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Set this field if type is set to flexipage, lightningcomponent, scontrol, or visualforce. It refers to the name of the Lightning page, Lightning component, s-control, or Visualforce page to use as the override. To reference installed components, use this format: Component_namespace__Component_name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="formFactor" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The size of the page being overridden.If the type field is set to flexipage, set this field to Large to override the View action with a Lightning page in Lightning Experience. The Large value represents the Lightning Experience desktop environment and is valid only for the flexipage and lightningcomponent types. The Small value represents the Salesforce mobile app on a phone or tablet. The Medium value is reserved for future use. The null value (which is the same as specifying no value) represents Salesforce Classic. This field is available in API version 37.0 and later and is part of the feature for creating and editing record pages in Lightning Experience. Lightning component overrides return different FormFactor values depending on the API version used. In API version 41.0 and earlier, Lightning component overrides return only the null value (no value), representing the Salesforce Classic environment. In API version 42.0, if you specify different Lightning component overrides for Lightning Experience and mobile, one component is selected randomly for both overrides and its FormFactor value is returned. If there’s a conflict between Lightning components, and a Visualforce page override is also specified for Salesforce Classic, the Visualforce page takes precedence. In API version 43.0 and later, a Lightning component override for Lightning Experience returns the Large value and a Lightning component override for mobile returns the Small value, as expected.</xsd:documentation>
       <xsd:appinfo>Type: FormFactor (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="skipRecordTypeSelect" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Set this field to true if you prefer that any new records created by this action override aren’t forwarded to the record type selection page. This field is only valid if the actionName is a “create” type (like new), and type is set to visualforce. This field is available in API version 21.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the type of action override. Valid values are described in ActionOverrideType.</xsd:documentation>
       <xsd:appinfo>Type: ActionOverrideType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionOverrideType">
  <xsd:annotation>
   <xsd:documentation>ActionOverrideType is an enumeration of type string that defines which kind of action override to use. The valid values are:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/actionoverride.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionPlanTemplate">
  <xsd:annotation>
   <xsd:documentation>Represents the instance of an action plan template.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionplantemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionPlanTemplateItem" minOccurs="0" maxOccurs="unbounded" type="ActionPlanTemplateItem">
      <xsd:annotation>
       <xsd:documentation>The instance of an item on an action plan template version.</xsd:documentation>
       <xsd:appinfo>Type: ActionPlanTemplateItem</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="actionPlanTemplateItemDependencies" minOccurs="0" maxOccurs="unbounded" type="ActionPlanTemplateItemDependency">
      <xsd:annotation>
       <xsd:documentation>Defines the dependencies between action plan template items. Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ActionPlanTemplateItemDependency[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="actionPlanType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Type of the action plan template. Valid values are: Industries Retail ITSM—Available in API version 65.0 and later. PrvdEngmtCompliance KAM Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ActionPlanTemplateType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="category" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Category for this action plan template. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The description of the action plan template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="estimatedCompletionDays" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Estimated number of days required to complete the action plan. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fileBasedTemplatePath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>File path for a file-based action plan template. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isAdHocItemCreationEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether ad hoc item creation is enabled for this action plan template (true) or not (false). Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the action plan template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ParentTemplateId" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the parent Action Plan Template record. This field is a relationship field to the ParentTemplate and refers to ActionPlanTemplate. Available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: reference</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Source type of the action plan template. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Status of the action plan template. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="subcategory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Subcategory for this action plan template. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetEntityType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The parent object this action plan template relates to. Supported parent objects are Account, BusinessMilestone, Campaign, Case, Claim, Contact, Contract, InsurancePolicy, InsurancePolicyCoverage, Lead, Opportunity, PersonLifeEvent, and Visit and custom objects with activities enabled.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="uniqueName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique identifier for this action plan template record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionPlanTemplateItem">
  <xsd:annotation>
   <xsd:documentation>Represents the instance of an item on an action plan template version.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionplantemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionPlanTemplateItemValue" minOccurs="0" maxOccurs="unbounded" type="ActionPlanTemplateItemValue">
      <xsd:annotation>
       <xsd:documentation>The value associated with the action plan template item.</xsd:documentation>
       <xsd:appinfo>Type: ActionPlanTemplateItemValue</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The order in which this item is displayed within the action plan template version.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the task created from this template item is required.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="itemEntityType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the field on the action plan template item that this value is for. Available in API version 48.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the action plan template item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="uniqueName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique identifier for this action plan template item record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionPlanTemplateItemDependency">
  <xsd:annotation>
   <xsd:documentation>Represents a dependency between action plan template items, defining the sequential relationship and creation timing of items. Available in API version 59.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionplantemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="creationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Defines how the dependent item is created in the action plan.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the dependency relationship.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="previousTemplateItem" minOccurs="0" maxOccurs="unbounded" type="ActionPlanTemplateItem">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the prerequisite template item that must be completed before the dependent item begins.</xsd:documentation>
       <xsd:appinfo>Type: ActionPlanTemplateItem</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="templateItem" minOccurs="0" maxOccurs="unbounded" type="ActionPlanTemplateItem">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the dependent template item that relies on the completion of the previous item.</xsd:documentation>
       <xsd:appinfo>Type: ActionPlanTemplateItem</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionPlanTemplateItemValue">
  <xsd:annotation>
   <xsd:documentation>Represents the value associated with an action plan template item.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionplantemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="itemEntityType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the field on the action plan template item that this value is for. Available in API version 48.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the action plan template item value.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueFormula" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The formula for this action plan template item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueLiteral" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The value for this action plan template item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionableListDatasetColumn">
  <xsd:annotation>
   <xsd:documentation>Represents the information about the columns in a dataset associated with an actionable list.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionablelistdefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="dataDomain" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The data domain that is mapped to the data type of the dataset column. Possible values are: Dates Dimensions Measures</xsd:documentation>
       <xsd:appinfo>Type: DatasetColumnDataType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The data type of the dataset column in the actionable list. Available in API version 58.0 and later. Possible values are: Boolean Currency Date DateTime Email Location Number Percent Phone Text Url</xsd:documentation>
       <xsd:appinfo>Type: DatatableDataType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The order in which the actionable list dataset columns are displayed. Available in API version 58.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDefault" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the dataset column is added to the actionable list by default (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isGroupedByListDefObj" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the dataset column is grouped by the object defined in the actionable list definition (true) or not (false). Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="IsTypeAheadSearchEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the type-ahead search for filters is enabled (true) or not (false). Available in API version 60.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the object that&apos;s associated with the dataset column. Possible values are: API version 60.0 and later: PersonLifeEventAPI version 60.0 and later with Insurance Managed Package: Claim InsurancePolicy Quote API version 59.0 and later with Health Cloud: CareFacilityBed CareRequest CareRequestItem CareServiceVisit CareServiceVisitPlan ClinicalServiceRequest API version 59.0 and later with Loyalty Cloud: LoyaltyProgramMember API version 59.0 and later: Case API version 58.0 and later with Automotive Cloud: Vehicle API version 58.0 and later: Asset Lead Opportunity API version 57.0 and later: Account Contact</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceColumnApiName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The API name of the column in the source dataset.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the field in the object for which the actionable list dataset is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionableListDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents the data source definition details associated with an actionable list.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionablelistdefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionableListDatasetColumns" minOccurs="0" maxOccurs="unbounded" type="ActionableListDatasetColumn">
      <xsd:annotation>
       <xsd:documentation>The object that stores columns in a dataset associated with an actionable list.</xsd:documentation>
       <xsd:appinfo>Type: ActionableListDatasetColumn[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="actionableListMemberStatuses" minOccurs="0" maxOccurs="unbounded" type="ActionableListMemberStatus">
      <xsd:annotation>
       <xsd:documentation>The object that stores the status and the corresponding status icon details of an individual actionable list member.</xsd:documentation>
       <xsd:appinfo>Type: ActionableListMemberStatus[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="batchCalcJobDefinition" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The batch calculation job definition that&apos;s associated with the creation of an actionable list. This field is a relationship field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="datasetName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the dataset that is associated with the actionable list.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="edgeMart" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The edgemart dataset that&apos;s associated with the actionable list. Available in API version 58.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the actionable list definition is active (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The master label of the actionable list definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object for which the actionable list is created.Possible values are organized by the API version in which they were introduced. Values are available in all versions after introduction unless noted otherwise. Possible values are: API version 60.0 and later: PersonLifeEventAPI version 60.0 and later with Insurance Managed Package: Claim InsurancePolicy Quote API version 59.0 and later with Health Cloud: CareFacilityBed CareRequest CareRequestItem CareServiceVisit CareServiceVisitPlan ClinicalServiceRequest API version 59.0 and later with Loyalty Cloud: LoyaltyProgramMember API version 59.0 and later: Case API version 58.0 and later with Automotive Cloud: Vehicle API version 58.0 and later: Asset Lead Opportunity API version 57.0 and later: Account Contact</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionableListMemberStatus">
  <xsd:annotation>
   <xsd:documentation>Represents the status and the corresponding status icon details of an individual actionable list member.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionablelistdefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="iconName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the icon that&apos;s mapped to the status.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The status of the actionable list member.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActionsSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s actions settings for default quick actions, multi-dimensional publisher, and third-party actions. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actionssettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableDefaultQuickActionsOn" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether default quick actions are created in the org (true, the default setting) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMdpEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether multi-dimensional publisher is enabled (true, the default setting) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableThirdPartyActions" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether third-party actions are displayed in the multi-dimensional publisher (true) or not (false, the default setting).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableOfflineWebLinks" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a button or link is available offline (true), or if it&apos;s only available online (false, the default setting).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActivationPlatform">
  <xsd:annotation>
   <xsd:documentation>Represents the ActivationPlatform configuration, such as platform name, delivery schedule, output format, and destination folder.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_activationplatform.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="activationPlatformConnectorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reserved for future use.</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformConnectorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="activationPlatformAdditionalMetadata" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Provides additional details about the activation platform, including subscriber override options, partner supported IDs, and file output properties such as maximum file size, compression settings, and the maximum number of records per file.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataConnector" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reference to the ActvPfrmDataConnectorS3 metadata type, which contains S3 bucket and export directory information into which Data 360 writes data.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The description for ActivationPlatform.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the ActivationPlatform is enabled (true) or not (false). The default is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="includeSegmentNames" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to include the segment name in metadata (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="logoUrl" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>URL of the logo for the activation channel destination.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name for the activation channel destination.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notes" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Notes for this ActivationPlartform.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="outputFormat" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The output format of the file.Valid values are: CSV JSON PARQUET</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformFileOutputFormat (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="outputGrouping" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The grouping of the output.Valid values are: PER_ACCOUNT PER_SEGMENT PER_USER</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformFileOutputGrouping (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="periodicRefreshFrequecy" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The frequency (in days) for periodic full refreshes when using incremental refresh mode.Valid values are: REFRESH_30 REFRESH_60</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformPeriodicFullRefresh (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="platformType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of the Activation Platform.Valid values are: Advertising Analytics Marketing Publishing Technology</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshFrequency" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates how often the activation platform accepts data delivery.Valid value is: TWENTY_FOUR</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformRefreshFrequency (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshMode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Defines how the refresh method handles refreshing files.Valid values are: FULL INCREMENTAL</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformRefreshMode (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActivationPlatformActvAttr">
  <xsd:annotation>
   <xsd:documentation>Represents the information about activation attributes. Reserved for future use.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_activationplatformactvattr.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActivationPlatformField">
  <xsd:annotation>
   <xsd:documentation>Represents the information about the fields used in ActivationPlatform.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_activationplatformfield.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="activationPlatform" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the ActivationPlatform metadata type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="helpText" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Information about ActivationPlatformField.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isHidden" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether ActivationPlatformField can be overridden by marketer (false) or not (true). The default is false. Field can’t be overridden by marketer when set to true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether this ActivationPlatformField is required (true) or not (false). The default is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the ActivationPlaformField.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the datatype of the field.Valid value is: Text</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformFieldDataType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActivitiesSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org&apos;s activity settings, and its user interface settings for the calendar. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_activitiessettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="allowUsersToRelateMultipleContactsToTasksAndEvents" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>This field indicates whether Shared Activities is enabled. When the value is true, allows users to relate multiple contacts to a task or event. Beginning with API v36.0, this field is read-only in all versions of the API. You can’t change the value of this field. Even though this field was updateable before Spring &apos;16, changing this field’s value wasn&apos;t supported and could have resulted in an incorrect integration. If you have code in older API versions that changes the value of this field, ensure that you update that code to prevent any errors.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="autoRelateEventAttendees" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>When users add attendees to events, events are automatically related to up to 50 contacts or one lead. An attendee is matched by their email address to a contact or lead. Admins control this field on the Activity Settings page. Available in API version 42.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableActivityReminders" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables popup activity reminders for an organization.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCalendarHomeLWC" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables Lightning Web Components for Calendar. Increases the default item limit in Calendar Home and applies styling enhancements to improve readability. Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableClickCreateEvents" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Lets users create events in day and weekly calendar views by double-clicking a specific time slot and entering the details of the event in an overlay. Hovering over an event displays an overlay where users can view the event details or delete the event without leaving the page. Admins use a mini page layout to configure the fields shown in the overlays. Doesn’t support recurring events or multi-person events.Admins control this field on the User Interface settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableDragAndDropScheduling" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Lets users create events associated with records by dragging a record from a list view onto a calendar view and entering the details of the event in an overlay. Hovering over an event displays an overlay where users can view the event details or delete the event without leaving the page. Admins use a mini page layout to configure the fields shown in the overlays.Admins control this field on the User Interface settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEmailTracking" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables tracking of outbound HTML emails if an organization uses HTML email templates.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFlowTaskNotifsViaApex" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If Apex invokes Process Builder to create a task, determines whether an email is sent (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableGroupTasks" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Lets users assign independent copies of a new task to multiple users.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHideChildEventsPreference" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables hiding child events from the calendar or activity views. This setting is useful if you have complex event hierarchies and want to simplify the views by hiding less relevant details. This field is available in API version 50.0 and later.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableListViewScheduling" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Extends the functionality of enableDragAndDropScheduling and enableClickCreateEvents to list view calendars.Admins control this field on the User Interface settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableLogNote" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables the option to create and associate a note on an existing record.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMLSingleClientProfile" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enable creating a client profile using machine learning. When this setting is enabled, Salesforce uses machine learning algorithms to analyze and consolidate client data, providing a more comprehensive client profile. This can help sales and service teams to better understand their clients and provide more personalized interactions. This field is available in API version 50.0 and later.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMultidayEvents" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables creation of events that end more than 24 hours after they start.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRecurringEvents" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables creation of events that repeat at specified intervals.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRecurringTasks" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables creation of tasks that repeat at specified intervals.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRollUpActivToContactsAcct" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables a contact’s activities to be rolled up and displayed on the contact’s primary account. Default value is true.Available in API versions 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSidebarCalendarShortcut" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>In the sidebar, displays a shortcut link to a user’s last-used calendar view.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSimpleTaskCreateUI" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Allows admins to specify whether tapping New Task in Salesforce opens a regular task record edit page or a page that displays key task fields first.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableTimelineCompDateSort" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Allows admins to sort past activities by completed date (true). If false, activities are sorted by due date.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableUNSTaskDelegatedToNotifications" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>On the Activity Settings page, exposes a setting for Admins to hide or show a user setting that lets individual users enable or disable email notifications when tasks are assigned to them.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableUserListViewCalendars" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Allows users to create and view user list view calendars in Lightning Experience. Available in API versions 47.0 and later</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="meetingRequestsLogo" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Available when showCustomLogoMeetingRequests is enabled. Uploads a custom logo. An administrator can select only a logo that has been uploaded to certain folders in the Documents tab.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showCustomLogoMeetingRequests" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Displays a custom logo in meeting request emails and on a meeting’s Web page. Invitees see the logo when a user either invites them to an event or requests a meeting.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showEventDetailsMultiUserCalendar" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Displays event details on-screen rather than in hover text.Admins control this field on the Activity Settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showHomePageHoverLinksForEvents" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>In the calendar section of the Home tab: When a user hovers over the subject of an event, a hover link displays an overlay with selected event details. (Hover links are always available in other calendar views.) When a user clicks the subject of an event, displays the event detail page. Admins use a mini page layout to configure the fields shown in the overlay. Admins control this field on the User Interface settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showMyTasksHoverLinks" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>In the My Tasks section of the Home tab and on the calendar day view: When a user hovers over the subject of a task, a hover link displays an overlay with selected task details. When a user clicks the subject of a task, displays the task detail page. Admins use a mini page layout to configure the fields shown in the overlay. Admins control this field on the User Interface settings page.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActvPfrmDataConnectorS3">
  <xsd:annotation>
   <xsd:documentation>Represents the Amazon S3 bucket name and export directory.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actvpfrmdataconnectors3.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="bucketName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The Amazon S3 bucket name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="exportDirectory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>This is an optional field that is reserved for internal use.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The display name of ActvPfrmDataConnectorS3.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActvPlatformAdncIdentifier">
  <xsd:annotation>
   <xsd:documentation>Represents the information about the identifiers to be activated, such as Email, Phone, Mobile Advertiser (MAID) ID, and Over-the-top (OTT) ID.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actvplatformadncidentifier.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="activationPlatform" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the ActivationPlatform metadata type.Reference to ActivationPlatform.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="identifierHashMethod" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The hash method of the identifier type. The supported hash method for Email and Phone is SHA256. The supported hash method for MAID and OTT is NONE.</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformIdentifierHashMethod (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="identifierType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of identifier to be activated.Valid values are: EMAIL MAID OTT PHONE</xsd:documentation>
       <xsd:appinfo>Type: ActivationPlatformIdentifierType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the identifier.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ActvPlatformFieldValue">
  <xsd:annotation>
   <xsd:documentation>Represents the field values for the ActivationPlatformFields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_actvplatformfieldvalue.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="activationPlatformField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the ActivationPlatform metadata type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDefault" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the value is default (true) or not (false). The default is false. Picklist isn’t supported in API version 54.0</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The value of activationPlatformField.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AddressSettings">
  <xsd:annotation>
   <xsd:documentation>This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_addresssettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdjustmentsSettings">
  <xsd:annotation>
   <xsd:documentation>The adjustment options for forecasts.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_forecastingsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="allowExpandedColumns" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Set to true to show separate columns on the forecasts page for each adjustable forecast category and false to show adjustments when a user hovers over a forecast category. All forecast types must contain the same allowExpandedColumns value.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAdjustments" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Set to true to enable manager adjustments and false to disable them. All forecast types must contain the same enableAdjustments value. Disabling adjustments results in adjustment data being purged.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableOwnerAdjustments" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Set to true to enable owner adjustments for forecasts and false to disable them. All forecast types must contain the same enableOwnerAdjustments value. Disabling adjustments results in forecast adjustment data being purged.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAccountForecastFormula">
  <xsd:annotation>
   <xsd:documentation>Represents the formulas that are used to calculate forecast values in real time after applying the DPE calculations. For example, processing forecast rollover for all accounts at the start of a month.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="endPeriod" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The period until when the forecast formula is applicable.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="formulaExpression" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The formula based on which forecast values are calculated.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="formulaType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the calculation type for the formula.Possible values are: QUANTITY REVENUE The default value is QUANTITY.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFcstFormulaType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="startPeriod" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The period from when the forecast formula is applicable.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAccountForecastSet">
  <xsd:annotation>
   <xsd:documentation>Represents the forecast sets that define the forecast configurations for each business unit or different groups of accounts. With separate forecast sets at account or business unit level, you can focus on account-specific data and manage configuration updates for one business unit without impacting any other business unit’s data.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name for the account in the advanced account forecast fact record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="calculationFrequency" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The frequency at which the forecast set is recalculated automatically.Possible values are: Monthly Quarterly Weekly Yearly The default value is Monthly.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFcstCalcFrequency (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The description of the advanced account forecast set record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dimensions" minOccurs="0" maxOccurs="unbounded" type="AdvAcctForecastDimension">
      <xsd:annotation>
       <xsd:documentation>The dimensions selected for an advanced account forecast set to categorize the forecast data.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctForecastDimension[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayGroups" minOccurs="0" maxOccurs="unbounded" type="AdvAcctFrcstDisplayGroup">
      <xsd:annotation>
       <xsd:documentation>The information about the groups for the advanced account forecast set measures or dimensions.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFrcstDisplayGroup[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastAdjPeriods" minOccurs="0" maxOccurs="unbounded" type="AdvAcctForecastAdjPeriod">
      <xsd:annotation>
       <xsd:documentation>The details about the adjustment period of the advanced account forecast values.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctForecastAdjPeriod[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastFactObjectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API name of the object that contains the advanced forecast fact records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastFormulas" minOccurs="0" maxOccurs="unbounded" type="AdvAccountForecastFormula">
      <xsd:annotation>
       <xsd:documentation>The formulas based on which forecast values are calculated.</xsd:documentation>
       <xsd:appinfo>Type: AdvAccountForecastFormula[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastPeriodGroupName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the advanced account forecast period group record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastQuantityFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name for the forecast quantity in the advanced account forecast fact record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastRevenueFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name for the forecast revenue in the advanced account forecast record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastSetFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name for the Forecast Set ID in the advanced account forecast fact record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastSetName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the advanced account forecast set record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastStatusFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name for the status in the advanced account forecast fact record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="generationDpeDefName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the data processing engine (DPE) definition that’s used to generate advanced account forecast fact records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="measureDefinitions" minOccurs="0" maxOccurs="unbounded" type="AdvAcctForecastMeasureDef">
      <xsd:annotation>
       <xsd:documentation>The measures to display in the advanced account forecasts grid for the forecast set.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctForecastMeasureDef[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="periodFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name for the period in the advanced account forecast fact record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recalculateDpeDefName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the data processing engine definition that’s used to recalculate the advanced account forecast fact records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="regenerationDpeDefName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the data processing engine definition that’s used to regenerate the advanced account forecast fact records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rolloverDpeDefName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The data processing engine definition that’s used to generate the rollover advanced account forecast fact records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rolloverFrequency" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The frequency of rollover of the advanced account forecast records.Possible values are: Monthly Quarterly Weekly Yearly The default value is Monthly.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFcstCalcFrequency (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The status of the advanced account forecast set.Possible values are: Active Inactive</xsd:documentation>
       <xsd:appinfo>Type: AdvAccForecastSetStatus (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAcctForecastAdjPeriod">
  <xsd:annotation>
   <xsd:documentation>Represents details about the adjustment period of the advanced account forecast values.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="adjustmentDayCount" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The number of days during which you can make forecast adjustments.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="frequency" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The frequency that’s applicable to make any forecast adjustments.Possible values are: Month Quarter Week Year The default value is Month.</xsd:documentation>
       <xsd:appinfo>Type: PeriodTypes (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="profileName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the profile with which you can adjust the forecast set.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="startDay" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The start date for forecast adjustments.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAcctForecastDimension">
  <xsd:annotation>
   <xsd:documentation>Represents the dimensions selected for an advanced account forecast set to categorize the data. For example, a business unit requires forecast data for each account aggregated by product and ship-from location.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="advAcctForecastDimName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the advanced account forecast dimension.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dimensionFieldName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API name of the field for the dimension in the custom object that contains the generated advanced account forecast records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dimensionSourceName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the dimension source associated with the advanced account forecast set dimension record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="hierarchySequenceNumber" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The sequence number of the dimension source associated with the forecast set.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAcctForecastMeasureDef">
  <xsd:annotation>
   <xsd:documentation>Represents information about the measures to display in the advanced account forecasts grid for the forecast set.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="advAcctForecastMeasureDefName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the definition for the advanced account forecast measure.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="aggregationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of aggregation that’s used for calculating the advanced account forecast values.Possible values are: AVERAGE MAXIMUM MINIMUM SUM The default value is SUM.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFcstAggregationType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="computationMethod" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The method that’s used for calculating the advanced account forecast values.Values are: CUSTOM DATA_PROCESSING_ENGINE_DEFINITION FORMULA The default value is DATA_PROCESSING_ENGINE_DEFINITION.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFcstComputationMethod (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastDataMeasureName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The field of the facts object used for the advanced account forecast measure.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastMeasureName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name for the advanced account forecast measure to show on UI.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="forecastMeasureType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The measure type that’s used for the generated advanced forecast values.Possible values are: QUANTITY REVENUE The default value is QUANTITY.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFcstMeasureType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isAdjustmentTracked" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the adjustments made to the advanced account forecast values for this metric are tracked (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAcctFrcstDisplayGroup">
  <xsd:annotation>
   <xsd:documentation>Represents information about the groups for the advanced account forecast set measures or dimensions.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="advAcctFrcstDisplayGroupName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the advanced account forecast display group.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayGroupItems" minOccurs="0" maxOccurs="unbounded" type="AdvAcctFrcstDplyGroupItem">
      <xsd:annotation>
       <xsd:documentation>The items associated with a display group for an advanced account forecast set.</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFrcstDplyGroupItem[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayGroupType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The category of the display group.Possible value is: MEASURE</xsd:documentation>
       <xsd:appinfo>Type: AdvAcctFrcstDisplayGroupType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDefault" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the display group is the default group (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userProfileName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the profile for which the display group is applicable.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AdvAcctFrcstDplyGroupItem">
  <xsd:annotation>
   <xsd:documentation>Represents information about the items associated with a display group for an advanced account forecast set.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_advaccountforecastset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="advAcctFrcstDplyGroupItemName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the advanced account forecast display group that’s associated with the group item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The display order of the display group item.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="measureReferenceName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the measure associated with the display group item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="AffinityScoreDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents the affinity information used in calculations to analyze and categorize contacts for marketing purposes.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/fundraising_affinityscoredefinition_metadata_api.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="affinityScoreDefinitionDesc" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Description of the affinity score definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="affinityScoreDefinitionName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Name of the affinity score definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="affinityScoreType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Type of the affinity score that&apos;s defined. Valid values are CAP—Capacity, Ability, Propensity (CAP), or RFM—Recency, Frequency, Monetary (RFM). The default value is RFM.</xsd:documentation>
       <xsd:appinfo>Type: AffinityScoreType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Label for this affinity score definition value. This display value is the internal label that doesn&apos;t get translated.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="numberOfMonths" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Number of months to analyze the records for calculating the affinity score.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="numberOfRanges" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Number of ranges to use in the calculation, ranging from 0 to 9. Provide the corresponding range list values in the scoreRangeList field.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="scoreRangeList" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Ranges that are referenced in the affinity score calculation. This field is used with scoreRangeList. For example, to calculate RFM with numberOfRanges value as 3, provide the values for the scoreRangeList field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceFieldApiNameList" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. API names of the source fields that are referenced in the score calculation.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceObjectApiNameList" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API names of the source objects that are referenced in the score calculation.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetFieldApiNameList" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. API names of the target fields where the calculated scores are added.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetObjectApiName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API name of the target object where the calculated scores are added.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
