       <xsd:documentation>Indicates whether Education Cloud is enabled in Salesforce (true) or not (false). The default is false. Available in API version 57.0 and later in Developer, Enterprise, Performance and Unlimited editions.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableStudentSuccess" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Student Success is enabled in Salesforce (true) or not (false). The default is false. Available in API version 58.0 and later in Developer, Enterprise, Performance and Unlimited editions.</xsd:documentation>
