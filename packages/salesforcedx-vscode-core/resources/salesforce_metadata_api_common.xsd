  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="businessProcessFeedbacks" minOccurs="0" maxOccurs="unbounded" type="BusinessProcessFeedback">
      <xsd:annotation>
       <xsd:documentation>A list of stages in a customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: BusinessProcessFeedback[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of a stage in the customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API name of a stage in the customer lifecycle map. Only users with View DeveloperName OR View Setup and Configuration permission can view, group, sort, and filter this field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of a stage in the customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sequenceNumber" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The position of a stage in the customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="BusinessProcessFeedback">
  <xsd:annotation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_businessprocessgroup.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="actionName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the survey used to collect feedback</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="actionParam" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the survey question used to collect feedback.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="actionType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The mode of feedback collection. Valid values are: PHONE_CALL SURVEY</xsd:documentation>
       <xsd:appinfo>Type: ExpFeedbackCollType(enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="BusinessProcessGroup">
  <xsd:annotation>
   <xsd:documentation>Represents the surveys used to track customers’ experiences across different stages in their lifecycle. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_businessprocessgroup.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="businessProcessDefinitions" minOccurs="0" maxOccurs="unbounded" type="BusinessProcessDefinition">
      <xsd:annotation>
       <xsd:documentation>A list that defines stages in a customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: BusinessProcessDefinition[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customerSatisfactionMetric" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Types of questions that can be associated with stages in a customer lifecycle map. Valid values are: Attachment Boolean CSAT Currency Date DateTime FreeText Image NPS Matrix MultiChoice MultiSelectPicklist NPS Number Picklist Rating ShortText Slider StackRank Toggle</xsd:documentation>
       <xsd:appinfo>Type: SurveyQuestionType(enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the customer lifecycle map.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CMSConnectAsset">
  <xsd:annotation>
   <xsd:documentation>CMSConnectAsset defines the location, types, and order of assets necessary to support the incoming content, such as JavaScript and CSS files.</xsd:documentation>
