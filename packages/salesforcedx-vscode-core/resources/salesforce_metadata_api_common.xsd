 <xsd:complexType name="WaveRecipe">
  <xsd:annotation>
   <xsd:documentation>Represents the WaveRecipe type in an Analytics application. A recipe is a saved set of steps to perform on a specific source dataset or connected data. This type extends the MetadataWithContent metadata type and inherits its content and fullName fields.</xsd:documentation>
