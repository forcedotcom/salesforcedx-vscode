       <xsd:appinfo>Type: StreamingAppDataConnectorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SubscriptionManagementSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the settings used to manage recurring subscriptions.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_subscriptionmanagementsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableBillingDocGen" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether document generation is enabled in the org (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableConvertNegativeInvoiceLinesToCreditMemoAndApply" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to convert negative invoice lines into a credit note (true) or not (false). This credit note holds a positive balance that you can later use to apply against future invoices. The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableInvHeaderLvlSettlement" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether payments can be applied on the whole invoice (true) or only on invoice lines (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enablePaymentScheduleAutomation" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the payment schedule and payment schedule item are created automatically (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRefundAutomation" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether refunds are processed automatically (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRevSubMgmtBlngOptOut" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the billing schedules in Subscription Management are disabled (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSubscriptionManagement" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Subscription Management is enabled (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SubtabComponents">
  <xsd:annotation>
   <xsd:documentation>Represents custom console components on subtabs in the Salesforce console. Available in API version 25.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_layouts.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="component" minOccurs="0" maxOccurs="unbounded" type="ConsoleComponent">
      <xsd:annotation>
       <xsd:documentation>Represents a custom console component (Visualforce page, lookup field, or related lists; Canvas apps not available) on a section of a page layout. Custom console components only appear in the Salesforce console. This field is available in API version 29.0 and earlier.</xsd:documentation>
       <xsd:appinfo>Type: ConsoleComponent[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="containers" minOccurs="0" maxOccurs="unbounded" type="Container">
      <xsd:annotation>
       <xsd:documentation>Represents a location and style to display more than one custom console component on the sidebars of the Salesforce console. You can specify up to five components for each of the four locations (left, right, top, and bottom). This field is available in API version 30.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: Container[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SummaryLayout">
  <xsd:annotation>
   <xsd:documentation>When Case Feed is enabled, controls the appearance of the highlights panel in Salesforce Classic, which summarizes key fields in a grid at the top of a page layout. Available in API version 25.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_layouts.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the layout label.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sizeX" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Number of columns in the highlights pane, from 1 through 4 (inclusive).</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sizeY" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Number of rows in each column, either 1 or 2.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sizeZ" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Reserved for future use. If provided, the setting is visible to users.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="summaryLayoutItems" minOccurs="0" maxOccurs="unbounded" type="SummaryLayoutItem">
      <xsd:annotation>
       <xsd:documentation>Controls the appearance of an individual field and its column and row position within the highlights panel grid, when Case Feed is enabled. At least one is required.</xsd:documentation>
       <xsd:appinfo>Type: SummaryLayoutItem[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="summaryLayoutStyle" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Highlights panel style. Valid string values are: Default QuoteTemplate DefaultQuoteTemplate CaseInteraction QuickActionLayoutLeftRight (Available in API version 28.0 and later.) QuickActionLayoutTopDown (Available in API version 28.0 and later.)</xsd:documentation>
       <xsd:appinfo>Type: SummaryLayoutStyle (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SummaryLayoutItem">
  <xsd:annotation>
   <xsd:documentation>Controls the appearance of an individual field and its column and row position within the highlights panel grid, when Case Feed is enabled. You can have two fields per each grid in a highlights panel. Available in API version 25.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_layouts.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="customLink" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The customLink reference, if the item is a custom link.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="field" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field name reference, relative to the page layout. Must be a standard or custom field that also exists on the detail page.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="posX" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The item’s column position in the highlights panel grid. Must be within the range of sizeX.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="posY" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The item’s row position in the highlights panel grid. Must be within the range of sizeY.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="posZ" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Reserved for future use. If provided, the setting is visible to users.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SupervisorAgentConfigSkills">
  <xsd:annotation>
   <xsd:documentation>Represents the agent skills associated with a supervisor’s Chat configuration. Available in API version 29.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_livechatagentconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="skill" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the agent skills available for filtering the Agent Status list in the Supervisor Panel.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SurveySettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s survey settings. Use the SurveySettings component to enable Salesforce Surveys, enable Customer Lifecycle Maps, and choose whether the owner of a survey can manage the responses.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_surveysettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableGenerativeAISurveys" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether AI-Generated Surveys is enabled for your org (true) or not (false). The default value is false. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableIndustriesCxmEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Customer Lifecycle Maps is enabled for your org (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSurvey" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Surveys is enabled for your org (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSurveyOwnerCanManageResponse" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the owner of a survey can manage its responses. The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SustainabilityUom">
  <xsd:annotation>
   <xsd:documentation>Represents the unit of measure (UOM) values for custom fuel types in an org. Track fuel consumption and emission results with the flexibility to add custom fuel types and UOM values.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sustainabilityuom.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The description of the unit of measure.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProductUom" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the unit of measure is for a product that the company has procured in its supply chain operations (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t impact the behavior of the metadata type. The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isStationaryAssetUom" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the unit of measure is used in the stationary asset calculations (true) or (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isVehicleAssetUom" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the unit of measure is used in the vehicle asset calculations (true) or (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isWasteUom" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the unit of measure is used in the generated material waste calculations (true) or (false). The default value is false. This field is available in API version 65.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label assigned to this object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="unitType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of unit used for conversions or calculations. Values are: Energy Other Volume Weight</xsd:documentation>
       <xsd:appinfo>Type: UnitType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SustnUomConversion">
  <xsd:annotation>
   <xsd:documentation>Represents information about the unit of measure (UOM) conversion for the custom fuel types defined by a customer in an org.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sustnuomconversion.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="conversionFactor" minOccurs="0" maxOccurs="unbounded" type="xsd:double">
      <xsd:annotation>
       <xsd:documentation>Required. The conversion factor that&apos;s used to convert values from one unit of measure to another for the fuel type.</xsd:documentation>
       <xsd:appinfo>Type: double</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fuelType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the fuel type.Possible values are: AutogasLPG Biodiesel Biomass CityGas CompressedNaturalGasCNG Cooling Diesel Electricity Ethanol FuelOil Gasoline Heat HeavyOil ITElectricity JetFuel Kerosene LightOil LiquidNaturalGasLNG MobileDiesel NaturalGas Propane Refrigerant Steam</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t impact the behavior of the metadata type. The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A user-friendly name for SustnUomConversion, which is defined when the SustnUomConversion is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceUom" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The source unit of measure for the fuel type. Possible values are: 1000m3 GJ GWh Kiloliters Liters MJ MMBtu MWh Therms Tonnes UkGallons UsGallons ccf kG kWh kcal lbs longTons m3 shortTons</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetUom" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The target unit of measure for the fuel type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="uomsKey" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The key associated with a unit of measure for the fuel type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogCategory">
  <xsd:annotation>
   <xsd:documentation>Represents the grouping of individual catalog items in Service Catalog.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogcategory.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="image" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The developer name of a content document to be displayed in the Service Catalog for this category.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if a catalog category is active.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value. This value currently has no impact.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The primary label for the catalog category record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="parentCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If provided, the name of another SvcCatalogCategory that this category should appear under. The parent category in this field can’t have its own parent category. Categories can’t have more than one level of nesting.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sortOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Displays a set order for catalog category entities.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogCategoryItem">
  <xsd:annotation>
   <xsd:documentation>Represents the assignment of this service to a category within the Service Catalog.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogitemdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isPrimaryCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Determines if the catalog category (svcCatalogCategory) is the primary category for this catalog item. Exactly one category per SvcCatalogItemDef component must set this attribute to true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sortOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The position of the catalog item relative to other catalog items in the catalog category.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="svcCatalogCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The catalog category the catalog item is assigned to.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogFulfillFlowItem">
  <xsd:annotation>
   <xsd:documentation>Represents a variable in a fulfillment flow that can accept input. Describes what type of value it accepts.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogfulfillmentflow.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="catalogInputVariable" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The FlowVariable the fulfillment flow property represents.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The display options available. Values are: Checkbox Date (available in API version 59.0 and later) DateTime (available in API version 59.0 and later) Lookup Number Picklist Queue (available in API version 57.0 and later) Text</xsd:documentation>
       <xsd:appinfo>Type: PropertyDisplayType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fieldDefinition" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of a field in the object provided in objectLookupDomain that specifies the value for this variable. If displayType is Picklist, this value must be the name of a picklist field. If displayType is Lookup and fieldLookupDomain is FieldDefinition, this value must be the name of a relationship field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fieldLookupDomain" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of a standard or custom object that specifies the domain of that lookup or picklist. This value is relevant only if displayType is Lookup or Picklist.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isAdditionalQuestionsInputVariable" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Determines if this variable accepts input for all additional questions that were asked to a user. This value can only be true if the displayType for this item is Text. Only one item per SvcCatalogFulfillmentFlow component can set this attribute to true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Determines if the field is required for the related fulfillment flow to be executed.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="lookupDomainFieldType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>This value specifies the fields for the object specified by objectLookupDomain that are displayed in the Catalog Builder by type. This value is only relevant if displayType is Lookup and fieldLookupDomain is FieldDefinition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The primary label for the fulfillment flow record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectLookupDomain" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of a custom or standard object. If displayType is Lookup or Picklist, this value filters the available options to a specific object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogFulfillmentFlow">
  <xsd:annotation>
   <xsd:documentation>Represents the flow associated with a specific catalog item in the Service Catalog.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogfulfillmentflow.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Free-text description of the fulfillment flow.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="flow" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the flow represented by this SvcCatalogFulfillmentFlow.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="icon" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the details of an icon.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value. This value currently has no impact.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="items" minOccurs="0" maxOccurs="unbounded" type="SvcCatalogFulfillFlowItem">
      <xsd:annotation>
       <xsd:documentation>The list of variables in the flow that can accept a value as input.</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogFulfillFlowItem[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The primary label for the fulfillment flow record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogItemAttrDetail">
  <xsd:annotation>
   <xsd:documentation>Represents the details for an attribute of an item version. Used for options displayed in picklist or checkbox groups.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogitemdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isDefault" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Marks the attribute detail as the default. Applicable when the input display type is picklist or checkbox.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Picklist option label when the input type is picklist or checkbox.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Attribute value defined by the catalog builder.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogItemAttribute">
  <xsd:annotation>
   <xsd:documentation>Represents an attribute of a catalog item version. It can be a static input filled by the catalog builder user or additional questions that end users answer at runtime. Available in API version 57.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogitemdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="field" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Applicable when the display type is Lookup/Reference.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="inputType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Values are: Attachment Checkbox Currency Date Datetime DisplayText Email IPAddress Integer ListOfAttachment(available in API version 65.0 and later) ListOfBoolean ListOfDouble ListOfInteger ListOfMaps ListOfString Lookup Map MultilineText MultiSelectPicklist(available in API version 65.0 and later) Number NumericScale Password(available in API version 65.0 and later) Percentage Picklist Queue RadioButton(available in API version 65.0 and later) SingleCheckbox (available in API version 59.0 and later) SinglelineText Text Toggle (available in API version 59.0 and later) Url</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogItemAttrDataType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="inputVariable" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>References the input variable to which the attribute value is forwarded.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Determines if an answer is required for this question.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A translatable label for rendering the attribute to users.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="maxValue" minOccurs="0" maxOccurs="unbounded" type="xsd:double">
      <xsd:annotation>
       <xsd:documentation>Applicable when the display type is slider.</xsd:documentation>
       <xsd:appinfo>Type: double</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="minValue" minOccurs="0" maxOccurs="unbounded" type="xsd:double">
      <xsd:annotation>
       <xsd:documentation>Applicable when the display type is slider.</xsd:documentation>
       <xsd:appinfo>Type: double</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Applicable when the display type is Lookup/Reference.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="object" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A picklist object’s custom API Name. Applies when inputType is set to Picklist.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="options" minOccurs="0" maxOccurs="unbounded" type="SvcCatalogItemAttrDetail">
      <xsd:annotation>
       <xsd:documentation>The values attached to an attribute of an item version.</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogItemAttrDetail</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Type of the attribute; used to determine if it&apos;s a pre-filled input or questions to ask users. Values are: FulfillmentInput UserQuestion</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogItemAttrType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Attribute value defined by the catalog builder.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogItemDef">
  <xsd:annotation>
   <xsd:documentation>Represents the entity associated with a specific, individual service available in the Service Catalog.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogitemdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="apiVersion" minOccurs="0" maxOccurs="unbounded" type="xsd:double">
      <xsd:annotation>
       <xsd:documentation>The API version in which this catalog item was created. The value for this field updates based on the value of fulfillmentFlow. For catalog items created before version 57.0, the value for this field is null. Available in version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: double</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="catalogFilterCriteria" minOccurs="0" maxOccurs="unbounded" type="SvcCatalogItemDefFiltrCrit">
      <xsd:annotation>
       <xsd:documentation>The eligibility rule associated with a catalog item. Eligibility rules customize access to catalog items for different audiences, based on the User object. Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogItemDefFiltrCrit[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="categories" minOccurs="0" maxOccurs="unbounded" type="SvcCatalogCategoryItem">
      <xsd:annotation>
       <xsd:documentation>A list of catalog categories that contain this catalog item.</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogCategoryItem[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataCategories" minOccurs="0" maxOccurs="unbounded" type="SvcCatalogItemDefDataCategorySelection">
      <xsd:annotation>
       <xsd:documentation>A list of data categories for this catalog item. Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogItemDefDataCategorySelection[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Description of the catalog item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="flow" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The screen flow associated with the catalog item. Available in API version 53.0 to 58.0.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fulfillmentFlow" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Name of the related SvcCatalogFulfillmentFlow, which represents the flow associated with a specific catalog item in the Service Catalog. Available in API version 56.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="image" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The developer name of a content document to be displayed in the Service Catalog for this item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="inputs" minOccurs="0" maxOccurs="unbounded" type="SvcCatalogItemAttribute">
      <xsd:annotation>
       <xsd:documentation>Represents attributes of a catalog item version. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: SvcCatalogItemAttribute[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="internalNotes" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Intended to describe what the catalog item does and its implementation. That value is meant for other catalog builders.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isAvailableToAllCustomers" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Controls catalog item access for internal users. To share with all internal users, set the value to True. This value corresponds to the Allow Access for All Users option for Internal Access in the Catalog Item Builder. Available in API version 61.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isFeatured" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Determines if the catalog item is part of the featured catalog items.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isGuestAccessible" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Controls catalog item access for guest users. To share with guests, set the value to True. This value corresponds to Guest Visibility option for External Access in the Catalog Item Builder. Available in API version 61.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value. This value has no impact.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The primary label for the catalog item record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sharedTo" minOccurs="0" maxOccurs="unbounded" type="SharedTo">
      <xsd:annotation>
       <xsd:documentation>Describes how the catalog item is shared across multiple catalog categories. SvcCatalogItemDef only supports sharing with groups.</xsd:documentation>
       <xsd:appinfo>Type: SharedTo</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Displays the publishing status of a catalog item. Values are: Deprecated Draft PendingChanges Published</xsd:documentation>
       <xsd:appinfo>Type: PublishStatusType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogItemDefDataCategorySelection">
  <xsd:annotation>
   <xsd:documentation>Represents a list of data categories for this catalog item. This subtype is available in API version 59.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogitemdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="category" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API name of a data category.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="categoryGroup" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API Name of a data category group.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SvcCatalogItemDefFiltrCrit">
  <xsd:annotation>
   <xsd:documentation>Represents the association of an eligibility rule with a catalog item. Eligibility rules customize access to catalog items for different audiences, based on the User object. Available in version 59.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_svccatalogitemdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="svcCatalogFilterCriteria" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the associated catalogFilerCriteria eligibility filter.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SynonymDictionary">
  <xsd:annotation>
   <xsd:documentation>Represents a set of synonym groups, which are groups of words or phrases that are treated as equivalent in users’ searches. You can define synonym groups to optimize search results for acronyms, variations of product names, and other terminology unique to your organization. Synonyms are available in Service Cloud features such as Salesforce Knowledge. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_synonymdictionary.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="groups" minOccurs="0" maxOccurs="unbounded" type="SynonymGroup">
      <xsd:annotation>
       <xsd:documentation>The synonym groups defined in this dictionary.</xsd:documentation>
       <xsd:appinfo>Type: SynonymGroup</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this component is protected (true) or not (false). Protected components cannot be linked to or referenced by components created in the installing organization.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the display name of the synonym dictionary.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="SynonymGroup">
  <xsd:annotation>
   <xsd:documentation>Represents a group of synonymous words or phrases.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_mldomain.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="languages" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the languages the value list applies to. If value list items are specific to a single language, specify only that language. If the value list items apply to multiple languages, specify multiple languages for one value list.</xsd:documentation>
       <xsd:appinfo>Type: Language (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="terms" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A word or phrase synonymous with other terms in the value list.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TabLimitConfig">
  <xsd:annotation>
   <xsd:documentation>Represents the maximum number of primary tabs and subtabs allowed in one Salesforce console session. Required if enableTabLimits is true.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_customapplication.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="maxNumberOfPrimaryTabs" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The maximum number of primary tabs allowed in one console session. Valid values are: 5 10 20 30</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="maxNumberOfSubTabs" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The maximum number of subtabs allowed in one console session. Valid values are: 5 10 15</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Tag">
  <xsd:annotation>
   <xsd:documentation>Represents a named label that can be applied to Salesforce metadata records to categorize, describe, or classify them. Tags are organized within a TagSet, which defines the category they belong to. For example, a TagSet named DataDomain might contain Tags such as Financial, Operational, or Legal. Use Tag to define the individual classification values available in a category. Use the listMetadata() call to discover custom Tags and TagSets in your org.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_tag.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the tag.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label that identifies the tag in the Salesforce user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique name of the tag. Can contain only underscores and alphanumeric characters and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="options" minOccurs="0" maxOccurs="unbounded" type="TagOption">
      <xsd:annotation>
       <xsd:documentation>A list of options associated with the tag.</xsd:documentation>
       <xsd:appinfo>Type: TagOption[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="properties" minOccurs="0" maxOccurs="unbounded" type="TagProperty">
      <xsd:annotation>
       <xsd:documentation>A list of properties associated with the tag.</xsd:documentation>
       <xsd:appinfo>Type: TagProperty[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TagOption">
  <xsd:annotation>
   <xsd:documentation>Represents an option associated with a tag.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_tag.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the option.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. The value of the option.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TagProperty">
  <xsd:annotation>
   <xsd:documentation>Represents a property associated with a tag.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_tag.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the property.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The value of the property.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TagSet">
  <xsd:annotation>
   <xsd:documentation>Represents a category that groups related Tag records. A TagSet defines the classification category, and its associated Tag records represent the individual values within that category. For example, a TagSet named DataDomain might group Tags such as Financial, Operational, or Legal. TagSets can be organized into a hierarchy, where a parent TagSet contains one or more child TagSets. This hierarchy allows you to make progressively granular classifications. Use the listMetadata() call to discover custom Tags and TagSets in your org.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_tagset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the tag set.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label that identifies the tag set in the Salesforce user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique name of the tag set. Can contain only underscores and alphanumeric characters and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="options" minOccurs="0" maxOccurs="unbounded" type="TagOption">
      <xsd:annotation>
       <xsd:documentation>A list of options associated with the tag set.</xsd:documentation>
       <xsd:appinfo>Type: TagOption[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="properties" minOccurs="0" maxOccurs="unbounded" type="TagProperty">
      <xsd:annotation>
       <xsd:documentation>A list of properties associated with the tag set.</xsd:documentation>
       <xsd:appinfo>Type: TagProperty[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="tags" minOccurs="0" maxOccurs="unbounded" type="Tag">
      <xsd:annotation>
       <xsd:documentation>A list of tags included in this tag set.</xsd:documentation>
       <xsd:appinfo>Type: Tag[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Targets">
  <xsd:annotation>
   <xsd:documentation>Represents a list of supported containers for a Lightning web component. For more information, see XML Configuration File Elements.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_lightningcomponentbundle.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="target" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the type of Lightning page the component can be added to in the builders, such as in Lightning App Builder, Experience Builder, Flow Builder, or Document Builder.For valid values, see XML Configuration File Elements: target.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory">
  <xsd:annotation>
   <xsd:documentation>Represents a territory.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies whether users in this territory can access accounts that are assigned to this territory and are otherwise inaccessible. Valid values are: Read Edit All If your organization’s sharing model for accounts is Public Read/Write, valid values are only Edit and All. If no value is set for this field, this field value uses the default access level that is specified in the Manage Territory page in Setup. This field is available in API version 31.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fullName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The unique identifier for API access. The fullName can contain only underscores and alphanumeric characters. It must be unique, begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. This field is inherited from the Metadata component. Corresponds to Territory Name in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="parentTerritory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The territory above this territory in the territory hierarchy.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with a sales territory. This type extends the Metadata metadata type and inherits its fullName field. Available if Sales Territories has been enabled.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accountAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies whether users in this territory can access accounts that are assigned to this territory and are otherwise inaccessible. Valid values are: Read Edit All If your organization’s sharing model for accounts is Public Read/Write, valid values are only Edit and All. If no value is set for this field, this field value uses the default access level that is specified in Territory2Settings as permitted by the organization’s sharing settings.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies whether users in this territory can access cases that are assigned to this territory and are otherwise inaccessible. Valid values are: None Read Edit Specify no value if your organization’s sharing model for cases/opportunities is Public Read/Write. If no value is set for this field, this field value uses the default access level that is specified in Territory2Settings as permitted by the organization’s sharing settings.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contactAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies whether users in this territory can access contacts that are assigned to this territory and are otherwise inaccessible. Valid values are: None Read Edit Specify no value if your organization’s sharing model for contacts is Public Read/Write or Controlled By Parent.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customFields" minOccurs="0" maxOccurs="unbounded" type="FieldValue">
      <xsd:annotation>
       <xsd:documentation>Values for custom fields defined on the Territory2 object and used by this territory. Their metadata is captured separately in CustomObject. Note the following: Territory2 and Territory2Model objects do not handle values for Text Area (Long), Text Area (Rich), and text-encrypted custom fields. Fields are referenced using their API names. Compound field types like Location appear as their constituent column fields. For example, nnn_Latitude__s, nnn_Longitude__s where “nnn” is the field name and the suffixes are the geolocation components. Values of required custom fields are enforced during the deploy() operation.</xsd:documentation>
       <xsd:appinfo>Type: FieldValue</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the territory.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The user interface label for the territory.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectAccessLevels" minOccurs="0" maxOccurs="unbounded" type="Territory2AccessLevel">
      <xsd:annotation>
       <xsd:documentation>Represents the user access levels of an object associated to a territory. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: Territory2AccessLevel</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="opportunityAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies whether users in this territory can access opportunities that are assigned to this territory and are otherwise inaccessible. Valid values are: None Read Edit Specify no value if your organization’s sharing model for cases/opportunities is Public Read/Write. If no value is set for this field, this field value uses the default access level that is specified in Territory2Settings as permitted by the organization’s sharing settings.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="parentTerritory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the territory’s parent. When you specify the parent territory, use the developer name. Do not use the “fully qualified” name. Custom fields with no values are retrieved with values of type: &lt;value xsi:nil=&quot;true&quot;/&gt;. You can also use &lt;value xsi:nil=&quot;true&quot;/&gt; syntax to remove existing values in custom fields.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ruleAssociations" minOccurs="0" maxOccurs="unbounded" type="Territory2RuleAssociation">
      <xsd:annotation>
       <xsd:documentation>Represents an object assignment rule and its association to a territory. Use the developer name of the rule.</xsd:documentation>
       <xsd:appinfo>Type: Territory2RuleAssociation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="territory2Type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The territory type that the territory belongs to.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2AccessLevel">
  <xsd:annotation>
   <xsd:documentation>Represents the association of an object access level to a territory. Available in API version 57.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Valid values are: Read Edit Transfer All If your organization’s sharing model for accounts is Public Read/Write, valid values are only Edit and All. If no value is set for this field, this field value uses the default access level that is specified in Territory2Settings as permitted by the organization’s sharing settings.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of object associated to the territory. For example, Lead.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2Model">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with a territory model in Sales Territories. This type extends the Metadata metadata type and inherits its fullName field. Available if Sales Territories has been enabled.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2model.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="customFields" minOccurs="0" maxOccurs="unbounded" type="FieldValue">
      <xsd:annotation>
       <xsd:documentation>Custom fields defined on the Territory2Model object and used by this model. Their metadata is captured separately. Territory2 and Territory2Model objects do not handle values for Text Area (Long), Text Area (Rich), and text-encrypted custom fields. Fields are referenced using their API names. Compound field types like Location appear as their constituent column fields. For example, nnn_Latitude__s, nnn_Longitude__s where “nnn” is the field name and the suffixes are the geolocation components. Values of required custom fields are enforced during the deploy() operation.</xsd:documentation>
       <xsd:appinfo>Type: FieldValue</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description for the territory model.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The user interface label for the territory model.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2Rule">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with a territory assignment rule associated with an object, such as Account. Available if Sales Territories has been enabled.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2rule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="active" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the rule is active (true) or inactive (false). Via the API, active rules run automatically when object records are created and edited. The exception is when the value of the IsExcludedFromRealign field on an object record is true, which prevents record assignment rules from evaluating that record.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>An advanced filter condition. For example: (1 AND 2) OR 3. Numbering must start at 1 and must be contiguous.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The user interface label for the rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object that the rule is defined for. For API version 32.0, the only available object is Account.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ruleItems" minOccurs="0" maxOccurs="unbounded" type="Territory2RuleItem">
      <xsd:annotation>
       <xsd:documentation>The items that define a rule’s the selection criteria, such as Billing State equals California.</xsd:documentation>
       <xsd:appinfo>Type: Territory2RuleItem</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2RuleAssociation">
  <xsd:annotation>
   <xsd:documentation>Represents the association of an object assignment rule to a territory. Available in API version 32.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="inherited" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the rule is inherited from a parent territory (true) or local to the current territory (false).Rule inheritance flows from the parent territory where the rule is created to the rule’s descendent territories, if any, in the territory model hierarchy. A local rule is created within a single territory and affects that territory only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ruleName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of a rule associated with the territory. It isn’t necessary to fully qualify ruleName because Metadata API assumes that the rule belongs to the same model as the territory.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2RuleItem">
  <xsd:annotation>
   <xsd:documentation>Represents the association of a rule item to a rule. Available in API version 32.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2rule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="field" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The standard or custom object field that the rule item operates on.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="operation" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The criterion to apply for the rule item. For example: equals or starts with. Valid values are: equals notEqual lessThan greaterThan lessOrEqual greaterOrEqual contains notContain startsWith includes excludes within (DISTANCE criteria only)</xsd:documentation>
       <xsd:appinfo>Type: FilterOperation (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The field value or values to evaluate. For example: if the field is Billing ZIP/Postal Code, a value could be 94105.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2Settings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s Territory2 settings. Use Territory2 settings to set the access level that Sales Territories users have to records associated with sales territories, and to enable features. The standard record access settings apply to accounts and opportunities. With Private default internal access for contacts or cases, you can also set access for those records. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2settings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="defaultAccountAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Sets the default level of access that users have to account records in territories: view and edit accounts assigned to territories or view, edit, transfer, and delete accounts assigned to territories.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultCaseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Sets the default level of access that users have to case records in territories: view and edit accounts assigned to territories or view, edit, transfer, and delete accounts assigned to territories.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultContactAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Sets the default level of access that users have to contact records in territories: view and edit accounts assigned to territories or view, edit, transfer, and delete accounts assigned to territories.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultOpportunityAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Sets the default level of access that users have to opportunity records in territories: view and edit accounts assigned to territories or view, edit, transfer, and delete accounts assigned to territories.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableTerritoryManagement2" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Enables and disables Sales Territories only. If true, Sales Territories is enabled. If false (default), Enterprise Territory Management isn’t enabled. Enabling and disabling Sales Territories is exclusive of all other operations, and the field value must be true before other territory-management operations can run. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="opportunityFilterSettings" minOccurs="0" maxOccurs="unbounded" type="Territory2SettingsOpportunityFilter">
      <xsd:annotation>
       <xsd:documentation>Optional. Specifies an Apex class to assign territories to opportunities and whether you want to run it when an opportunity is created. Available in API version 34.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: Territory2SettingsOpportunityFilter</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showTM2EnabledBanner" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, a success banner appears on the Territory Settings page in Setup.Available in API version 49.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="supportedObjects" minOccurs="0" maxOccurs="unbounded" type="Territory2SupportedObject">
      <xsd:annotation>
       <xsd:documentation>Sets the user access levels of all objects that support territory assignments in the org. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: Territory2SupportedObject[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="t2ForecastAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Sets the access level that users in a parent territory get to the opportunities assigned to its child territories, regardless of who owns the opportunities.Valid values are: View Edit Available in API version 49.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="tm2BypassRealignAccInsert" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, account assignment rules don’t run during account insert jobs.Available in API version 53.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="tm2EnableUserAssignmentLog" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, when a user is assigned to a territory, the assignment action is logged.Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2SettingsOpportunityFilter">
  <xsd:annotation>
   <xsd:documentation>This subtype specifies an Apex class that assigns territories to opportunities. You can run the Apex class automatically every time a user creates an opportunity, or run it by using multithreading.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2settings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="apexClassName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the Apex class name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, the Apex class is used to assign territories to opportunities.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="runMultiThreaded" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. If true, the Apex class runs by using multithreading, which can improve performance. Set this value to true only if you’re assigning opportunity or opportunity product splits, and your Apex code can run with multithreading. This field has a default value of false. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="runOnCreate" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, the Apex class runs automatically every time a user creates an opportunity.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2SupportedObject">
  <xsd:annotation>
   <xsd:documentation>Sets the user access levels of all objects that support territory assignments in the org.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2settings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="defaultAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The default user access level as permitted by the organization’s sharing settings. Valid values are: Read Edit Transfer All</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The only supported object type is Lead.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="state" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Valid values are: Disabled Enabled</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Territory2Type">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata for a category of territories in Sales Territories. Every Territory2 must have a Territory2Type. This type extends the Metadata metadata type and inherits its fullName field. Available if Sales Territories has been enabled.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_territory2type.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the territory type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The user interface label for the territory type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="priority" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Used for Filter-Based Opportunity Territory Assignment (Pilot in Spring ’15 / Metadata API version 33). Lets you specify a priority for a territory type. For opportunity assignments, the filter examines all territories assigned to the account that the opportunity is assigned to. The account-assigned territory whose territory type priority is highest is then assigned to the opportunity. The priority field value on each territory type must be unique. Further, if there are multiple territories with the same territory type, and therefore the same priority, assigned to the account, no territory is not assigned to the opportunity.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TimeSheetTemplate">
  <xsd:annotation>
   <xsd:documentation>Represents a template for creating time sheets in Field Service. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_timesheettemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="active" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the time sheet template is active (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The time sheet template&apos;s description.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="frequency" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Defines the frequency of the time sheet creation period. One of the following values: Daily Weekly EveryTwoWeeks TwiceAMonth Monthly</xsd:documentation>
       <xsd:appinfo>Type: TimeSheetFrequency (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the time sheet template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="startDate" minOccurs="0" maxOccurs="unbounded" type="xsd:date">
      <xsd:annotation>
       <xsd:documentation>Required. The date when the time sheet takes effect.</xsd:documentation>
       <xsd:appinfo>Type: date</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="timeSheetTemplateAssignments" minOccurs="0" maxOccurs="unbounded" type="TimeSheetTemplateAssignment">
      <xsd:annotation>
       <xsd:documentation>A list of profiles that the template is assigned to.</xsd:documentation>
       <xsd:appinfo>Type: TimeSheetTemplateAssignment</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="workWeekEndDay" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The end day of the template&apos;s work week. One of the following values: Monday Tuesday Wednesday Thursday Friday Saturday Sunday</xsd:documentation>
       <xsd:appinfo>Type: DaysOfWeek (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="workWeekStartDay" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The start day of the template&apos;s work week. One of the following values: Monday Tuesday Wednesday Thursday Friday Saturday Sunday</xsd:documentation>
       <xsd:appinfo>Type: DaysOfWeek (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TimeSheetTemplateAssignment">
  <xsd:annotation>
   <xsd:documentation>Returns a quick action that’s associated with an EmbeddedServiceLiveAgent setup. The quick action includes the pre-chat form fields that the embedded chat window displays and shows the order in which the fields are displayed.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_timesheettemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="assignedTo" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The IDs of the user profiles that a time sheet template is assigned to.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TimelineObjectDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents the container that stores the details of a timeline configuration. You can use this resource with Salesforce objects to see their records&apos; related events in a linear time-sorted view.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_timelineobjectdefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="baseObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object on which a timeline is based. Information displayed in a timeline comes from objects that are related to the base object. The base object can be a Salesforce object or custom object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="definition" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The timeline definition in JSON format.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the timeline is active (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The user interface label of the timeline object definition record.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TimelineObjectDefinitionTranslation">
  <xsd:annotation>
   <xsd:documentation>Contains details for a translation of a timeline object definition. Available in API version 66.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_translations.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Translated label for the timeline object definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the timeline object definition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TopicsForObjects">
  <xsd:annotation>
   <xsd:documentation>Represents the ability to assign topics to objects or to remove topic assignments.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_topicsforobjects.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableTopics" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. When true, indicates whether users can assign topics or remove topic assignments. When false, users can’t assign or remove topics.Upon org creation, this value is true for the following objects: Account Asset Campaign Case Contact Content Document Contract Event Lead Opportunity Order Solution Task For all remaining standard objects and custom objects, the default is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="entityApiName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates the object’s API name for enabling topics.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TouchMobileSettings">
  <xsd:annotation>
   <xsd:documentation>These fields are removed in API version 46.0. Salesforce Touch has been upgraded to the Salesforce mobile app.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_mobilesettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableTouchBrowserIPad" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether your organization has the Salesforce Touch mobile browser app enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableTouchAppIPad" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether your organization has the Salesforce Touch downloadable app enabled (true) or not (false)</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TrailheadSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s integration with Trailhead for Learning Paths or Enablement programs, including access to enablement sites (formerly myTrailhead). In the package manifest, all organization settings metadata types are accessed using the Settings name. See Settings for details.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_trailheadsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableConfettiEffect" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether animated confetti plays on the screen after a user reaches certain milestones, such as completing an Enablement program in the Guidance Center. The default value of this field is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMyTrailheadPref" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the org is connected to an enablement site (myTrailhead). The default value of this field is true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableTrailheadInLexTerms" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the terms and conditions for showing Trailhead content in Lightning Experience are accepted in your org. The default value of this field is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TransactionSecurityAction">
  <xsd:annotation>
   <xsd:documentation>Describes the action to take when the matching Transaction Security policy is triggered.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_transactionsecurity.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="block" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, the requested operation is blocked. This action only applies to Login and AccessResource events.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="endSession" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Used in Legacy Transaction Security only. If true, a current session must be closed before a new session can be started. This action only applies to Login events. As of Summer &apos;20, Legacy Transaction Security is a retired feature in all Salesforce orgs.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="freezeUser" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Used in Legacy Transaction Security only. If true, the user that triggered the policy is frozen. This action only applies to Chatter resources for Entity events. As of Summer &apos;20, Legacy Transaction Security is a retired feature in all Salesforce orgs.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notifications" minOccurs="0" maxOccurs="unbounded" type="TransactionSecurityNotification">
      <xsd:annotation>
       <xsd:documentation>Specifies how to notify the Salesforce administrator when the action is triggered. There can be none, one, or multiple notifications.</xsd:documentation>
       <xsd:appinfo>Type: TransactionSecurityNotification[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="twoFactorAuthentication" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, multi-factor authentication (MFA) is required for a higher level of access before the requested operation can continue. This action only applies to Login and AccessResource events. Multi-factor authentication was formerly called two-factor authentication.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TransactionSecurityNotification">
  <xsd:annotation>
   <xsd:documentation>Describes who to notify and how to notify them when the matching Transaction Security policy is triggered.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_transactionsecurity.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="inApp" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>True if an in-app notification is selected.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sendEmail" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>True if an email notification is selected.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="user" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The user to receive the notification.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TransactionSecurityPolicy">
  <xsd:annotation>
   <xsd:documentation>Represents a transaction security policy definition. Transaction security policies give you a way to look through events in your organization and specify actions to take when certain combinations occur. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_transactionsecurity.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="action" minOccurs="0" maxOccurs="unbounded" type="TransactionSecurityAction">
      <xsd:annotation>
       <xsd:documentation>Required. Describes the action to take when the matching Transaction Security policy is triggered.</xsd:documentation>
       <xsd:appinfo>Type: TransactionSecurityAction</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="active" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. If true, the policy is enabled and actively monitors its event.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="apexClass" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required for Apex-based policies, and optional for all other policies. The name of the class that implements the TxnSecurity.PolicyCondition or TxnSecurity.EventCondition interface for this policy. Available in API version 46.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="blockMessage" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The custom message sent to a user when a policy blocks their action. Used in Real-Time Event Monitoring only. Maximum of 1000 characters. This field is null when the default message option is selected in the UI. Available only when eventName is set to ApiEvent, ListViewEvent, BulkApiResultEventStore, or ReportEvent. Available in API version 49.0 and later. Include org- or policy-specific information in your custom message, such as the name of the responsible administrator or the business unit. Be careful about what you include. Too much information on how the policy was designed. can aid a malicious user. Two-factor authentication (2FA) isn’t supported in Lightning Experience, so events like ListView and ReportEvent are upgraded to Block in Lightning. Custom messages aren’t translatable.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customEmailContent" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The administrator-created custom email content sent when a policy is triggered. Used in Real-Time Event Monitoring only. Maximum of 1333 characters. This field is null when the Custom Email Content setting is selected in the UI but no message content is entered. Available in API version 54.0 and later.Custom messages aren’t translatable.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the policy.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>This unique name prevents conflicts with other policies that have the same masterLabel. This name can contain only underscores and alphanumeric characters, and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. Only users with View DeveloperName OR View Setup and Configuration permission can view, group, sort, and filter this field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="eventName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Used in Real-Time Event Monitoring only. Indicates the name of the event the policy monitors. This field is available in API 45.0 and later. Valid values are: AdminSetupEvent ApiAnomalyEventStore—Tracks anomalies in how users make API calls. ApiAnomalyEventStore is an object that stores the event data of ApiAnomalyEvent. This object is available in API version 50.0 and later. ApiEvent—Tracks these user-initiated read-only API calls: query(), queryMore(), and count(). Captures API requests through SOAP API and Bulk API for the Enterprise and Partner WSDLs. Tooling API calls and API calls originating from a Salesforce mobile app aren’t captured. BulkApiResultEventStore—Tracks when a user downloads the results of a Bulk API request. BulkApiResultEventStore is a big object that stores the event data of BulkApiResultEvent. This object is available in API version 50.0 and later. CredentialStuffingEventStore—Tracks when a user successfully logs into Salesforce during an identified credential stuffing attack. Credential stuffing refers to large-scale automated login requests using stolen user credentials.This value is available in API version 49.0 and later. FileEventStore —Tracks when a user downloads, previews, or uploads a file. FileEventStore is a big object that stores the event data of FileEvent. This object is available in API version 57.0 and later. GuestUserAnomalyEventStore—Tracks data access anomalies that are caused by guest user permission misconfiguration. This object is available in API version 60.0 and later. ListViewEvent—Tracks when users access data with list views using Lightning Experience, Salesforce Classic, or the API. It doesn’t track list views of Setup entities. LoginAnomalyEventStore LoginAsEvent—Tracks the login activity of admins who log in to Salesforce as other users. This object is available in API version 46.0 and later. LoginEvent—LoginEvent tracks the login activity of users who log in to Salesforce. PermissionSetEventStore —Tracks changes to permission sets and permission set groups. ReportAnomalyEventStore— This value is available in API version 49.0 and later. ReportEvent—Tracks when reports are run in your org. SessionHijackingEventStore—Tracks when unauthorized users gain ownership of a Salesforce user’s session with a stolen session identifier. To detect such an event, Salesforce evaluates how significantly a user’s current browser fingerprint diverges from the previously known fingerprint using a probabilistically inferred significance of change. Available in API version 49.0 and later. UniversalAnomalyEventStore</xsd:documentation>
       <xsd:appinfo>Type: TransactionSecurityEventName (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="eventType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Used in Legacy Transaction Security only. Required for Apex-based policies, and optional for all other policies. Indicates which type of event is being monitored. Valid values are: AccessResource—Notifies you when the selected resource has been accessed. AuditTrail—Reserved for future use. DataExport—Notifies you when the selected object type has been exported using the Data Loader API client. Entity—Notifies you on use of an object type such as an authentication provider or Chatter comment. Login—Notifies you when a user logs in. As of Summer &apos;20, Legacy Transaction Security is a retired feature in all Salesforce orgs.</xsd:documentation>
       <xsd:appinfo>Type: MonitoredEvents (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="executionUser" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Used in Legacy Transaction Security only. The name or ID of an active user who is assigned the Modify All Data and View Setup user permissions. As of Summer &apos;20, Legacy Transaction Security is a retired feature in all Salesforce orgs.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="flowId" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required only for policies of type CustomConditionBuilderPolicy. The ID of the Flow object that contains the logic the Condition Builder transaction security policy. Available in API version 46.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The label for this object. This display value is the internal label that is’t translated. Where possible, we changed noninclusive terms to align with our company value of Equality. We maintained certain terms to avoid any effect on customer implementations.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="resourceName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Used in Legacy Transaction Security only. Required for Apex-based policies, and optional for all other policies. A resource used to narrow down the conditions under which the policy triggers. For example, with a DataExport event, you can select a resource Lead to specifically monitor export activity occurring on your Lead entities. The resources available depend on the Event Type field. The following valid resources are grouped by event type. AccessResource—ConnectedApplication, Reports DataExport—Account, Case, Contact, Lead, Opportunity Entity—AuthProvider, ChatterMessage, FeedComment, FeedItem, Idea, Question Login—LoginHistory As of Summer &apos;20, Legacy Transaction Security is a retired feature in all Salesforce orgs.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The type of validation that the policy uses. The valid values are: CustomApexPolicy— Created with Apex editor. CustomConditionBuilderPolicy— Created with Condition Builder. The default value is CustomApexPolicy.</xsd:documentation>
       <xsd:appinfo>Type: TxnSecurityPolicyType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Translations">
  <xsd:annotation>
   <xsd:documentation>Metadata type that enables work with translations for various supported languages. The ability to translate component labels is part of the Translation Workbench. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_translations.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiCoachAgentScnrDefs" minOccurs="0" maxOccurs="unbounded" type="AiCoachAgentScnrDefTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of AI Coach agent scenario definition translations. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: AiCoachAgentScnrDefTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="botBlocks" minOccurs="0" maxOccurs="unbounded" type="BotBlockTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of bot block translations. Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: BotBlockTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="botTemplates" minOccurs="0" maxOccurs="unbounded" type="BotTemplateTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of bot template translations. Available in API version 59.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: BotTemplateTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="bots" minOccurs="0" maxOccurs="unbounded" type="BotTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of bot translations. Available in API version 53.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: BotTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="conversationMessageDefinitions" minOccurs="0" maxOccurs="unbounded" type="ConversationMessageDefinitionTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of conversation message definition translations. Available in API version 61.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ConversationMessageDefinitionTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customApplications" minOccurs="0" maxOccurs="unbounded" type="CustomApplicationTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of custom application translations.</xsd:documentation>
       <xsd:appinfo>Type: CustomApplicationTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customLabels" minOccurs="0" maxOccurs="unbounded" type="CustomLabelTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of custom label translations.</xsd:documentation>
       <xsd:appinfo>Type: CustomLabelTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customPageWebLinks" minOccurs="0" maxOccurs="unbounded" type="CustomPageWebLinkTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of translations for web links defined in a home page component.</xsd:documentation>
       <xsd:appinfo>Type: CustomPageWebLinkTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customTabs" minOccurs="0" maxOccurs="unbounded" type="CustomTabTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of custom tab translations.</xsd:documentation>
       <xsd:appinfo>Type: CustomTabTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataConnectors" minOccurs="0" maxOccurs="unbounded" type="DataConnectorTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of data connector translations. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: DataConnectorTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="desFieldTemplateMessages" minOccurs="0" maxOccurs="unbounded" type="ExplainabilityMsgTemplateFieldTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of admin-configured explainability message templates.</xsd:documentation>
       <xsd:appinfo>Type: ExplainabilityMsgTemplateFieldTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="flowDefinitions" minOccurs="0" maxOccurs="unbounded" type="FlowDefinitionTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of flow translations.Only Flow and AutolaunchedFlow types are supported for translation. This field is available in API version 41.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: FlowDefinitionTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="identityVerificationCustomFieldLabels" minOccurs="0" maxOccurs="unbounded" type="IdentityVerificationFieldTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of identity verification translation fields. This field is available in API version 54.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: IdentityVerificationFieldTranslation</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fullName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The language code. For example, de for German.Inherited from Metadata, this field is defined in the WSDL for this metadata type. It must be specified when creating, updating, or deleting. For an example of this field specified for a call, see createMetadata().</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="globalPicklists" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A list of global picklist translations. A global picklist’s value set is inherited by all the custom picklist fields that are based on it. This field is available in API version 37.0 only and is removed from later versions.</xsd:documentation>
       <xsd:appinfo>Type: GlobalPicklistTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="pipelineInspMetricConfigs" minOccurs="0" maxOccurs="unbounded" type="PipelineInspMetricConfigTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of translations of Pipeline Inspection forecast category metric settings. This field is available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PipelineInspMetricConfigTranslation</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="productSpecificationTypes" minOccurs="0" maxOccurs="unbounded" type="ProductSpecificationTypeTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of product specification type translations. This field is available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ProductSpecificationTypeTranslation</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="prompts" minOccurs="0" maxOccurs="unbounded" type="PromptTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of In-App Guidance prompt translations. This field is available in API version 48.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: PromptTranslation</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="quickActions" minOccurs="0" maxOccurs="unbounded" type="GlobalQuickActionTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of global rather than object-specific quick actions.</xsd:documentation>
       <xsd:appinfo>Type: GlobalQuickActionTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recordAlertCategories" minOccurs="0" maxOccurs="unbounded" type="RecordAlertCategoryTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of record alert category translations. Available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: RecordAlertCategoryTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recordAlertTemplates" minOccurs="0" maxOccurs="unbounded" type="RecordAlertTemplateTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of record alert template translations. Available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: RecordAlertTemplateTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="reportTypes" minOccurs="0" maxOccurs="unbounded" type="ReportTypeTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of report type translations.</xsd:documentation>
       <xsd:appinfo>Type: ReportTypeTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="scontrols" minOccurs="0" maxOccurs="unbounded" type="ScontrolTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of s-control translations.</xsd:documentation>
       <xsd:appinfo>Type: ScontrolTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="svcCatalogItemAttributes" minOccurs="0" maxOccurs="unbounded" type="ServiceProcessAttributeTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of service catalog item attribute translations. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ServiceProcessAttributeTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="svcCatalogItemGroups" minOccurs="0" maxOccurs="unbounded" type="ServiceProcessItemGroupTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of service catalog item group translations. Available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ServiceProcessItemGroupTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="timelineObjectDefinitions" minOccurs="0" maxOccurs="unbounded" type="TimelineObjectDefinitionTranslation">
      <xsd:annotation>
       <xsd:documentation>A list of timeline object definition translations. Available in API version 66.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: TimelineObjectDefinitionTranslation[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="TrialOrgSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the settings in a trial user’s org. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_trialorgsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableSampleDataDeleted" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether sample data may be deleted on trial orgs (true) or not (false). The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UIBundle">
  <xsd:annotation>
   <xsd:documentation>Represents the UI of a Salesforce Multi-Framework app, such as a React app.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uibundle.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of what the web application does.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies whether the web application is accessible (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>For internal use only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the web-application name that appears in the UI.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="target" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the Salesforce target where the app is supported. Valid values are: AppLauncher: Deprecated in API version 67.0. Instead, use CustomApplication. Makes the app available in the App Launcher. CustomApplication: When used with the CustomApplication metadata type, makes the app available in the App Launcher. This is the default target if you don’t specify a value. Available in API version 67.0 and later. Experience: Indicates that the app is an external-facing site or portal and makes it available in the Digital Experiences app.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="version" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates the version of the web application.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UIObjectRelationConfig">
  <xsd:annotation>
   <xsd:documentation>Represents the admin-created configuration of the object relation UI component.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uiobjectrelationconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="contextObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object that provides the context for this object relation configuration.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contextObjectRecordType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The record type of the context object for this configuration, if applicable.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="directRelationshipField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>For direct relationships, the child relationship field on the related object that matches the context object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="indirectObjectContextField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>For indirect relationships, the field on the junction object that matches the context object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="indirectObjectRelatedField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>For indirect relationships, the field on the junction object that matches the related object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="indirectRelationshipObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>For indirect relationships, the junction object representing the relationship between the related object and its context object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the configuration is active (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label for the UIObjectRelationConfig. In the UI, this field is UI Object Relation Config.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="relatedObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object containing the data that this object relation configuration displays.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="relatedObjectRecordType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The record type of the related object for this configuration.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="relationshipType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A string indicating the type of relationship between the related object and context object.Valid values are: Direct Indirect InverseDirect Self</xsd:documentation>
       <xsd:appinfo>Type: ObjectRelationshipType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="UIObjectRelationFieldConfigs" minOccurs="0" maxOccurs="unbounded" type="UIObjectRelationFieldConfig">
      <xsd:annotation>
       <xsd:documentation>Provides a configuration for an object relation field on a specific row of content.</xsd:documentation>
       <xsd:appinfo>Type: UIObjectRelationFieldConfig[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UIObjectRelationFieldConfig">
  <xsd:annotation>
   <xsd:documentation>Represents a configuration for a single row of content on a specific object relation configuration.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uiobjectrelationconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="displayLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A string containing the user-defined label for this field, to be displayed on each object relation of this type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="queryText" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A case-insensitive template query for generating the content in this field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rowOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Determines the top-to-bottom display order of this field on the object relation UI.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UiFormatSpecification">
  <xsd:annotation>
   <xsd:documentation>A single rule in the ruleset.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uiformatspecificationset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="formatProperties" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The properties for a given formatType in JSON format.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="formatType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of conditional formatting associated with the field when the rule evaluates to true. Values are: ICON</xsd:documentation>
       <xsd:appinfo>Type: FormatType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="order" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. A numerical value representing the conditional formatting rule’s position in the evaluation order.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="visibilityRule" minOccurs="0" maxOccurs="unbounded" type="UiFormulaRule">
      <xsd:annotation>
       <xsd:documentation>A set of one or more filters that define the conditions under which the conditional formatting appears on the field.If the visibility rule evaluates to true, the formatting displays on the field. If false, it doesn’t display. If this field is null, the formatting displays by default.</xsd:documentation>
       <xsd:appinfo>Type: UiFormulaRule</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UiFormatSpecificationSet">
  <xsd:annotation>
   <xsd:documentation>Represents a set of rules that define the style and visibility of conditional field formatting on Dynamic Forms-enabled Lightning page field instances.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uiformatspecificationset.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="field" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object field that the conditional formatting is associated with.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="formatType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of conditional formatting associated with the field. Values are: ICON</xsd:documentation>
       <xsd:appinfo>Type: FormatType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label for the conditional formatting ruleset, which displays in Setup.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sobjectType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object the ruleset is associated with.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="uiFormatSpecifications" minOccurs="0" maxOccurs="unbounded" type="UiFormatSpecification">
      <xsd:annotation>
       <xsd:documentation>The list of rules contained in the ruleset.</xsd:documentation>
       <xsd:appinfo>Type: UiFormatSpecification[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UiFormulaCriterion">
  <xsd:annotation>
   <xsd:documentation>A single filter that when evaluated, helps define component visibility on a Lightning page. Available in API version 41.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_flexipage.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="leftValue" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The field upon which the filter is based. For example, AMOUNT.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="operator" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Defines the operator used to filter the data. Valid values are: CONTAINS EQUAL NE—not equal GT—greater than GE—greater than or equal LE—less than or equal LT—less than</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rightValue" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The value by which you want to evaluate the component’s visibility. For example, 1000000.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UiFormulaRule">
  <xsd:annotation>
   <xsd:documentation>A set of one or more filters that define the conditions under which a component displays on a Lightning page. For example, you could construct a filter that causes a rich text component on an opportunity page to display only when the Amount is greater than $1,000,000. Available in API version 41.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_flexipage.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies advanced filter conditions such as 1 AND 2.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="criteria" minOccurs="0" maxOccurs="unbounded" type="UiFormulaCriterion">
      <xsd:annotation>
       <xsd:documentation>List of one or more filters that, when evaluated, determine component visibility.</xsd:documentation>
       <xsd:appinfo>Type: UiFormulaCriterion[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UiPreviewMessageTabDef">
  <xsd:annotation>
   <xsd:documentation>Represents the registration of a custom Marketing Cloud Preview and Test modal tab, created using custom Lightning web components. You can register and show multiple tabs in the Preview and Test experience.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uipreviewmessagetabdef.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the tab is enabled and is customer controlled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the configuration is protected (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label for the tab.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="lightningComponentDef" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The customer-created Lightning web component that displays in the Preview and Test tabs.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="supportedChannel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A string indicating the type of channel.Values are: Email Sms WhatsApp</xsd:documentation>
       <xsd:appinfo>Type: SupportedChannel (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="tabName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The case-sensitive, user-defined label displayed as the name of the tab. Maximum length is 255 characters.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UiWidgetBundle_Beta">
  <xsd:annotation>
   <xsd:documentation>Represents a widget. Use widgets to define reusable UI compositions once and deploy them across supported Salesforce applications and third-party platforms. Deploy this bundle to your Salesforce org to make the widget available.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_uiwidgetbundle.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Describes the widget.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the name of a widget bundle which is defined when the UiWidgetBundle is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="widgetType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Represents the widget type. The only allowed value is JSON.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Usage">
  <xsd:annotation>
   <xsd:documentation>Salesforce provides default authentication providers, called Salesforce-managed auth providers, to simplify setting up these service providers for authentication.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_authproviders.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserAccessPolicy">
  <xsd:annotation>
   <xsd:documentation>Represents a user access policy.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_useraccesspolicy.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The logic that determines how your user criteria filters are applied in the user access policy. For example, if you have two user access policy filters with the sortOrder equal to 1 and 2, respectively, the booleanFilter can be 1 AND 2 or 1 OR 2.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Description of the user access policy.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t impact the behavior of the metadata type. The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the user access policy, which is defined when the user access policy is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="order" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Indicates the order for which active policy is applied when a user meets the criteria for multiple policies. Must be an integer from 0 to 10,000. Only the active policy with the lowest order value is applied. This field is required only if the status field is set to Active. Available in API version 61.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The status of the user access policy. Values are: Active Completed Design Failed Migrate Testing Updating If you deploy a policy with a status of Active, the status is changed to Design. A Salesforce admin can then set the status to Active by automating the policy in Setup.</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyStatus (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="triggerType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The type of user record trigger for which this user access policy runs. Values are: Create—The user access policy runs when a user who matches the policy criteria is created. CreateAndUpdate—The user access policy runs when a user who matches the policy criteria is either created or updated. Update—The user access policy runs when a user who matches the policy criteria is updated.</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyTriggerType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAccessPolicyActions" minOccurs="0" maxOccurs="unbounded" type="UserAccessPolicyAction">
      <xsd:annotation>
       <xsd:documentation>The actions applied by the user access policy to grant access to or revoke access from an access mechanism.</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyAction[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAccessPolicyFilters" minOccurs="0" maxOccurs="unbounded" type="UserAccessPolicyFilter">
      <xsd:annotation>
       <xsd:documentation>The filters used to define the users that the user access policy is applied to.</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyFilter[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserAccessPolicyAction">
  <xsd:annotation>
   <xsd:documentation>Represents an action applied by a user access policy.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_useraccesspolicy.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="action" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the user access policy grants or revokes the target access mechanism. Values are: Grant Revoke</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyActionType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="target" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Developer name of the access mechanism that the user access policy applies.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of access mechanism that the user access policy applies. Values are: Group PackageLicense PermissionSet PermissionSetGroup PermissionSetLicense Queue</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyActionTargetType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserAccessPolicyFilter">
  <xsd:annotation>
   <xsd:documentation>Represents a user criteria filter for a user access policy.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_useraccesspolicy.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="columnName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If type is set to User, this is the user field that your user criteria filter is based on. If you set type to any value other than User, then this field isn’t used.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="operation" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The operator of the user criteria filter. Values are: equals equalsIgnoreCase—Available in API version 59.0 and later. in— Available in API version 58.0 and later. includes—Available in API version 59.0 and later. notEquals Select in if you want to reference multiple profiles or roles in the same user criteria filter via the target field.</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyFilterOperation (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sortOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The numeric reference used to identify the specific user criteria filter.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="target" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. If type is set to User, then set this field to User as well. If type is set to any other value, then set this field to the developer name of the specific resource used in the user criteria filter.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of resource that the user criteria filter is based on. Values are: Group PackageLicense PermissionSet PermissionSetGroup PermissionSetLicense Profile Queue User UserRole</xsd:documentation>
       <xsd:appinfo>Type: UserAccessPolicyFilterTargetType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If type is set to User, this field is the value of the user field specified in columnName that your user filter is operating on. If you set type to any value other than User, then this field isn’t used.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserAuthCertificate">
  <xsd:annotation>
   <xsd:documentation>Represents a PEM-encoded user certificate. These certificates are associated with a user, and externally uploaded. The uploaded certificate is used to authenticate the user.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_userauthcertificate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required: The name of the certificate with an underscore between words.Only users with View DeveloperName OR View Setup and Configuration permission can view, group, sort, and filter this field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="expirationDate" minOccurs="0" maxOccurs="unbounded" type="xsd:dateTime">
      <xsd:annotation>
       <xsd:documentation>Required. The date on which the certificate expires.</xsd:documentation>
       <xsd:appinfo>Type: dateTime</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name that you create for the certificate. Limited to 64 characters.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="serialNumber" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The serial number for the certificate.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="user" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required: The user’s name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserCriteria">
  <xsd:annotation>
   <xsd:documentation>Represents the member criteria to use in Experience Cloud site moderation rules. This type extends the Metadata metadata type and inherits its fullName field..</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_usercriteria.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="creationAgeInSeconds" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>If specified, includes only users that were created within a specific time frame.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The description of the user criteria.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="lastChatterActivityAgeInSeconds" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>If specified, includes only members that have posted or commented in the Experience Cloud site within a specific time frame.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Name of the user criteria.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userTypes" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The member type to use in moderation rules. Valid values are: Internal Customer Partner</xsd:documentation>
       <xsd:appinfo>Type: NetworkUserType enumeration ( of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserCriteriaBasedSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a criteria-based sharing rule for users. It extends the CriteriaBasedSharingRule metadata type and inherits its criteriaItems field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cbsrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="CriteriaBasedSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the filter logic of the sharing rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters. This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the type of allowed sharing. The possible values are: Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelReadEdit (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserDateGranularity">
  <xsd:annotation>
   <xsd:documentation>An enumeration of type string that defines the time period by which to group data. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserDateInterval">
  <xsd:annotation>
   <xsd:documentation>An enumeration of type string that defines the period. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserEngagementSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with various feature settings around Lightning Experience transition and adoption, user engagement and adoption assistance, and adoption apps.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_userengagementsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="canUseAdoptionApps" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether an org can access Lightning Experience transition tools (true) or not (false). Examples of these tools are Salesforce Optimizer, Lightning Experience Transition Assistant, and the Lightning Experience Readiness Report. The default is false. This field applies only to orgs with the External Application Settings page in Setup. Otherwise, this field has no effect. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="doesScheduledSwitcherRunDaily" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates where users are automatically switched from Salesforce Classic to Lightning Experience every day (true) or weekly (false). If false, then users are switched weekly. The default is false. See Encourage Users to Stay in Lightning Experience in Salesforce Help.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCustomHelpGlobalSection" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a custom section has been added to the Lightning Experience Help Menu (true) or not (false). The default is false. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowFeedback" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Give Feedback to Salesforce link in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowHelp" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Help For This Page section in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information. Available in API version 64.0 and earlier.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowNewUser" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Getting Started section in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.Available in API version 64.0 and earlier.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowSearch" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Search Documentation link in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.Available in API version 64.0 and earlier.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowSfdcContent" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether any Salesforce-created help resources in Lightning Experience Help Menu are visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowShortcut" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the View Keyboard Shortcuts link in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowSupport" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Go to Salesforce Help link in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHelpMenuShowTrailhead" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Go to Trailhead link in the Lightning Experience Help Menu is visible to users (true) or not (false). The default is true. Even if false, admins always see all links in the Help Menu. See Define Custom Help for the Lightning Experience Help Menu in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableIBILOptOutDashboards" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the It’s Better in Lightning prompt about Dashboards is hidden from users (true) or not (false). The default is true. Deprecated in API version 51.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableIBILOptOutEvents" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the It’s Better in Lightning prompt about Events/Calendar is hidden from users (true) or not (false). The default is true. Deprecated in API version 51.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableIBILOptOutReports" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the It’s Better in Lightning prompt about Reports is hidden from users (true) or not (false). The default is true. Deprecated in API version 51.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableIBILOptOutTasks" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the It’s Better in Lightning prompt about Tasks is hidden from users (true) or not (false). The default is true. Deprecated in API version 51.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableLexToClassicFeedbackEnable" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Switch to Salesforce Classic Feedback Form is shown to users (true) or not (false). The default is false. See Switch to Salesforce Classic Feedback Form in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableOrchestrationInSandbox" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether adoption assistance and other in-app guidance is shown to users in sandbox orgs (true) or not (false). The default is false. See Define Prompts in Lightning Experience in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableOrgUserAssistEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether all custom in-app guidance created by an org is shown to users (true) or not (false). Doesn’t affect active status. The default is true. See Define Prompts in Lightning Experience in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableScheduledSwitcher" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are automatically switched from Salesforce Classic to Lightning Experience (true) or not (false). The default is true. See Encourage Users to Stay in Lightning Experience in Salesforce Help.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSfdcProductFeedbackSurvey" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Salesforce Product Feedback Form is shown to users (true) or not (false). The default is true. See Salesforce Product Feedback Form in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableShowSalesforceUserAssist" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether all standard in-app guidance created by Salesforce is shown to users (true) or not (false). Doesn’t affect active status. The default is true. See Define Prompts in Lightning Experience in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isCrucNotificationDisabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether all notifications about the Winter ’20 Turn on Lightning Experience critical update are hidden from admins (true) or not (false). The default is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isLEXWelcomeMatDisabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Lightning Experience welcome mat is hidden from users the first time they log into the user interface (true) or not (false). The default is false. See Lightning Experience Welcome Mat in Salesforce Help for more information.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isMeetTheAssistantDisabledInClassic" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether all notifications about the Lightning Experience Transition Assistant are hidden from admins in Salesforce Classic (true) or not (false). The default is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isMeetTheAssistantDisabledInLightning" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether all notifications about the Lightning Experience Transition Assistant are hidden from admins in Lightning Experience (true) or not (false). The default is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="optimizerAppEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Salesforce Optimizer is turned on in the org (true) or not (false). The default is false. See Improve Your Implementation with Salesforce Optimizer in Salesforce Help.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="suggestedForYou" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Suggested For You is turned on in the org (true) or not (false). The default is true. See Suggested For You in Salesforce Help.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserInterfaceSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the settings that modify the behavior of the org’s user interface.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_userinterfacesettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="dynamicMruActionsOff" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can create custom actions for their Recently Viewed lists (true) or not (false). The default is true. Available in API version 52.0 and later. Applies to Lightning Experience only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAsyncRelatedLists" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether related lists are loaded asynchronously (true) or not (false). The default is false. Available in API version 47.0 and later. Salesforce Classic only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableClickjackUserPageHeaderless" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a Visualforce page that hides the standard header has clickjack protections (true) or not (false). The default is true. This setting applies to all of your Visualforce pages.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCollapsibleSections" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are allowed to collapse or expand sections in record details by using the arrow icon next to the section heading. The default is true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCollapsibleSidebar" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are allowed to show or hide the sidebar on every page that normally includes it (true) or not (false). The default is false. Applies to Salesforce Classic only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCustomObjectTruncate" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users with Customize Application permission can truncate custom objects (true) or not (false). When you truncate an object, you delete the object’s associated records permanently, while preserving the empty object and its metadata. The default is false. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCustomSidebarOnAllPages" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether custom sidebar components are available on all pages for all org users (true) or not (false). The default is false. Applies to Salesforce Classic only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableDeleteFieldHistory" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can delete field history and field history archive records (true) or not (false). The default is false. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableExternalObjectAsyncRelatedLists" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether related lists of external objects are loaded asynchronously ( true) or not (false). The default is true. Available in API version 48.0 and later. Salesforce Classic only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableHoverDetails" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether an interactive overlay containing record details is displayed (true) or not (false). The default is true.To view hover details for a record, users need the appropriate sharing access and field-level security access for the fields in the mini page layout.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableInlineEdit" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are allowed to edit field values on a record’s detail page (true) or not (false). The default is true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enablePersonalCanvas" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can install and use personal canvas apps (true) or not (false). The default is true. This setting applies to all of your Visualforce pages.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRelatedListHovers" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether related list hover links display at the top of record detail pages and custom object detail pages in Setup (true) or not (false). Users can hover over a related list link to display the list and its number of records in an interactive overlay. Users quickly view and manage the related list items from the overlay. Users can also click a related list hover link to jump to the related list without having to scroll down the page. The default is true. Available in API version 50.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSldsV2DarkModeInCosmos_beta" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether individual users can enable dark mode (true) or not (false) for the Salesforce Cosmos theme. The default value is false. Available for SLDS 2 themes in select editions. See Salesforce Cosmos Theme and SLDS 2 Availability. Available in API version 65.0 and later.Dark mode is a pilot or beta service that is subject to the Beta Services Terms at Agreements - Salesforce.com or a written Unified Pilot Agreement if executed by Customer, and applicable terms in the Product Terms Directory. Use of this pilot or beta service is at the Customer&apos;s sole discretion.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableQuickCreate" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether an area displays on a tab home page (corresponds to the Show Quick Create setting), allowing users to create a record quickly with minimal information (true) or not (false). The Quick Create area displays by default on the tab home pages for leads, accounts, contacts, and opportunities. You can control whether the Quick Create area is displayed on all relevant tab home pages.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="multiColumnSortLv" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can sort list views by multiple columns (true) or not (false). The default is true. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="multiColumnSortRL" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can sort related lists by multiple columns (true) or not (false). The default is true. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserManagementSettings">
  <xsd:annotation>
   <xsd:documentation>Represents a selection of user management options that appear on the User Management Settings Setup page. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_usermanagementsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableConcealPersonalInfo" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if personal information fields in user records are hidden from external users (true) or not (false). When this field is set to true, 10 personal information fields are hidden. The default value is false. This field is unavailable for orgs created in Winter ’22 or later.Salesforce recommends that you use the enableEnhancedConcealPersonalInfo field instead of enableConcealPersonalInfo. Before you set the enableEnhancedConcealPersonalInfo field to true, make sure that enableConcealPersonalInfo is set to false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableContactlessExternalIdentityUsers" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true and your org has the External Identity license, you can create contactless users. Having users without contact information reduces the overhead of managing customers. Purchase the External Identity license to access the Customer 360 Identity product.The default is false. Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEnhancedConcealPersonalInfo" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if personal information fields in user records are hidden from external users (true) or not (false). When this field is set to true, you can choose which fields are classified as personal information and hidden on the User Management Settings Setup page. The default value is false. This field is available in API version 53.0 and later.Before you set the enableEnhancedConcealPersonalInfo field to true, make sure that enableConcealPersonalInfo is set to false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEnhancedPermsetMgmt" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If you enable Enhanced Permission Set Component Views (true), you can work with permission sets more easily. For example, when you have large numbers of Apex class assignments for permission sets, you can enable a paginated result set, standard filtering, and sorting.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEnhancedProfileMgmt" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If you enable Enhanced Profile Lists Views (true), you can quickly view, customize, and edit list data.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEnhcUiUserAccessPolicies" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether you create and manage user access policies through an improved user interface (true) or not (false). The default value is false. If user access policies aren’t enabled, this field has no effect. If user access policies are enabled, this field is automatically set to true, but you can change it to false. Available in API version 60.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableNewProfileUI" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If you enable Enhanced Profile User Interface (true), you can use the streamlined, enhanced profile user interface to browse, search, and modify settings. You can use only one user interface at a time.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableProfileFiltering" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>With profile filtering enabled (true), you can restrict who sees profile names to the users who require the access for their job roles. If profile filtering is disabled (false), users can see all profiles in a Salesforce org, regardless of which permissions they have. Profile names are also exposed when users with permissions to perform the following tasks take these actions: Create a tab or record type with a wizard step that includes the assignment of tabs and record types to profiles. Configure a login flow where viewing profile lists is required to make flow associations. Set up delegated admins where looking up profiles is needed to identify assignable profiles. Administer an org as a delegated customer admin. Administer an org as a delegated admin to view and assign profiles of the delegated group. This field is available in API version 50.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRestrictEmailDomains" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Email Domain Allowlist is visible (true) or hidden (false) in Setup. The default value is false.This field is available in API version 53.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableScrambleUserData" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If you enable Let Users Scramble Their User Data (true), users can request that Salesforce remove all their personal data. Because Salesforce can’t delete information, it scrambles their data. Scrambling a user’s data is unrecoverable. So this org-wide setting serves as an extra precaution. If a user requests it, you scramble the data programmatically with the obfuscateUser Apex method. You can use the method, for example, in a custom Apex trigger, workflow, or the Developer Console.This field is available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableUserSelfDeactivate" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If you enable User Self Deactivate (true), users can deactivate their Experience Cloud site or Chatter accounts.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enhancedPermSetList" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether you manage permission sets with an updated user interface on the Permissions Setup page (true) or not (false). The default value is false. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enhancedUserListView" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether you manage users with an updated user interface on the Users Setup page (true) or not (false). The default value is false. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enhancedUserRoleListView" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether you manage roles with an updated user interface on the Roles Setup page (true) or not (false). The default value is false. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="groupSummaryUIEnhancement" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether you use an improved user interface to add or remove public group members through the group’s summary page true or not (false). If this field is set to true, you can still manage public group membership through the group’s detail page. The default value is true. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="permsetsInFieldCreation" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, users can assign field-level security to permission sets instead of to profiles when creating a field on an object, setting field-level security on a field, or changing a field type on a field. The default is false. Available in API version 56.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="psaExpirationUIEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if admins can use an updated user interface that includes an assignment expiration for permission sets and permission set groups (true) or not (false). The default value is false. This field is available in API version 52.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="restrictedProfileCloning" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>When enabled (true), only permissions accessible to your org are enabled when you clone profiles. When disabled (false), all permissions currently enabled in the source profile are also enabled for the cloned profile, even if your org can&apos;t currently access them.This field is available in API version 50.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAccessPoliciesEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if user access policies are enabled (true) or not (false). With user access policies, you can automate and migrate your users’ assignments to managed package licenses, permission sets, and other access mechanisms based on criteria that you set. The default value is false. This field is available in API version 58.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userFieldHistoryTracking" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if user field history tracking is enabled (true) or not (false). With user field history tracking, you can keep track of changes in user fields. The default value is false. This field is available in API version 64.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserMembershipSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a sharing rule to share members of a group with another group of users. It extends the OwnerSharingRule metadata type and inherits its fullName, sharedFrom, and sharedTo fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_ownersharingrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="OwnerSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters.This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a group or role is granted for a user. The possible values are: Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelReadEdit (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserProfileSearchScope">
  <xsd:annotation>
   <xsd:documentation>Reserved for internal use.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_userprofilesearchscope.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserProvisioningConfig">
  <xsd:annotation>
   <xsd:documentation>Represents information to use during a user provisioning request flow, such as the attributes for an update. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_userprovisioningconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="approvalRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Indicates whether approvals are required for provisioning users for the associated connected app. If the value is null, no approval is required.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="connectedApp" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the connected app for which users are being provisioned.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether user provisioning is enabled for the associated connected app (true) or not (false). Default setting is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enabledOperations" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Lists the operations, as comma-separated values, that create a user provisioning request for the associated connected app. Allowed values are: Create Update EnableAndDisable (activation and deactivation) SuspendAndRestore (freeze and unfreeze)</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="flow" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>User Provisioning flow type which includes a reference to the Apex UserProvisioningPlugin class. The flow calls the third-party service’s API to manage user account provisioning on that system.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The primary label for this object. This value is the internal label that doesn’t get translated.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="namedCredential" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The Salesforce ID of the named credential that’s used for a request. The named credential identifies the third-party system and the third-party authentication settings.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notes" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Serves as a place for admins to add any additional information about the configuration. This field is for internal reference only, and is not used by any process.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="onUpdateAttributes" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Lists the user attributes, as comma-separated values, that generate a user provisioning request during an update.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="reconFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>When collecting and analyzing users on a third-party system, the plug-in uses this filter to limit the scope of the collection.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="userAccountMapping" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Stores the attributes used to link the Salesforce user to the account on the third-party system, in JSON format. For example:</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="UserSharingRules">
  <xsd:annotation>
   <xsd:documentation>Represents the sharing rules for users. With user sharing rules, you can share members of a group with members of another group. It extends the SharingRules metadata type and inherits its fullName field. Only available in API version 32.0 and earlier.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="SharingRules">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="criteriaBasedRules" minOccurs="0" maxOccurs="unbounded" type="UserCriteriaBasedSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user criteria-based rules.</xsd:documentation>
       <xsd:appinfo>Type: UserCriteriaBasedSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="membershipRules" minOccurs="0" maxOccurs="unbounded" type="UserMembershipSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user membership-based rules.</xsd:documentation>
       <xsd:appinfo>Type: UserMembershipSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Users">
  <xsd:annotation>
   <xsd:documentation>Represents users in the org. Users can be added directly as queue members. Available in API version 42.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_queue.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="user" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents a user. Specify the user’s username.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValidationRule">
  <xsd:annotation>
   <xsd:documentation>Represents a validation rule, which is used to verify that the data a user enters in a record is valid and can be saved. A validation rule contains a formula or expression that evaluates the data in one or more fields and returns a value of true or false. Validation rules also include an error message that your client application can display to the user when the rule returns a value of true due to invalid data. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_validationformulas.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="active" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether this validation rule is active, (true), or not active (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the validation rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="errorConditionFormula" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The formula defined in the validation rule. If the formula returns a value of true, an error message is displayed.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="errorDisplayField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The fully specified name of a field in the application. If a value is supplied, the error message appears next to the specified field. If you do not specify a value or the field isn’t visible on the page layout, the value changes automatically to Top of Page.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="errorMessage" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The message that appears if the validation rule fails. The message must be 255 characters or less.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fullName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The internal name of the object. White spaces and special characters are escaped for validity. The name must: Contain characters, letters, or the underscore (_) character Must start with a letter Can’t end with an underscore Can&apos;t contain two consecutive underscore characters. Inherited from the Metadata component, this field isn’t defined in the WSDL for this component. It must be specified when creating, updating, or deleting. See create() to see an example of this field specified for a call.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValidationRuleTranslation">
  <xsd:annotation>
   <xsd:documentation>ValidationRuleTranslation contains details for a validation rule translation. For more details, see ValidationRule.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_customobjecttranslation.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="errorMessage" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Translation for the error message associated with the validation rule failure.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The validation rule name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValueSet">
  <xsd:annotation>
   <xsd:documentation>Represents a set of values that can be selected from a custom picklist field. Defines the valueSet of a custom picklist field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_field_types.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="controllingField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The fullname of the controlling field if this is a dependent picklist. A controlling field can be a checkbox or picklist field, but in this case it’s a picklist. The controlling picklist filters the available values in the dependent picklist.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="restricted" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Whether the picklist’s values are limited to only the values defined by a Salesforce admin. Values are true or false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueSetDefinition" minOccurs="0" maxOccurs="unbounded" type="ValueSetValuesDefinition">
      <xsd:annotation>
       <xsd:documentation>Defines value-specific settings for a custom dependent picklist. Indicates whether the value set of the custom picklist field is sorted alphabetically.</xsd:documentation>
       <xsd:appinfo>Type: ValueSetValuesDefinition</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueSetName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The masterLabel of the global value set to be used for this picklist field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueSettings" minOccurs="0" maxOccurs="unbounded" type="ValueSettings">
      <xsd:annotation>
       <xsd:documentation>Used for the settings that describe a value in a custom picklist field. The picklist can have its own unique value set, or inherit the values from a global value set. You can add field dependency values via the Metadata API but not remove them.</xsd:documentation>
       <xsd:appinfo>Type: ValueSettings</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValueSetValuesDefinition">
  <xsd:annotation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_field_types.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="sorted" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Whether the picklist’s value set is displayed in alphabetical order in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="CustomValue">
      <xsd:annotation>
       <xsd:documentation>Required. The list of values for this local, custom picklist.</xsd:documentation>
       <xsd:appinfo>Type: CustomValue</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValueSettings">
  <xsd:annotation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_field_types.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="controllingFieldValue" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Applies only to dependent custom picklists. A list of values in the controlling or parent picklist (that the custom picklist values depend on). You can add field dependency values via the Metadata API but not remove them.</xsd:documentation>
       <xsd:appinfo>Type: stringstring[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Defines the values in the custom dependent picklist.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValueTranslation">
  <xsd:annotation>
   <xsd:documentation>The original value name and the translated value name in a translated global value set.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_globalvaluesettranslation.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The original (untranslated) name of a value in a global value set. Each valueTranslation has a masterLabel paired with its translation.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="translation" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The translated name of a value in a translated global value set.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Version">
  <xsd:annotation>
   <xsd:documentation>ConversationMessageDefinitionTranslation is available in API version 61.0 and later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_conversationmessagedefinitiontranslation.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="VirtualVisitConfig">
  <xsd:annotation>
   <xsd:documentation>Represents an external video provider configuration, which relays events from Salesforce to the provider.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_virtualvisitconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="comprehendServiceType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the type of service used to convert speech into text or to analyze the converted speech text.Valid values are: ComprehendMedicalService ComprehendService</xsd:documentation>
       <xsd:appinfo>Type: VirtualVisitComprehendServiceType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The unique name of the object in the API. This name can contain only underscores and alphanumeric characters, and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores. In managed packages, this field prevents naming conflicts on package installations. With this field, a developer can change the object’s name in a managed package and the changes are reflected in a subscriber’s organization. Label is Record Type Name. This field is automatically generated, but you can supply your own value if you create the record using the API.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="experienceCloudSiteUrl" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The URL of the Digital Experience site where the Video Call component is available to portal or guest users.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalMsgServiceIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>For internal use only.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalRoleIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the role that&apos;s used to allow users to join a video call and to grant them temporary access to certain functions needed to participate in the call.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalUserIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>For internal use only.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fullName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The full name of the VirtualVisitConfig type in Metadata API. The full name can include a namespace prefix. Query this field only if the query result contains no more than one record. Otherwise, an error is returned. If more than one record exists, use multiple queries to retrieve the records. This limit protects performance.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t currently impact the behavior of the metadata type.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for VirtualVisitConfig, which is defined when the VirtualVisitConfig is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="messagingRegion" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The region where the waiting room and messaging channel data is processed and stored. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="namedCredential" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The named credential record used to authenticate and authorize a video call vendor’s account.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="storageBucketName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the storage bucket that stores the meeting transcript.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="usageType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the Salesforce feature for which the video call configuration record is created.Valid values are: CHIME ENTITY_DETECTION INTELLIGENT_FORM_READER KEY_PHRASE_EXTRACTION SENTIMENT_ANALYSIS</xsd:documentation>
       <xsd:appinfo>Type: VirtualVisitUsageType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="videoCallApptTypeValue" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The default Appointment Type picklist values from the Service Appointment object that represent a video appointment type. Use semicolons to separate multiple values.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="videoControlRegion" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The region where API calls related to Video Calls are made. Available in API version 57.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="visitRegion" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The region where the Video Call audio and video data is processed.Valid values are: af-south-1 ap-east-1 ap-northeast-1 ap-northeast-2 ap-northeast-3 ap-south-1 ap-southeast-1 ap-southeast-2 ca-central-1 eu-central-1 eu-north-1 eu-south-1 eu-west-1 eu-west-2 eu-west-3 me-south-1 sa-east-1 us-east-1 us-east-2 us-west-1 us-west-2</xsd:documentation>
       <xsd:appinfo>Type: VirtualVisitVisitRegion (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="VoiceSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s Sales Dialer settings, such as call recording, conferencing, and voicemail. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_voicesettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableCallDisposition" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether call disposition is enabled (true) or not (false). With call disposition, also called Call Result, sales reps can track whether a call was connected and how it went.Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableConsentReminder" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the consent reminder is enabled (true) or not (false). With the consent reminder, prior to recording a call, users see a prompt reminding them not to record phone calls without consent.Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableDefaultRecording" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the default recording is enabled (true) or not (false). With default recording, sales reps can record calls automatically in the Sales Dialer.Default value is false. This field is available in API version 54.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceCallList" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Call List is enabled (true) or not (false). Sales reps can use call list to keep a running list of the calls they want to make. Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceCallRecording" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Call Recording is enabled (true) or not (false). Sales reps can record important calls directly from the call panel in Sales Dialer. Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceCoaching" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Call Monitoring is enabled (true) or not (false). Using the Monitor tab in the call panel, managers can listen to the calls of their sales reps for personalized coaching.Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceConferencing" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Reserved for future use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceLocalPresence" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Local Presence is enabled (true) or not (false). Local Presence displays phone numbers with the same area code as the prospects your reps are calling, so more calls are answered.Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceMail" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether voicemail is enabled (true) or not (false). Sales reps can receive and store up to 20 personal voicemail messages in Salesforce. Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVoiceMailDrop" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Voicemail Drop is enabled (true) or not (false). Sales reps can “drop” (or send) prerecorded messages to recipients’ voicemail boxes. Default value is false. To use this feature, enable Dialer in Lightning Experience.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="WarrantyLifeCycleMgmtSettings">
  <xsd:annotation>
   <xsd:documentation>Represents settings that control the Warranty Administration for your org. In the package manifest, all organization settings metadata types are accessed using the Settings name. See Settings for more details.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_mfg_warrantylifecyclemgmtsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableWarrantyLCMgmt" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether warranty life-cycle management is enabled in your org (true) or not false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="WaveAnalyticAssestCollectionItem">
  <xsd:annotation>
   <xsd:documentation>WaveAnalyticAssestCollectionItem represents an Analytics asset item.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_waveanalyticassetcollection.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="asset" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The asset name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="assetType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The asset type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sortOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The sort order for the asset.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="WaveAnalyticAssetCollection">
  <xsd:annotation>
   <xsd:documentation>Represents a collection of Analytics assets. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_waveanalyticassetcollection.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
