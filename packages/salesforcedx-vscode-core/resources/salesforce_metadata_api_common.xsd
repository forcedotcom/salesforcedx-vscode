       <xsd:documentation>A list of localized labels and descriptions for use in different languages.</xsd:documentation>
       <xsd:appinfo>Type: LocalizedValue[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataConnectorError">
  <xsd:annotation>
   <xsd:documentation>Required.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_dataconnector.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="externalName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique name used to reference the object externally, such as in API calls. Must be unique across the namespace.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label displayed in the UI.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="translations" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>A list of localized labels and descriptions for use in different languages.</xsd:documentation>
       <xsd:appinfo>Type: LocalizedValue[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataConnectorS3">
  <xsd:annotation>
   <xsd:documentation>Represents the connection information specific to Amazon S3.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_dataconnectors3.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="fileNameWildcard" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Optional. File or Wildcard (*) to be used when finding files.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="importFromDirectory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Path from the directory to where files are located.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The UI name for the S3 data connector.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="s3BucketName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Optional. The Amazon S3 Name of the Bucket.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataKitObjectDependency">
  <xsd:annotation>
   <xsd:documentation>Represents the dependency between two data kit objects. The object templates are added inside the data kit.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datakitobjectdependency.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="dataPackageKitDef" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The ID of the linked DataPackageKitDefinition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the DataKitObjectDependency. This name can contain only underscores and alphanumeric characters and must be unique in your org. It must begin with a letter, not include spaces, not end with an underscore, and not contain two consecutive underscores.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label that identifies the data kit object dependency.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The source data kit object template that the target object depends on.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceObjectType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of the source object referenced in the data kit. Valid values are: DataKitObjectTemplate DataSourceObject DataStreamTemplate DataSourceBundleDefinition MKtDataModelObject</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The target data kit object template that depends on the source object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataPackageKitObject">
  <xsd:annotation>
   <xsd:documentation>Represents the object in Data Kit Content Object. These objects are added inside the data kit.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datapackagekitobject.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label that identifies the AI application throughout the Salesforce user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="parentDataPackageKitDefinitionName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the data kit definition</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="referenceObjectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the data kit content.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="referenceObjectType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of the content object in the data kit.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataSourceBundleDefinition">
  <xsd:annotation>
   <xsd:documentation>Represents the bundle of streams that a user adds to a data kit.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datasourcebundledefinition.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="dataPlatform" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates the connector type that the streams in the bundle belong to.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the associated data source bundle. This field is available in API version 53.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="icon" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The icon used in the deployment flow. This field is available in API version 53.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isMultiDeploymentSupported" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates if the bundle can be deployed multiple times or not. Default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates the name of the bundle.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="bundleVersion" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Indicates the version of the bundle. This field is available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataSourceField">
  <xsd:annotation>
   <xsd:documentation>Represents the details of a data source field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datasourcefield.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="datatype" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates the data type of the field: text, number, or date.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dateFormat" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The date format of date, time, date/time fields.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="definitionCreationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Describes whether this object was added by the user or as part of a standard taxonomy. Available in API version 62.0 and later. Valid values are: Activation_Audience (Reserved for internal use only) ADG Activation_Audience. Available in API version 63.0 and later. Bridge Calculated_Insight CG_Audience Chunk Curated Custom Derived Directory_Table External Ml_Prediction Segment_Membership Semantic Standard System Transform Vector_Embedding Valid values available in API version 67.0 and later are: Ad_Audience_Insights Auxiliary Clean_Room Deletion_Records Problem_Records</xsd:documentation>
       <xsd:appinfo>Type: DefinitionCreationType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalDataType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The type of data in the external system. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the object in the external system. This is different from the developer name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fieldFormula" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Used for formulas.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDataRequired" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, data is required. Default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isEventDate" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, an event date is required. Default value is false. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isFormula" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, a formula is required. Default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isRecordModified" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, the system tracks the modification date of the record. Default value is false. Available in API version 63.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="keyQualifierName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Contains the developer name of the keyQualifier field. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="length" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Length of a string column.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Field label.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="precision" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The total number of digits in a number including decimal points. Used for currency and for numeric accuracy.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="primaryIndexOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>If supplied, indicates that this field is part of the primary key. The number value indicates the order of attributes if it’s a compound primary key. A missing value means that this field isn’t part of the primary key.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="scale" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The number of digits to the right of the decimal point. Used for currency and for numeric accuracy.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sequence" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The sequence of this source schema.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="srcKeyQualifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Contains a reference to the source key qualifier record. The source key is the MktDataLakeSrcKeyQualifer metadata type. Available in API version 55.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="usageTag" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Indicates if the field is a key qualifier field. Available in API version 55.0 and later.Values are: KEY_QUALIFIER—The field is used as a key qualifier field. NONE—The field isn’t used as a key qualifier field.</xsd:documentation>
       <xsd:appinfo>Type: usageTag (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="versionNumber" minOccurs="0" maxOccurs="unbounded" type="xsd:double">
      <xsd:annotation>
       <xsd:documentation>Required. The version of the data source object.</xsd:documentation>
       <xsd:appinfo>Type: double</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataSourceTenant">
  <xsd:annotation>
   <xsd:documentation>For internal use only.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datasourcetenant.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataSrcDataModelFieldMap">
  <xsd:annotation>
   <xsd:documentation>Represents the mappings between source data lake object (DLO) fields and target data model object (DMO) fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datasrcdatamodelfieldmap.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="filterApplied" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a filter is applied to a DLO-to-DMO field mapping (true) or not (false). This field corresponds to whether a DLO filter is applied in the Data Spaces tab in the UI. Available in API version 60.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="filterOperationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required when filterApplied is true. The comparison operator used when filtering the DLO-to-DMO field mapping. This field corresponds to the operation type of a DLO filter applied in the Data Spaces tab in the UI. Available in API version 60.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="filterValue" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required when filterApplied is true. The value used for filtering the DLO-to-DMO field mapping. This field corresponds to the value of a DLO filter applied in the Data Spaces tab in the UI. Available in API version 60.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for DataSrcDataModelFieldMap, which is defined when the DataSrcDataModelFieldMap is created.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The developer name of the DLO field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The developer name of the DMO field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="templateVersion" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The version number of the field mapping template. Available in API version 61.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="versionNumber" minOccurs="0" maxOccurs="unbounded" type="xsd:double">
      <xsd:annotation>
       <xsd:documentation>Required. The version number of the DataSrcDataModelFieldMap.</xsd:documentation>
       <xsd:appinfo>Type: double</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="DataStreamTemplate">
  <xsd:annotation>
   <xsd:documentation>Represents the data stream that a user adds to a data kit.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_datastreamtemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="dataConnectionSourceParameters" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Input representation for the data connection source parameters.</xsd:documentation>
       <xsd:appinfo>Type: DataConnectionParamTmpl[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataSourceBundleDefinition" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the bundle to which this template belongs.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataSourceObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to the Data Source Objects (DSOs). A DSO represents the object from where the data was sourced.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="filterCriteria" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Filter applied to the data stream before the information is sent to Data Cloud.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="fullRefreshIntervalDays" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The interval when Data 360 performs a full refresh of the data stream. Available in API version 67.0 and later. Possible values are: NONE DAYS_10 DAYS_25 DAYS_50</xsd:documentation>
       <xsd:appinfo>Type: FullRefreshIntervalDays (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name assigned to the data stream template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="objectCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Category of the Data Model Object (DMO).</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshDayOfMonth" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The duration of the day of the month after which the data stream must be refreshed.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshDayOfWeek" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The duration of the day of the week after which the data stream must be refreshed.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshFrequency" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The frequency with which the datastream must be refreshed. Possible values are: Batch NONE MINUTES_15 MINUTES_30 MINUTES_5 HOURLY DAILY WEEKLY MONTHLY NOT_APPLICABLE STREAMING Possible values available in API version 64.0 and later are: EVERY_12_HOURS EVERY_4_HOURS</xsd:documentation>
       <xsd:appinfo>Type: DataImportRefreshFrequency (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshHours" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The duration after which the datastream must be refreshed.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshMode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The mode of refresh. Possible values are: FULL_REFRESH UPSERT INCREMENTAL REPLACE NEAR_REAL_TIME_INCREMENTAL NOT_APPLICABLE PARTIAL_UPDATE STREAMING</xsd:documentation>
       <xsd:appinfo>Type: DataImportRefreshMode (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="refreshStartDate" minOccurs="0" maxOccurs="unbounded" type="xsd:date">
      <xsd:annotation>
       <xsd:documentation>The date to retrieve data based on the refresh frequency data. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: date</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceObjectName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the source object from which data is streamed. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="streamType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The type of data stream. Available in API version 62.0 and later. Possible values are: DIRECT_ACCESS DIRECT_ACCESS_ACCELERATED INGEST</xsd:documentation>
       <xsd:appinfo>Type: StreamType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="streamingAppDataConnectorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The connector app for data streaming. Available in API version 63.0 and later. Possible values are: MobileApp WebApp</xsd:documentation>
       <xsd:appinfo>Type: streamingAppDataConnectorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="templateVersion" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The version number of the template. Available in API version 62.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ExternalDataConnector">
  <xsd:annotation>
   <xsd:documentation>Used to represent the object where the data was sourced.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_externaldataconnector.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="dataConnectionStatus" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Indicates whether you’re connected to a data source. Valid values are: Connected Disconnected Failed</xsd:documentation>
       <xsd:appinfo>Type: DataConnectionStatus (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataConnectorConfiguration" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reference to the Data Connector Configuration that is used to retrieve or receive data such as DataConnectorS3.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataConnectorType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Type of connection such as AmazonS3. Valid values are: ACCOUNTENGAGEMENT AmazonS3 CuratedEntity DataCloud ExternalPlatform GoogleCloudStorage IngestApi SalesforceCommerceCloud SalesforceDotCom SalesforceInteractionStudio SalesforceMarketingCloud SFTP StreamingApp UPLOAD</xsd:documentation>
       <xsd:appinfo>Type: DataConnectorType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataPlatform" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reference to the Data Platform that provides or uses this data, such as Amazon_S3.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalDataTranObjects" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Stores the schema objects related to the data connector. Available in API version 56.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: ExternalDataTranObject</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The UI name for the ExternalDataConnector.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ExternalDataSource">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with an external data source. Create external data sources to manage connection details for integration with data and content that are stored outside your Salesforce org. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_externaldatasource.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="authProvider" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The authentication provider represented by the AuthProvider component.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="certificate" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If you specify a certificate, your Salesforce org supplies it when establishing each two-way SSL connection with the external system. The certificate is used for digital signatures, which verify that requests are coming from your Salesforce org.For best performance, verify that your remote HTTPS encrypted sites have OCSP (Online Certificate Status Protocol) stapling turned on.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customConfiguration" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A string of configuration parameters that are specific to the external data source’s type. customConfiguration for Salesforce Connect—Cross-Org Adapter customConfiguration for Salesforce Connect—OData 2.0 or 4.0 Adapter customConfiguration for Salesforce Connect—Custom Adapter</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="customHttpHeaders" minOccurs="0" maxOccurs="unbounded" type="CustomHttpHeaders">
      <xsd:annotation>
       <xsd:documentation>Represents custom HTTP headers used with OData 2.0 or OData 4.0 connectors. Available in API version 43.0 or later.</xsd:documentation>
       <xsd:appinfo>Type: CustomHttpHeaders[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="endpoint" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The URL of the external system, or if that URL is defined in a named credential, the named credential URL. Corresponds to the URL in the user interface.A named credential URL contains the scheme callout:, the name of the named credential, and an optional path. For example: callout:My_Named_Credential/some_path. You can append a query string to a named credential URL. Use a question mark (?) as the separator between the named credential URL and the query string. For example: callout:My_Named_Credential/some_path?format=json.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalDataSrcDescriptors" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Represents schema descriptors for an external data source used with the Salesforce Connect adapter for Amazon DynamoDB (available in API version 55.0 or later) or Amazon Athena (available in API version 56.0 or later).</xsd:documentation>
       <xsd:appinfo>Type: ExternalDataSrcDescriptors[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isWritable" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Allows the Lightning Platform and users in this org to create, update, and delete records for external objects associated with the external data source. The external object data is stored outside the org. By default, external objects are read-only. Corresponds to Writable External Objects in the user interface. Available in API version 35.0 and later. However, with the cross-org adapter for Salesforce Connect, you can set this field to true only in API version 39.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A name for the external data source. The label is displayed in the Salesforce user interface, such as in list views.Examples include Acme Team Marketing Site or Acme SharePoint.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="namedCredential" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the definition of the referenced named credential for an external data source of the type Amazon DynamoDB or Amazon Athena.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="oauthRefreshToken" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The OAuth refresh token. Used to obtain a new access token for an end user when a token expires.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="oauthScope" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the scope of permissions to request for the access token. Corresponds to the Scope in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="oauthToken" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The access token issued by the external system.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="password" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The password your org uses to access the external system. Make sure that the credentials you use have adequate privileges to access the external system, perform searches, return data, and return information about the external system’s metadata.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="principalType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Determines whether you&apos;re using one set or multiple sets of credentials to access the external system. Corresponds to Identity Type in the user interface. The valid values are: Anonymous NamedCustomPrincipal NamedUser PerUser</xsd:documentation>
       <xsd:appinfo>Type: ExternalPrincipalType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="protocol" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The authentication protocol that’s required to access the external system. The valid values are: NoAuthentication Oauth Password For cloud-based Files Connect external systems, select Oauth 2.0. For on-premises systems, select Password Authentication. For Simple URL data sources, select No Authentication.</xsd:documentation>
       <xsd:appinfo>Type: AuthenticationProtocol (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="repository" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Used for SharePoint Online. If metadata isn&apos;t accessible, use this field to create tables and default table fields.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. For Salesforce Connect, specifies the adapter that connects to the external system. The valid values are: AmazonAthena—Amazon Athena AmazonDynamoDB—Amazon DynamoDB OData—OData 2.0 adapter OData4—OData 4.0 adapter SfdcOrg—cross-org adapter ApexClassId—DataSource.Provider class that defines the custom adapter created via the Apex Connector Framework For Files Connect, specifies the data source type. The valid values are: ContentHubSharepoint—SharePoint 2010 or 2013 ContentHubSharepointOffice365—SharePoint Online ContentHubSharepointOneDrive—OneDrive for Business ContentHubGDrive—Google Drive ContenHubIsotope—Isotope If Chatter is enabled, you can also specify SimpleURL to access data hosted on a web server that doesn’t require authentication. outgoingemail—A data source used for sending an email through a quick action. For Digital Lending Configurator, the valid value is: AFPPAttribute—The data source name for the Application Form Product Proposal Attribute virtual object. For the federated search external data source type, the valid value is: OpenSearch For Transaction Management in Revenue Cloud, the valid values are: ASPAttribute—The data source name for the Asset State Period Attribute virtual object. Available in API version 63.0 and later. OIAttribute—The data source name for the Order Item Attribute virtual object. Available in API version 63.0 and later. QLIAttribute—The data source name for the Quote Line Item Attribute virtual object. Available in API version 63.0 and later. For SalesAgreement in Manufacturing Cloud, the valid values are: SAPAttribute—The data source name for the SalesAgreement Product Attribute virtual object. Available in API version 60.0 and later. These values are reserved for internal use: AssetAttribute ClaimAttributeDS ClaimItemAttributeDS CryptoTrEnvChgLogSnp CtrtGrpPlnAttr CtrtGrpPlnGrpClsAttr FAAttribute FLAttribute IAItemProdtAttr Identity InsPolicyAttribute IPAAttribute IPCAttribute IPCvrBnftAttribute IPPAttribute SdbOvenPODataSource Wrapper</xsd:documentation>
       <xsd:appinfo>Type: ExternalDataSourceType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="username" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The user name that your org uses to access the external system. Make sure that the credentials you use have adequate privileges to access the external system, perform searches, return data, and return information about the external system’s metadata.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="version" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Reserved for future use.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ExternalDataSrcDescriptors_for_Salesforce_Connect_Adapter_for_Amazon_DynamoDB_and_for_Amazon_Athena">
  <xsd:annotation>
   <xsd:documentation>Represents schema descriptors for an external data source used with the Salesforce Connect adapter. The schema descriptors are for Amazon DynamoDB (available in API version 55.0 or later) or Amazon Athena (available in API version 56.0 or later).</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_externaldatasource.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="customObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If set, the external object associated with the descriptor.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="descriptor" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The descriptor document that contains the metadata information.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="descriptorVersion" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If the external system supports schema versioning for the data source, the optional descriptor document version tracks the external system&apos;s schema version. Several descriptors with different document versions can be active.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The unique name of the child-level setup entity.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalDataSource" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the external data source associated with the descriptor.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="subtype" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The subtype of the descriptor.Values are: SchemaTableMetadata— Used to cache information about the external system. SchemaTableQualifiers— Used to customize the data retrieval query to the external system.</xsd:documentation>
       <xsd:appinfo>Type: ExternalDataSrcDescSubtype (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="systemVersion" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The version that defines the descriptor format and provides compatibility with descriptor formats between Salesforce releases.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of the descriptor.Valid value: Schema</xsd:documentation>
       <xsd:appinfo>Type: ExternalDataSrcDescType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ExternalDataTransportFieldTemplate">
  <xsd:annotation>
   <xsd:documentation>For internal use only.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_externaldatatransportfieldtemplate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="FieldSourceTargetMap">
  <xsd:annotation>
   <xsd:documentation>Contains the field-level mappings between the source and the target objects.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_objectsourcetargetmap.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="creationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Describes whether this object was added by the user or as part of a standard taxonomy. Values are: ADG Activation_Audience Bridge Calculated_Insight Chunk Curated Custom Derived Directory_Table External Ml_Prediction Segment_Membership Semantic Standard System Transform Vector_Embedding Valid values available in API version 67.0 and later are: Ad_Audience_Insights Auxiliary Clean_Room Deletion_Records Problem_Records</xsd:documentation>
       <xsd:appinfo>Type: DefinitionCreationType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="filterApplied" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Specifies whether the field-level mapping is an event type filter (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="filterOperationType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If the field-level mapping is an event type filter, specifies the filtering operator.Value is: Equal</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="filterValue" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>If the field-level mapping is an event type filter, specifies the object that contains the event type field.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isSourceFormula" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Specifies whether the source field is a formula (true) or not (false). If true, you must include the sourceFormula value.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The source object field that’s mapped, such as EmailAddr or SfmcEnt1_Subscriber.FName.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceFormula" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A formula, such as concatenation, date function, or constant value.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The target object field that’s mapped, such as SfmcEnt1_Email.EmailAddr or Individual.FirstName.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
