       <xsd:documentation>The internal name of the application.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="dataflow" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
