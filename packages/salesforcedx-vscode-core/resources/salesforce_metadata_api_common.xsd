 <xsd:complexType name="CMSConnectResourceDefinition">
  <xsd:annotation>
   <xsd:documentation>cmsConnectResourceDefinition is used to define JSON connections.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cmsconnectsource.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. API name of CMSConnectResourceDefinition.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. developerName of Content Item or Content List.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="options" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Identifies whether the content from the external source is a single item or a list.0 for Content List 1 for Content Item</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="payloadType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The only valid value is JSON.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="resourceIdPath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Relative path to ID. Required for Content Item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="resourceNamePath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Relative path to resource name. Required for Content Item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="resourcePath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. JSON resource path.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rootNodePath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Only for Content List and collection. Defines the initial starting path for a collection or list.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CMSConnectResourceType">
  <xsd:annotation>
   <xsd:documentation>CMSConnectResourceType is for use only to define JSON connections.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cmsconnectsource.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="cmsConnectResourceDefinition" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>0–10 allowed per CMSConnectResourceType.</xsd:documentation>
       <xsd:appinfo>Type: cmsConnectResourceDefinition[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API name of CMSConnectResourceType.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Content type name.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="resourceType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The only allowed value is JSON.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CMSConnectSource">
  <xsd:annotation>
   <xsd:documentation>Represents the connection information for external content management systems that feed content to Experience Builder sites. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cmsconnectsource.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="cmsConnectAsset" minOccurs="0" maxOccurs="unbounded" type="CMSConnectAsset">
      <xsd:annotation>
       <xsd:documentation>Represents CSS or JavaScript defined for the connection. 0–10 for CSS 0–10 for JavaScript</xsd:documentation>
       <xsd:appinfo>Type: CMSConnectAsset[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="cmsConnectLanguage" minOccurs="0" maxOccurs="unbounded" type="CMSConnectLanguage">
      <xsd:annotation>
       <xsd:documentation>0 to more. Represents language mappings defined for the connection.</xsd:documentation>
       <xsd:appinfo>Type: CMSConnectLanguage[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="cmsConnectPersonalization" minOccurs="0" maxOccurs="unbounded" type="CMSConnectPersonalization">
      <xsd:annotation>
       <xsd:documentation>0 or 1. Represents personalization defined for the connection. Only for use when type is AEM.</xsd:documentation>
       <xsd:appinfo>Type: CMSConnectPersonalization[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="cmsConnectResourceType" minOccurs="0" maxOccurs="unbounded" type="CMSConnectResourceType">
      <xsd:annotation>
       <xsd:documentation>0–5. Represents JSON definitions defined for the connection.</xsd:documentation>
       <xsd:appinfo>Type: CMSConnectResourceType[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="connectionType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Type of authentication being used with outside system. Valid values are: Public Authenticated</xsd:documentation>
       <xsd:appinfo>Type: CMSSourceConnectionType(enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="cssScope" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The class name used to prefix and scope the CSS rules.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. API name of the CMSConnectSource entity.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="languageEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Valid values are: Y to enable language mapping for connection. N if no language mapping is needed.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Connection name</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="namedCredential" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required when the connectionType is Authenticated. API name of namedCredential. Before deploying namedCredential, it must exist on the destination org.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="personalizationEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Valid values are: Y to enable personalization mapping for connection. Otherwise N.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="rootPath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Root path.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sortOrder" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. Defines the load order of the connection when multiple connections defined on page. The load order begins with 1.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="status" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Status of connection. Valid values are: ACTIVE INACTIVE</xsd:documentation>
       <xsd:appinfo>Type: CMSConnectionStatus(enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The identification of the source connection system. Valid values are: AEM Drupal WordPress SDL Sitecore Other</xsd:documentation>
       <xsd:appinfo>Type: CMSConnectionSourceType(enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="websiteUrl" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required if connectionType is Public</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CallCenter">
  <xsd:annotation>
   <xsd:documentation>Represents the Call Center definition used to integrate Salesforce with a third-party computer-telephony integration (CTI) system, a partner telephony system, or partner Contact Center as a Service (CCaaS) system.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_callcenter.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="adapterUrl" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Optional field. A URL that points to an adapter.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="contactCenterChannels" minOccurs="0" maxOccurs="unbounded" type="ContactCenterChannel">
      <xsd:annotation>
       <xsd:documentation>Relates Bring Your Own Channel for Contact Center as a Service (CCaaS) messaging channels to a CallCenter and represents the routing details for a voicemail configuration.</xsd:documentation>
       <xsd:appinfo>Type: ContactCenterChannel[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The display name of this call center.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="displayNameLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label of the displayName field in Call Center setup page.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="internalNameLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label of the internalName field in Call Center setup page.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sections" minOccurs="0" maxOccurs="unbounded" type="CallCenterSection">
      <xsd:annotation>
       <xsd:documentation>Custom setup items defined for this call center.</xsd:documentation>
       <xsd:appinfo>Type: CallCenterSection[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="version" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The version of this call center.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CallCenterItem">
  <xsd:annotation>
   <xsd:documentation>Required.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_callcenter.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label of the custom setup item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the custom setup item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The value of the custom setup item.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CallCenterRoutingMap">
  <xsd:annotation>
   <xsd:documentation>Represents the mapping between a user or queue in a Salesforce org to a user or queue in an external system’s call center.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_callcenterroutingmap.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="callCenter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Reference to a call center.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="developerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The developer name is a combination of the Salesforce user ID or queue name, and the callCenter value, with an underscore between these two values. [SALESFORCE_USER_ID]_[CALL_CENTER] [SALESFORCE_QUEUE_NAME]_[CALL_CENTER]</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalId" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Unique identifier for the external system’s user or queue.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The master label of the CallCenterRoutingMap.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="quickConnect" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The Amazon Connect QuickConnectId ARN used to determine agent availability for Omni-Channel call transfers. Available in API version 56.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="referenceRecord" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Lookup field to a Salesforce user or queue.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CallCenterSection">
  <xsd:annotation>
   <xsd:documentation>Required.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_callcenter.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="items" minOccurs="0" maxOccurs="unbounded" type="CallCenterItem">
      <xsd:annotation>
       <xsd:documentation>Contains the label, name, and value that describe the sections.</xsd:documentation>
       <xsd:appinfo>Type: CallCenterItem[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label of the section.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the section.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CallCoachingMediaProvider">
  <xsd:annotation>
   <xsd:documentation>Represents the CallCoachingMediaProvider configuration. Use CallCoachingMediaProvider to configure which providers of voice recordings that Einstein Conversation Insights can use. For example, Sales Dialer can provide voice recordings. Einstein Conversation Insights then stores and analyzes call recordings to surface insights and trends in customer conversations.This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_callcoachingmediaprovider.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the media provider can upload voice recordings (true) or not (false). Default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="providerDescription" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Description of the media provider.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="providerName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Name of the media provider.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CampaignCriteriaBasedSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a criteria-based sharing rule for campaigns. It extends the CriteriaBasedSharingRule metadata type and inherits its criteriaItems field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cbsrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="CriteriaBasedSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the filter logic of the sharing rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters. This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="campaignAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a target group is granted for a campaign. The possible values are: Read Edit All</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoNone (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CampaignInfluenceModel">
  <xsd:annotation>
   <xsd:documentation>Represents a campaign influence model used by Customizable Campaign Influence. You can’t configure Customizable Campaign Influence via the Metadata API, but you can add a campaign influence model. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_campaigninfluencemodel.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the model is active. Active models can generate campaign influence records. Deactivating a model deletes its campaign influence records. Custom models are always active and this field is ignored. This field is available beginning with API version 40.0.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDefaultModel" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates if the model is the default model or not. Only campaign influence records associated with the default model appear on campaigns and opportunities. You can only have one default model at a time. A model must be active to become the default model.Activating or deactivating custom models does not automatically generate or delete campaign influence records.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isModelLocked" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates if the model is locked or not. Campaign Influence records for locked models can be manipulated only via the API.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="modelDescription" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the influence model.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A unique name for the model.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recordPreference" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The value of this field determines when to create campaign influence records. AllRecords: Creates records regardless of the revenue attribution percentage. RecordsWithAttribution: Creates records only when the revenue attribution is greater than 0%. This field is available In API version 41.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: picklist</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CampaignOwnerSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a sharing rule for a campaign with users other than the owner. It extends the OwnerSharingRule metadata type and inherits its fullName, sharedFrom, and sharedTo fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_ownersharingrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="OwnerSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="campaignAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A value that represents the level of access that a group or role is granted for a campaign. The possible values are: Read Edit All</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelNoNone (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters.This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CampaignSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s Campaign Influence, Einstein Attribution, Einstein Key Accounts, and campaign member settings. These features help you understand how your campaigns and accounts are affecting your opportunity pipeline. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_campaignsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aiAttributionTimeframe" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Indicates the number of months between the opportunity creation date and an engagement activity, during which Einstein scans for influential campaigns. The value must be a multiple of three, up to 24. Available in API version 49.0 and later.This field supports Einstein Attribution.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAIAttribution" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Einstein Attribution feature is enabled (true) or not (false). The default value is false. Available in API version 49.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAccountsAsCM" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether accounts can be used as campaign members (true) or not (false). The default value is false. Available in API version 51.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAutoCampInfluenceDisabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Salesforce creates Campaign Influence information (true) or not (false). enableCampaignInfluence2 must be false to use this setting.The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableB2bmaCampaignInfluence2" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether your org can access campaign influence models from other systems, such as Pardot (true) or not (false). enableCampaignInfluence2 must be true to use this setting.The default value is false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCampaignHistoryTrackEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>This read-only field is reserved for system use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCampaignInfluence2" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Customizable Campaign Influence is enabled (true) or not (false). When true, Campaign Influence 1.0 is hidden from users and is no longer active. The default value is true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCampaignMemberTWCF" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>This read-only field is reserved for system use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEKAI" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Einstein Key Accounts Identification is enabled (true) or not (false). The default value is false. Available in API version 53.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableOpportunityInfluence" minOccurs="0" maxOccurs="unbounded" type="xsd:anyType">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Opportunity Influence campaign attribution is enabled (true) or not (false). When enabled, Opportunity Influence connects opportunity revenue to specific campaigns. The default value is false. Available with Marketing Cloud Growth and Advanced editions in API version 63.0 and higher.</xsd:documentation>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSuppressNoValueCI2" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>This read-only field is reserved for system use.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CampaignSharingRules">
  <xsd:annotation>
   <xsd:documentation>Represents the sharing rules for campaigns. It extends the SharingRules metadata type and inherits its fullName field. Only available in API version 32.0 and earlier.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="SharingRules">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="criteriaBasedRules" minOccurs="0" maxOccurs="unbounded" type="CampaignCriteriaBasedSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user criteria-based rules.</xsd:documentation>
       <xsd:appinfo>Type: CampaignCriteriaBasedSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ownerRules" minOccurs="0" maxOccurs="unbounded" type="CampaignOwnerSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user membership-based rules.</xsd:documentation>
       <xsd:appinfo>Type: CampaignOwnerSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Capabilities">
  <xsd:annotation>
   <xsd:documentation>Represents a list of capabilities. A capability is something that a component can do, as opposed to a target, which defines where you can use a component. Available in API version 48.0 and later. For more information, see XML Configuration File Elements.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_lightningcomponentbundle.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="capability" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies something that a component can do. Valid values are: lightningCommunity__RelaxedCSP lightning__dynamicComponent lightning__ServerRenderable lightning__ServerRenderableWithHydration lightning__ServiceCloudVoiceToolkitApi</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CareBenefitVerifySettings">
  <xsd:annotation>
   <xsd:documentation>Represents the configuration settings for benefit verification requests.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_carebenefitverifysettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="codeSetType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the code set type for the benefits verification service type codes.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultNpi" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Default National Provider Identifier to be used in the benefits verification request.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="generalPlanServiceTypeCode" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Service type code for the plan benefits as a whole.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDefault" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this record is the default verification service (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the benefits verification service.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="organizationName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the organization name for the benefits verification request service.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="serviceApexClass" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Apex class used to access the benefits verification service.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="serviceNamedCredential" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Credential used to access the benefits verification service.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="serviceTypeSourceSystem" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Service type code for the plan benefits as a whole.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="uriPath" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Link to payer endpoint.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CareLimitType">
  <xsd:annotation>
   <xsd:documentation>Defines the characteristics of limits on benefit provision.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_carelimittype.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t impact the behavior of the metadata type.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="limitType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Source of limit on benefit provision, such as a co-insurance requirement.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the limit type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="metricType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Metric to be used for calculating and displaying the benefit limit, such as number of visits, amount spent, or percentage of allowed expenditure.Valid values are: Amount Money Percentage Text</xsd:documentation>
       <xsd:appinfo>Type: CareLimitTypeMetricType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CareProviderSearchConfig">
  <xsd:annotation>
   <xsd:documentation>Represents the information about the fields that appear in care provider search results. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_careprovidersearchconfig.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this configuration is active (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t currently impact the behavior of the metadata type.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="mappedObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates mapped objects.Possible values are; HealthCarePractitionerFacility HealthCareProvider</xsd:documentation>
       <xsd:appinfo>Type: ProviderSearchObjectMapping (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the care provider.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API name of the field that is copied to the target object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>API name of the field to copy the data to.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CareRequestConfiguration">
  <xsd:annotation>
   <xsd:documentation>Represents the details for a record type such as service request, drug request, or admission request. One or more record types can be associated with a care request.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_carerequestconfiguration.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="careRequestRecordType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The record type for the care request.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="careRequestRecords" minOccurs="0" maxOccurs="unbounded" type="CareRequestRecords">
      <xsd:annotation>
       <xsd:documentation>The list of objects you can select to configure the care request.</xsd:documentation>
       <xsd:appinfo>Type: CareRequestRecords[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="careRequestType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The type of care request. For example, an appeal, a service request, or an admission.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the care request is active (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CareRequestRecords">
  <xsd:annotation>
   <xsd:documentation>Displays a list of objects to customize the care request.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_carerequestconfiguration.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="careRequestRecord" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The object selected to configure the care request.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CareSystemFieldMapping">
  <xsd:annotation>
   <xsd:documentation>Represents a mapping from source system fields to Salesforce objects and fields. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_caresystemfieldmapping.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="externalIdField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the field in the external system.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isActive" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this field mapping is active (true) or not (false). The default value is False.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value that doesn’t currently impact the behavior of the metadata type.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of the care system field mapping.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="role" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The role the field represents. Valid values are: Patient—When the role field is set to Patient, the Enrollment API uses the value of externalIdField as the patient ID. This role can be used when targetObject is set to Account. RemoteMonitoringDevice—Indicates which externalIdField on the Asset object maps to the Device field in the CareObservation object. This role can be used when targetObject is set to Asset. RemoteMonitoringPatient—Indicates which externalIdField on the Account object maps to the ObservedSubject field in the Care Observation object. This role is used when targetObject is set to Account. ServiceProvider—The Enrollment API uses the value of externalIdField as the provider ID. This role is used when targetObject is set to Account. NotApplicable—This role is used when targetObject is set to CareProgram or Product, which means that there is no applicable role.</xsd:documentation>
       <xsd:appinfo>Type: SourceSystemFieldRole (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sourceSystem" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The system where the record originated.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="targetObject" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the Salesforce object to which the external system field is mapped.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CaseCriteriaBasedSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a criteria-based sharing rule for cases. It extends the CriteriaBasedSharingRule metadata type and inherits its criteriaItems field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_cbsrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="CriteriaBasedSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="booleanFilter" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the filter logic of the sharing rule.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters.This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access being granted for a case. The possible values are: Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelReadEdit (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CaseOwnerSharingRule">
  <xsd:annotation>
   <xsd:documentation>Represents a sharing rule for a case with users other than the owner. It extends the OwnerSharingRule metadata type and inherits its fullName, sharedFrom, and sharedTo fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_ownersharingrule.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="OwnerSharingRule">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="caseAccessLevel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A value that represents the level of access that a group or role is granted for a case. The possible values are: Read Edit</xsd:documentation>
       <xsd:appinfo>Type: ShareAccessLevelReadEdit (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Represents the description of the sharing rule. Maximum of 1000 characters.This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name for the sharing rule. Corresponds to Label in the user interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CaseSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an organization’s case settings, such as the default case owner, which case-related features are enabled, and which Classic email templates are used for various case activities. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_casesettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="caseAssignNotificationTemplate" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the email template used for case assignment notifications. The format must be folderName/emailTemplateName.Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseAutoProcUser" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to create an automated response record after a customer’s initial email (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseCloseNotificationTemplate" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the email template used for case close notifications. The format must be folderName/emailTemplateName. Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseCommentNotificationTemplate" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the email template used for case comment notifications. The format must be folderName/emailTemplateName. Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseCreateNotificationTemplate" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the email template used for case create notifications. The format must be folderName/emailTemplateName. Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseFeedItemSettings" minOccurs="0" maxOccurs="unbounded" type="FeedItemSettings">
      <xsd:annotation>
       <xsd:documentation>Specifies the settings for feed items in feed-based case page layouts. This field is available in API version 32.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: FeedItemSettings[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseFeedReadUnreadLtng" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether unread feed items are shown in bold in Lightning Experience (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="caseMergeInLightning" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Case Merge is enabled in Lightning Experience (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="closeCaseThroughStatusChange" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Closed is included in the Case Status field on case edit pages (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultCaseFeedLayoutOn" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the default Case Feed layout is used in the org (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultCaseOwner" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the default owner of a case when assignment rules fail to locate an owner.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultCaseOwnerType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies whether the default case owner is a user or a queue.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="defaultCaseUser" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the user listed in the Case History related list for automated case changes from: Assignment rules Escalation rules On-Demand Email-to-Case Cases logged in the Self-Service portal Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="emailActionDefaultsHandlerClass" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Use this Apex class name to provide default values for the email action.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="emailToCase" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The organization&apos;s Email-to-Case settings.</xsd:documentation>
       <xsd:appinfo>Type: EmailToCaseSettings</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCaseFeed" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Case Feed is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCollapseEmailThread" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether earlier messages in an email thread are removed from email feed items (true) or not (false). Available in API version 47.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableDraftEmails" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether draft emails are enabled (true) or not (false). Enabling email drafts requires that Case Feed and Email-to-Case are also enabled.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEarlyEscalationRuleTriggers" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether early triggers on escalation rules are enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEmailActionDefaultsHandler" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Email Action Default Handler setting is enabled (true) or not (false). Use this setting to select an Apex class to load a default template or to specify the default target fields for the email action.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEmailContactOnCasePost" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, the case contact is notified by email when someone makes an externally visible post on a case in an Experience Builder site.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEscalateQfiToCaseInternal" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, moderators can create cases from Question feed items in Chatter in your organization.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEscalateQfiToCaseNetworks" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, moderators can create cases from Question feed items in Chatter in all Experience Builder sites where Chatter Questions is enabled.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableExtNetworksCaseFeedEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, site members can see case-related emails, comments, and updates in the case feed.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMultiLangSolnSrchCSS" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether multilingual searching for Solutions in self-service portals is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMultiLangSolnSrchPKB" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether multilingual searching for public Solutions is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableMultiLangSolution" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether multilingual Solutions are enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableNewEmailDefaultTemplate" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether default email templates are enabled (true) or not (false). Default email templates are available only if draft emails are enabled.Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSolutionCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether browsing for Solutions is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSolutionInlineCategory" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether using inline Solutions category breadcrumbs is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSolutionShortSummary" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Solutions summaries are enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSuggestedArticlesApplication" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Suggested Articles list appears on case pages. (true) or not (false). Is only valid if enableSuggestedSolutions=false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSuggestedArticlesCustomerPortal" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Suggested Articles list appears on customer portal pages (true) or not (false). Is only valid if enableSuggestedSolutions=false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSuggestedArticlesPartnerPortal" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Suggested Articles list appears on partner portal pages (true) or not (false). Is only valid if enableSuggestedSolutions=false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableSuggestedSolutions" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the View Suggested Solutions or Find Articles button appears on case detail pages (true) or not (false). Is only valid if enableSuggestedArticlesApplication, enableSuggestedArticlesCustomerPortal, and enableSuggestedArticlesPartnerPortal=false.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="escalateCaseBefore" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether early triggers are enabled to escalate a case (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="genericMessageEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether generic messages are enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="keepCaseMergeRecords" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>If true, duplicate cases aren’t deleted after a case merge.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="keepRecordTypeOnAssignmentRule" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>When applying assignment rules to manually created records, indicates whether to keep the existing record type (true) or to override the existing record type with the assignee’s default record type (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="newEmailDefaultTemplateClass" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the Apex class that defines the default email template for new email messages in Case Feed. This field appears only when enableNewEmailDefaultTemplate=true.Lightning email templates aren’t packageable. We recommend using a Classic email template.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notifyContactOnCaseComment" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether contacts who aren’t members of your Self-Service portal can be notified when a new comment is added to a case (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notifyDefaultCaseOwner" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the default case owner is notified when assigned a new case (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notifyOwnerOnCaseComment" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the case owner is notified when a comment is added to a case (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="notifyOwnerOnCaseOwnerChange" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Send Notification Email checkbox on cases is automatically selected when users change a case owner to another user (true).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="predictiveSupportEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether predictive support is enabled (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showEmailAttachmentsInCaseAttachmentsRL" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the case Attachments related list shows email attachments. If true, the page displays an email icon next to each attachment from an email in the Attachments related list for cases. The related list’s list view also includes a Source column that identifies the attachment’s origin. If false, email attachments aren’t displayed in the Attachments related list for cases.This field is available in API version 40.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showFewerCloseActions" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Save &amp; Close button on case edit pages and the Cls link on Cases related lists are hidden (true) or shown (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="systemUserEmail" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies the email address used when the default case user is the system user.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="useSystemEmailAddress" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whom case comment, case attachment, and case assignment email notifications appear to be sent from. Use true to show notifications as sent from a system address. Use false to show notifications as sent from the user or contact who is updating the case.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="useSystemUserAsDefaultCaseUser" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the system user is used as the automated case user (true) or not (false). If false, then you must specify a value for the defaultCaseUser field.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="visibleInCssCheckbox" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Sets the default visibility of a case as indicated by the Visible in CSS option on the case edit page. If false, the case is visible in CSS by default. If true, CSS visibility is off.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="webToCase" minOccurs="0" maxOccurs="unbounded" type="WebToCaseSettings">
      <xsd:annotation>
       <xsd:documentation>The organization&apos;s Web-to-Case settings.</xsd:documentation>
       <xsd:appinfo>Type: WebToCaseSettings</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CaseSharingRules">
  <xsd:annotation>
   <xsd:documentation>Represents the sharing rules for cases. It extends the SharingRules metadata type and inherits its fullName field. Only available in API version 32.0 and earlier.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_sharingrules.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="SharingRules">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="criteriaBasedRules" minOccurs="0" maxOccurs="unbounded" type="CaseCriteriaBasedSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user criteria-based rules.</xsd:documentation>
       <xsd:appinfo>Type: CaseCriteriaBasedSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="ownerRules" minOccurs="0" maxOccurs="unbounded" type="CaseOwnerSharingRule">
      <xsd:annotation>
       <xsd:documentation>List that defines user membership-based rules.</xsd:documentation>
       <xsd:appinfo>Type: CaseOwnerSharingRule[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CaseSubjectParticle">
  <xsd:annotation>
   <xsd:documentation>Represents the Social Business Rules custom format for the Case Subject field on cases created from inbound social posts.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_casesubjectparticle.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="index" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The order in which the custom Case Subject is generated, meaning if the social network is 0 and the social message is 1, then the subject generates as Twitter | Tweet.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="textField" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Specifies inbound social content added to Case Subject in case records.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the custom Case Subject format from which inbound social content appears in case records. Valid values are: ProvidedString Source MessageType SocialHandle SocialNetwork Sentiment RealName Content PipeSeparator ColonSeparator HyphenSeparator</xsd:documentation>
       <xsd:appinfo>Type: CaseSubjectParticleType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CatalogedApi">
  <xsd:annotation>
   <xsd:documentation>Represents an API brought into API Catalog for Salesforce from an external source.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_catalogedapi.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The description defined when the API is cataloged.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="descriptor" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The content of the API schema in JSON format.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalSourceIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the API in the external source that it&apos;s imported from.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="instances" minOccurs="0" maxOccurs="unbounded" type="CatalogedApiInstance">
      <xsd:annotation>
       <xsd:documentation>Reference to the cataloged API that this instance is specific to.</xsd:documentation>
       <xsd:appinfo>Type: CatalogedApiInstance[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API name as it appears in API Catalog.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="providerType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates the source of the API specification registered with API Catalog.API Catalog supports the value Anypoint for deployment and supports other values for enumeration. See information about the values in the registrationProviderType field.</xsd:documentation>
       <xsd:appinfo>Type: ExternalServiceRegistrationProviderType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the API type. If not specified, the API type is derived based on the descriptor content. Nillable. Values are: GraphQL gRPC REST</xsd:documentation>
       <xsd:appinfo>Type: APIType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CatalogedApiArtifactVersionInfo">
  <xsd:annotation>
   <xsd:documentation>Represents API version information in API Catalog that’s referenced by other entities.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_catalogedapiartifactversioninfo.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="releaseNotes" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The API release notes.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="revision" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The API revision.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API type.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="version" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API version.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CatalogedApiInstance">
  <xsd:annotation>
   <xsd:documentation>Represents a MuleSoft API instance brought into API Catalog for Salesforce from Anypoint Platform.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_catalogedapi.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="accessStatus" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The access status for the API instance. Values are: Approved Deleted NoStatus NotAccessible Pending Rejected Revoked</xsd:documentation>
       <xsd:appinfo>Type: APIInstanceAccessStatus (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="apiInstanceDescriptor" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The content of the API schema in JSON format.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="approvalType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The approval type for access in Anypoint Platform. Values are: AutoApproval ManualApproval NoApproval</xsd:documentation>
       <xsd:appinfo>Type: APIInstanceApprovalType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="endpointType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The endpoint type to invoke the instance. Available in API version 66.0 and later. Values are: Callout Discovery</xsd:documentation>
       <xsd:appinfo>Type: APIInstanceEndpointType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The instance name as it appears in API Catalog.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="serviceRegistration" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The service registration in external services related to this API instance.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="uri" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The uniform resource identifier (URI) for the instance.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="CatalogedApiVersion">
  <xsd:annotation>
   <xsd:documentation>Represents a version of an API that is consumable in Salesforce using API Catalog.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_catalogedapiversion.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="catalogedApi" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. An API managed for consumption in Salesforce using API Catalog.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The description defined when the API is cataloged.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="externalSourceIdentifier" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The ID of the API in the external source that it&apos;s imported from.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The API name as it appears in API Catalog.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="version" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The ID of the API version information.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="Certificate">
  <xsd:annotation>
   <xsd:documentation>Represents a certificate used for digital signatures that verify that requests are coming from your org. Certificates are used for either authenticated single sign-on with an external website, or when using your org as an identity provider. This type extends the Metadata With Content metadata type and inherits its content and fullName fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_certificate.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="caSigned" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether this certificate is signed by the issuer (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="encryptedWithPlatformEncryption" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this certificate is encrypted with Platform Encryption.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="expirationDate" minOccurs="0" maxOccurs="unbounded" type="xsd:dateTime">
      <xsd:annotation>
       <xsd:documentation>The date that this certificate expires and is no longer usable. For self-signed certificates, if keySize is 2048 bits, the expiration date is automatically 1 year after you create the certificate. If keySize is 4096 bits, the expiration date is automatically 2 years after you create the certificate. For CA-signed certificates, expirationDate is automatically updated to the signed certificate’s expiration date when a signed certificate chain is uploaded. The date format is YYYY-MM-DD.</xsd:documentation>
       <xsd:appinfo>Type: dateTime</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="keySize" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Certificate keys can be either 2048 bits or 4096 bits. A certificate with 4096-bit keys lasts 2 years, and a certificate with 2048-bit keys lasts 1 year. Certificates with 2048-bit keys are faster than certificates with 4096-bit keys. If keySize isn’t specified when you create a certificate, the key size defaults to 2048 bits.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. A user-friendly name for the certificate that appears in the Salesforce user interface, such as in Certificate and Key Management. Limit: 64 characters.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="privateKeyExportable" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether this certificate’s private key is exportable. If privateKeyExportable isn’t specified when you create a certificate, its default value is true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChannelLayout">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata associated with a communication channel layout. Communication channel layouts let admins share article content inline into communication channels (for example, in email publishers, Experience Builder sites, or social media publishers). Admins can create a list of fields for an article type or record type that they want to share for each communication channel. You can customize the order of the fields.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_articletype_channellayout.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="doesExcludeFieldLabels" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether field labels are excluded from the field contents in the communication channels where this layout applies (true) or not (false). The default is false, meaning field labels are inserted. Available when Lightning Knowledge is enabled in API version 48.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="doesExcludeFiles" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether related files are left off emails (true) or attached to emails (false). The default is false, meaning related files are attached. Available when Lightning Knowledge is enabled in API version 48.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enabledChannels" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The communication channels where this layout applies. In API version 32.0 to 46.0, the only valid value is Email. When Lightning Knowledge is enabled in API version 47.0 and later, Chat, Messaging, and Social are added valid values.</xsd:documentation>
       <xsd:appinfo>Type: string[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="label" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label for this configuration.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="layoutItems" minOccurs="0" maxOccurs="unbounded" type="ChannelLayoutItem">
      <xsd:annotation>
       <xsd:documentation>The article fields contained in the layout. The order here determines the field order.</xsd:documentation>
       <xsd:appinfo>Type: ChannelLayoutItem[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="recordType" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the record type that the channel layout applies to. The default is the primary record type. Available in API version 41.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChannelLayoutItem">
  <xsd:annotation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_articletype_channellayout.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="field" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Name of the field. The format is ArticleTypeName.FieldName or, in Lightning Knowledge, KnowledgeBaseName.FieldName.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChartAxis">
  <xsd:annotation>
   <xsd:documentation>An enumeration of type string that specifies the axis or axes to be used in charts. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChartPosition">
  <xsd:annotation>
   <xsd:documentation>An enumeration of type string that specifies the position of the chart in the report. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChartRangeType">
  <xsd:annotation>
   <xsd:documentation>An enumeration of type string that defines the report format. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChartSummary">
  <xsd:annotation>
   <xsd:documentation>ChartSummary defines how data in the chart is summarized. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="aggregate" minOccurs="0" maxOccurs="unbounded" type="ReportSummaryType">
      <xsd:annotation>
       <xsd:documentation>Specifies the aggregation method—such as Sum, Average, Min, and Max—for the summary value. Use the column field to specify the summary value to use for the aggregation. You don&apos;t need to specify this field for RowCount or custom summary formulas.</xsd:documentation>
       <xsd:appinfo>Type: ReportSummaryType</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="axisBinding" minOccurs="0" maxOccurs="unbounded" type="ChartAxis">
      <xsd:annotation>
       <xsd:documentation>Specifies the axis or axes to use on the chart. Use the column field to specify the summary value to use for the axis.</xsd:documentation>
       <xsd:appinfo>Type: ChartAxis</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="column" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Specifies the summary field for the chart data. If all columns are invalid, RowCount is used by default for the axis value. For vertical column and horizontal bar combination charts, you can specify up to four values.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChartType">
  <xsd:annotation>
   <xsd:documentation>An enumeration of type string that defines the chart type. For information on each of these chart types, see Chart Types in Salesforce Help. Valid values:</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_report.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChatterAnswersReputationLevel">
  <xsd:annotation>
   <xsd:documentation>Represents the reputation name and the number of points for that level for Chatter Answers.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_community.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="name" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of the reputation level, for example, “Expert.”</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="value" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>The minimum number of points for the reputation level.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChatterAnswersSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata used to manage settings for Chatter Answers. In the package manifest, all organization settings metadata types are accessed using the Settings name. See Settings for details.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_chatteranswerssettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="emailFollowersOnBestAnswer" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are notified when a best answer is selected for a question that they’re following (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="emailFollowersOnReply" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are notified when other users reply to questions that they’re following (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="emailOwnerOnPrivateReply" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are notified when customer support responds to their questions privately (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="emailOwnerOnReply" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users are notified when other users reply to their questions (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableAnswerViaEmail" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can post answers by replying to email notifications (true) or not (false). This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableChatterAnswers" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the Chatter Answers feature is enabled in the organization (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFacebookSSO" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can sign in to your Chatter Answers forums with their Facebook logins (true) or not (false). To enable this feature, you must define and enable a Facebook authentication provider in your organization’s security controls and enable Auth Providers in your organization.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableInlinePublisher" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can filter search results by articles or questions before they post a question to any of your Chatter Answers forums (true) or not (false). Also, adds Title and Body fields to questions for easier text input and scanning. This field is available in API version 29.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableReputation" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether user reputations appear as hover text on their profile pictures (true) or not (false). Reputation is enabled across all zones. To enable the reputation setting, you must enable Reputation in your organization.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRichTextEditor" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the rich text editor is enabled for users to format text and upload images when posting questions (true) or not (false). To enable rich text editor, you must enable Optimize Question Flow.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="facebookAuthProvider" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The name of an existing Facebook authentication provider. To implement Facebook Single Sign On for your Chatter Answers forums, you must choose a Facebook authentication provider.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="showInPortals" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Chatter Answers can be added as a tab to your Customer portal or partner portal (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChatterEmailsMDSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s settings for Chatter email when Chatter is enabled. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_chatteremailmdsettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="enableChatterDigestEmailsApiOnly" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Chatter digests can be sent via the API, rather than according to the regular schedule, for your org (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableChatterEmailAttachment" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether attachments can be included on posts to chatter feeds via email replies (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCollaborationEmail" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether collaboration email notifications can be sent (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableDisplayAppDownloadBadges" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether iOS and Android app download badges display in Chatter notifications (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEmailReplyToChatter" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can reply to chatter notifications through an email response (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableEmailToChatter" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether users can post to chatter feeds via email (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="noQnOwnNotifyOnCaseCmt" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a user is notified when a question is posted on their case comment (false) or not (true).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="noQnOwnNotifyOnRep" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a user is notified when a reply is posted on their question (false) or not true.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="noQnSubNotifyOnBestR" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a user is notified when a best reply is selected on a question they follow (false) or not (true).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="noQnSubNotifyOnRep" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a user is notified when a reply is posted on a question they follow (false) or not (true).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChatterExtension">
  <xsd:annotation>
   <xsd:documentation>Represents the metadata used to describe a Rich Publisher App that’s integrated with the Chatter publisher.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_chatterextensions.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="compositionComponent" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The composition component of the Rich Publisher App that you provide. It’s comprised of the lightning:availableForChatterExtensionComposer interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The description of your custom Rich Publisher App.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="extensionName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The name of your extension. That is, your Rich Publisher App.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="headerText" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The text to show in the header of your app composer. Header text is required for Lightning type extensions. This text can be localized.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="hoverText" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The text to show when a user mouses over your extension’s icon. Mouse-over text is required for Lightning type extensions. This text can be localized.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="icon" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The icon to show in the Chatter publisher. Use an existing file asset id from your org.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isProtected" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>An auto-generated value. It currently has no impact.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Label for the ChatterExtension object.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="renderComponent" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The rendering component of the Rich Publisher App that you provide. It’s comprised of the lightning:availableForChatterExtensionRenderer interface.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="type" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. Describes the type of the extension. Currently, the only value supported is Lightning. Included to allow for other possible types in the future.</xsd:documentation>
       <xsd:appinfo>Type: ChatterExtensionType (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChatterMobileSettings">
  <xsd:annotation>
   <xsd:documentation>These fields are removed in API version 46.0. Represents your organization&apos;s Chatter Mobile settings.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_mobilesettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="IPadAuthorized" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether iPad devices are enabled for Chatter Mobile (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="IPhoneAuthorized" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether iPhone devices are enabled for Chatter Mobile (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="androidAuthorized" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Android devices are enabled for Chatter Mobile (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="blackBerryAuthorized" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Blackberry devices are enabled for Chatter Mobile (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableChatterMobile" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Chatter Mobile has been enabled for your organization (true) or not (false). Setting this field to true enables you to set all the other ChatterMobile settings. If you change this setting from true to false, and also try to change any of the other ChatterMobile settings, your deployment fails with an error.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enablePushNotifications" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Chatter push notifications have been enabled for your organization (true) or not (false)</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="sessionTimeout" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>The length of time after which users without activity are prompted to log out or continue working. Valid values are: Never OneMinute FiveMinutes TenMinutes ThirtyMinutes</xsd:documentation>
       <xsd:appinfo>Type: MobileSessionTimeout (enumeration of type string)</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChatterSettings">
  <xsd:annotation>
   <xsd:documentation>Represents an org’s settings for their Chatter instance when Chatter is enabled for the org. This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_chattersettings.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="allowChatterGroupArchiving" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether manual and automatic group archiving are allowed on all Chatter groups (true) or aren’t allowed (false).In Setup, allowChatterGroupArchiving equates to the Chatter setting Allow Group Archiving.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="allowRecordsInChatterGroup" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether records can be associated with groups (true), or not (false). If groups already have record data, setting this field to false doesn’t delete it.In Setup, allowRecordsInChatterGroup equates to the Chatter setting Allow Records in Groups.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="allowSharingInChatterGroup" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Removed. The setting of this field has no effect on the org. Available in API version 47.0 only.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableApprovalRequest" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Approvals in Chatter are enabled for the org. When the value is true, users see approval requests as posts in Chatter feeds. Users can update their own Chatter feeds settings to opt out of receiving approval requests as Chatter posts. When the value is false, approval requests aren’t posted to Chatter. The default value is false.In Setup, enableApprovalRequest equates to the Chatter setting Allow Approvals.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableCaseFeedRelativeTimestamps" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>In Case feeds, indicates whether to use relative (true) or absolute (false) date and time stamp formats on Case feed items. When the value is true, Case feed items show a relative timestamp (for example, 10m ago). When the value is true, users can hover over the relative timestamp to see the absolute. When the value is false, Case feed items show an absolute timestamp (for example, January 7, 2020 at 12:15PM). When you change this setting, all timestamps in Case feeds reflect that change. The default value is true. This field is available in API version 48.0 and later.In Setup, enableCaseFeedRelativeTimestamps equates to the Chatter setting Show relative timestamp.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableChatter" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Chatter is enabled for your org (true) or not (false).</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableChatterEmoticons" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether the automatic conversion of text characters, such as :), into a graphic emoticon is allowed in Chatter (true) or isn’t allowed (false).In Setup, enableChatter equates to the Chatter setting Allow Emoticons.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFeedEdit" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether qualified users can edit feed posts and comments (true) or not (false). Qualified users include: The author of the post or comment The person who owns the record that was posted to or commented on The Chatter or site moderator In Setup, enableFeedEdit equates to the Chatter setting Allow users to edit posts and comments.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFeedPinning" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to allow the pinning of posts in a feed (true) or not (false). When set to true: Authorized users can pin posts to the top of the feed. The feed supports up to three pinned posts. Pinned posts stay pinned until they’re unpinned. After post pinning is enabled, authorized users include admins and group owners and managers. Admins can also assign post pinning permission through permission sets or user profiles. In Setup, enableFeedPinning equates to the Chatter setting Allow post pinning.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFeedsDraftPosts" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether draft posts are automatically saved every seven seconds (true) or not (false). When set to true: Adds the My Drafts feed to the Chatter tab Saves draft posts automatically every seven seconds Makes drafts available in the My Drafts feed When the user posts the entry, the draft is automatically removed from the My Drafts feed.In Setup, enableFeedsDraftPosts equates to the Chatter setting Allow draft posts.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableFeedsRichText" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to use the Rich Text Editor in the Chatter Publisher (true) or not (false). The rich text editor supports text formats, inline images, hyperlinks, and, when enabled for the org, code snippets.In Setup, enableFeedsRichText equates to the Chatter setting Allow users to compose rich text posts.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableInviteCsnUsers" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether a licensed user can invite customers to private groups that the licensed user owns or manages (true) or not (false). When the value is set to true, licensed users can invite customers who are from outside org email domains. Invited customers can see information only in the groups that they&apos;re invited to. They can interact only with members of those groups.In Setup, enableInviteCsnUsers equates to the Chatter setting Allow customer invitations.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableOutOfOfficeEnabledPref" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to add an Out of Office setting to a user profile page (true), or to omit it (false). When the value is set to true, this option adds a control to user profile pages for setting a personal out-of-office message.In Setup, enableOutOfOfficeEnabledPref equates to the Chatter setting Users can set Out of Office message.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableRichLinkPreviewsInFeed" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to convert links in posts into embedded videos, images, and article previews (true) or not to convert the links (false). In Setup, enableRichLinkPreviewsInFeed equates to the Chatter setting Allow Rich Link Previews.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableTodayRecsInFeed" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to allow the posting of recommendations for using the Salesforce Today app in users’ feeds (true) or not (false). When set to true, automatically posts recommendations for using the Salesforce Today app in users’ feeds.In Setup, enableTodayRecsInFeed equates to the Chatter setting Allow Today Recommendations.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="unlistedGroupsEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to allow the creation of unlisted groups (true) or to prevent their creation (false). When the value is set to true, users can create unlisted groups. Unlisted groups don’t appear on the Groups list page. Membership in unlisted groups is by invitation only.In Setup, unlistedGroupsEnabled equates to the Chatter setting Enable Unlisted Groups.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChoiceList">
  <xsd:annotation>
   <xsd:documentation>Represents the Choicelist dropdown field that’s used for pre-chat.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_choicelist.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="choiceListValue" minOccurs="0" maxOccurs="unbounded" type="ChoiceListValue">
      <xsd:annotation>
       <xsd:documentation>A list of choices to display in the choice list.</xsd:documentation>
       <xsd:appinfo>Type: ChoiceListValue[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="description" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>A description of the choice list.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="masterLabel" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The label for the choice list.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ChoiceListValue">
  <xsd:annotation>
   <xsd:documentation>Represents a choice list value in the pre-chat dropdown. ChoiceListValue is available in API version 62 or later.</xsd:documentation>
   <xsd:appinfo>Documentation: https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_choicelist.htm</xsd:appinfo>
  </xsd:annotation>
  <xsd:complexContent>
   <xsd:extension base="Metadata">
    <xsd:choice maxOccurs="unbounded">
     <xsd:element name="embeddedServiceCustomLabels" minOccurs="0" maxOccurs="unbounded" type="EmbeddedServiceCustomLabel">
      <xsd:annotation>
       <xsd:documentation>Custom labels for the choicelist value.</xsd:documentation>
       <xsd:appinfo>Type: EmbeddedServiceCustomLabel[]</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="isDefaultValue" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Required. Indicates whether the choicelist value should be selected by default.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="order" minOccurs="0" maxOccurs="unbounded" type="xsd:int">
      <xsd:annotation>
       <xsd:documentation>Required. The order of the choicelist value in the choicelist dropdown field.</xsd:documentation>
       <xsd:appinfo>Type: int</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="valueName" minOccurs="0" maxOccurs="unbounded" type="xsd:string">
      <xsd:annotation>
       <xsd:documentation>Required. The value of the choicelist.</xsd:documentation>
       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ClaimFinancialSettings">
