{
  "name": "@salesforce/salesforcedx-lwc-language-server",
  "displayName": "LWC Language Server",
  "version": "64.16.1",
  "description": "Language server for Lightning Web Components.",
  "publisher": "salesforce",
  "engines": {
    "vscode": "^1.129.0"
  },
  "main": "out/src/server.js",
  "typings": "out/src/server.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./out/src/server.d.ts",
      "import": "./out/src/server.js",
      "require": "./out/src/server.js"
    }
  },
  "license": "BSD-3-Clause",
  "repository": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode"
  },
  "bin": {
    "lwc-language-server": "./bin/lwc-language-server.js"
  },
  "scripts": {
    "clean": "shx rm -rf node_modules out coverage .wireit .eslintcache",
    "compile": "wireit",
    "test": "wireit",
    "lint": "wireit",
    "check:effect-diagnostics": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc -p . && node scripts/convert.mts && node scripts/build.mts",
      "clean": "if-file-deleted",
      "dependencies": [
        "../salesforcedx-utils:compile",
        "../salesforcedx-lightning-lsp-common:compile",
        "../salesforcedx-vscode-i18n:compile"
      ],
      "files": [
        "src/**/*.ts",
        "scripts/**/*.mts",
        "scripts/tsconfig.json",
        "src/build-time-resources/lwc-standard.json",
        "tsconfig.json",
        "../../tsconfig.common.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.mts",
        "scripts/tsconfig.json",
        "../../scripts/tsconfig.native.json",
        "../../eslint.config.mjs"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "compile"
      ],
      "files": [
        "test/**/*",
        "vitest.config.mts",
        "../../config/vitest.base.config.mts",
        "../../config/__mocks__/o11y_schema_sf_pdp.js",
        "../../scripts/setupVitest.ts",
        "../../scripts/vscodeMock.ts"
      ],
      "output": [
        "coverage"
      ]
    },
    "check:effect-diagnostics": {
      "command": "node ../../scripts/effect-diagnostics.mjs .",
      "dependencies": [
        "compile"
      ],
      "files": [
        "package.json",
        "../../config/effect-diagnostics.json",
        "../../scripts/effect-diagnostics.mjs"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@salesforce/salesforcedx-utils": "*",
    "@lwc/compiler": "9.0.3",
    "@lwc/errors": "9.0.3",
    "@lwc/metadata": "13.3.30",
    "@lwc/template-compiler": "9.3.4",
    "@salesforce/apex": "^0.0.21",
    "@salesforce/label": "^0.0.21",
    "@salesforce/salesforcedx-lightning-lsp-common": "workspace:*",
    "@salesforce/schema": "^0.0.21",
    "@salesforce/vscode-i18n": "workspace:*",
    "babel-types": "^6.26.0",
    "change-case": "^4.1.1",
    "comment-parser": "^0.7.6",
    "effect": "^3.21.2",
    "ejs": "^3.1.10",
    "minimatch": "^11.0.1",
    "vscode-html-languageservice": "^5.5.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/babel-types": "^7.0.8",
    "@types/ejs": "^3.1.5",
    "colormin": "1.1.2",
    "js-base64": "3.7.8",
    "num2fraction": "1.2.2"
  }
}
