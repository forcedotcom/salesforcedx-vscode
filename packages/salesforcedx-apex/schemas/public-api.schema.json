{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "ApexCodeCoverageRecord": {
      "type": "object",
      "properties": {
        "ApexClassOrTrigger": {
          "type": "object",
          "properties": { "Id": { "type": "string" }, "Name": { "type": "string" } },
          "required": ["Id", "Name"],
          "additionalProperties": false
        },
        "ApexTestClassId": { "type": "string" },
        "TestMethodName": { "type": "string" },
        "NumLinesCovered": { "type": "number" },
        "NumLinesUncovered": { "type": "number" },
        "Coverage": {
          "type": "object",
          "properties": {
            "coveredLines": { "type": "array", "items": { "type": "number" } },
            "uncoveredLines": { "type": "array", "items": { "type": "number" } }
          },
          "required": ["coveredLines", "uncoveredLines"],
          "additionalProperties": false
        }
      },
      "required": ["ApexClassOrTrigger", "ApexTestClassId", "TestMethodName", "NumLinesCovered", "NumLinesUncovered"],
      "additionalProperties": false
    },
    "ApexCodeCoverage": {
      "type": "object",
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/ApexCodeCoverageRecord" } }
      },
      "required": ["done", "totalSize", "records"],
      "additionalProperties": false
    },
    "ApexCodeCoverageAggregateRecord": {
      "type": "object",
      "properties": {
        "ApexClassOrTrigger": {
          "type": "object",
          "properties": { "Id": { "type": "string" }, "Name": { "type": "string" } },
          "required": ["Id", "Name"],
          "additionalProperties": false
        },
        "NumLinesCovered": { "type": "number" },
        "NumLinesUncovered": { "type": "number" },
        "Coverage": {
          "type": "object",
          "properties": {
            "coveredLines": { "type": "array", "items": { "type": "number" } },
            "uncoveredLines": { "type": "array", "items": { "type": "number" } }
          },
          "required": ["coveredLines", "uncoveredLines"],
          "additionalProperties": false
        }
      },
      "required": ["ApexClassOrTrigger", "NumLinesCovered", "NumLinesUncovered", "Coverage"],
      "additionalProperties": false
    },
    "ApexCodeCoverageAggregate": {
      "type": "object",
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/ApexCodeCoverageAggregateRecord" } }
      },
      "required": ["done", "totalSize", "records"],
      "additionalProperties": false
    },
    "ApexDiagnostic": {
      "type": "object",
      "properties": {
        "lineNumber": {
          "anyOf": [
            { "type": "number" },
            { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] },
            { "type": "null" }
          ]
        },
        "columnNumber": {
          "anyOf": [
            { "type": "number" },
            { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] },
            { "type": "null" }
          ]
        },
        "exceptionMessage": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "compileProblem": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "exceptionStackTrace": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "className": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "ApexExecuteOptions": {
      "type": "object",
      "properties": { "apexCode": { "type": "string" } },
      "required": ["apexCode"],
      "additionalProperties": false
    },
    "LogLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
    "ApexLogGetOptions": {
      "type": "object",
      "properties": {
        "json": { "type": "boolean" },
        "loglevel": { "$ref": "#/$defs/LogLevel" },
        "numberOfLogs": { "type": "number" },
        "logId": { "type": "string" },
        "outputDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ApexTestQueueItemStatus": {
      "type": "string",
      "enum": ["Holding", "Queued", "Preparing", "Processing", "Aborted", "Completed", "Failed"]
    },
    "ApexTestQueueItemRecord": {
      "type": "object",
      "properties": {
        "Id": { "type": "string" },
        "Status": { "$ref": "#/$defs/ApexTestQueueItemStatus" },
        "ApexClassId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "TestRunResultId": { "type": "string" }
      },
      "required": ["Id", "Status", "ApexClassId", "TestRunResultId"],
      "additionalProperties": false
    },
    "ApexTestQueueItem": {
      "type": "object",
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/ApexTestQueueItemRecord" } }
      },
      "required": ["done", "totalSize", "records"],
      "additionalProperties": false
    },
    "ApexTestProgressValue": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["StreamingClientProgress"] },
            "value": { "type": "string", "enum": ["streamingTransportUp", "streamingTransportDown"] },
            "message": { "type": "string" }
          },
          "required": ["type", "value", "message"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["StreamingClientProgress"] },
            "value": { "type": "string", "enum": ["streamingProcessingTestRun"] },
            "testRunId": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["type", "value", "testRunId", "message"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["PollingClientProgress"] },
            "value": { "type": "string", "enum": ["pollingProcessingTestRun"] },
            "testRunId": { "type": "string" },
            "message": { "type": "string" },
            "classesCompleted": { "type": "number" },
            "classesEnqueued": { "type": "number" }
          },
          "required": ["type", "value", "testRunId", "message", "classesCompleted", "classesEnqueued"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["TestQueueProgress"] },
            "value": { "$ref": "#/$defs/ApexTestQueueItem" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["FormatTestResultProgress"] },
            "value": { "type": "string", "enum": ["retrievingTestRunSummary", "queryingForAggregateCodeCoverage"] },
            "message": { "type": "string" }
          },
          "required": ["type", "value", "message"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["AbortTestRunProgress"] },
            "value": { "type": "string", "enum": ["abortingTestRun", "abortingTestRunRequested"] },
            "message": { "type": "string" },
            "testRunId": { "type": "string" }
          },
          "required": ["type", "value", "message", "testRunId"],
          "additionalProperties": false
        }
      ]
    },
    "ApexTestResultId": { "type": "string", "pattern": "^07M" },
    "FlowTestResultId": { "type": "string", "pattern": "^2hU" },
    "ApexTestQueueItemId": { "type": "string", "pattern": "^709" },
    "AsyncApexJobId": { "type": "string" },
    "ApexTestResultOutcome": { "type": "string", "enum": ["Pass", "Fail", "CompileFail", "Skip"] },
    "ApexLogId": { "type": "string", "pattern": "^07L" },
    "ApexClassId": { "type": "string", "pattern": "^01p" },
    "ApexTriggerId": { "type": "string", "pattern": "^01q" },
    "CoverageLineCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "CoverageLineNumber": { "type": "integer", "maximum": 9007199254740991, "exclusiveMinimum": 0 },
    "PerClassCoverage": {
      "type": "object",
      "properties": {
        "apexClassOrTriggerName": { "type": "string" },
        "apexClassOrTriggerId": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "$ref": "#/$defs/ApexTriggerId" }] },
        "apexTestClassId": { "$ref": "#/$defs/ApexClassId" },
        "apexTestMethodName": { "type": "string" },
        "numLinesCovered": { "$ref": "#/$defs/CoverageLineCount" },
        "numLinesUncovered": { "$ref": "#/$defs/CoverageLineCount" },
        "percentage": { "type": "string" },
        "coverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "coveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } },
                "uncoveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } }
              },
              "required": ["coveredLines", "uncoveredLines"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "apexClassOrTriggerName",
        "apexClassOrTriggerId",
        "apexTestClassId",
        "apexTestMethodName",
        "numLinesCovered",
        "numLinesUncovered",
        "percentage"
      ],
      "additionalProperties": false
    },
    "ApexTestResultData": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [{ "$ref": "#/$defs/ApexTestResultId" }, { "$ref": "#/$defs/FlowTestResultId" }, { "type": "null" }]
        },
        "queueItemId": { "anyOf": [{ "$ref": "#/$defs/ApexTestQueueItemId" }, { "type": "null" }] },
        "stackTrace": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }, { "type": "null" }] },
        "message": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }, { "type": "null" }] },
        "asyncApexJobId": { "anyOf": [{ "$ref": "#/$defs/AsyncApexJobId" }, { "type": "null" }] },
        "methodName": { "type": "string" },
        "outcome": { "$ref": "#/$defs/ApexTestResultOutcome" },
        "apexLogId": { "anyOf": [{ "$ref": "#/$defs/ApexLogId" }, { "type": "null" }, { "type": "null" }] },
        "apexClass": {
          "type": "object",
          "properties": {
            "id": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "type": "null" }] },
            "name": { "type": "string" },
            "namespacePrefix": {
              "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }, { "type": "null" }]
            },
            "fullName": { "type": "string" }
          },
          "required": ["name", "fullName"],
          "additionalProperties": false
        },
        "runTime": { "anyOf": [{ "type": "number" }, { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] }] },
        "testTimestamp": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "fullName": { "type": "string" },
        "perClassCoverage": {
          "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/PerClassCoverage" } }, { "type": "null" }]
        },
        "diagnostic": { "anyOf": [{ "$ref": "#/$defs/ApexDiagnostic" }, { "type": "null" }] },
        "category": { "anyOf": [{ "type": "string", "enum": ["Apex", "Flow"] }, { "type": "null" }] }
      },
      "required": ["methodName", "outcome", "apexClass", "runTime", "fullName"],
      "additionalProperties": false
    },
    "ApexTestResultDataRaw": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [{ "$ref": "#/$defs/ApexTestResultId" }, { "$ref": "#/$defs/FlowTestResultId" }, { "type": "null" }]
        },
        "queueItemId": { "anyOf": [{ "$ref": "#/$defs/ApexTestQueueItemId" }, { "type": "null" }] },
        "stackTrace": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }, { "type": "null" }] },
        "message": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }, { "type": "null" }] },
        "asyncApexJobId": { "anyOf": [{ "$ref": "#/$defs/AsyncApexJobId" }, { "type": "null" }] },
        "methodName": { "type": "string" },
        "outcome": { "$ref": "#/$defs/ApexTestResultOutcome" },
        "apexLogId": { "anyOf": [{ "$ref": "#/$defs/ApexLogId" }, { "type": "null" }, { "type": "null" }] },
        "apexClass": {
          "type": "object",
          "properties": {
            "id": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "type": "null" }] },
            "name": { "type": "string" },
            "namespacePrefix": {
              "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }, { "type": "null" }]
            },
            "fullName": { "type": "string" }
          },
          "required": ["name", "fullName"],
          "additionalProperties": false
        },
        "runTime": { "anyOf": [{ "type": "number" }, { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] }] },
        "testTimestamp": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "fullName": { "type": "string" },
        "perClassCoverage": {
          "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/PerClassCoverage" } }, { "type": "null" }]
        },
        "diagnostic": { "anyOf": [{ "$ref": "#/$defs/ApexDiagnostic" }, { "type": "null" }] },
        "category": { "anyOf": [{ "type": "string", "enum": ["Apex", "Flow"] }, { "type": "null" }] },
        "isTestSetup": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] }
      },
      "required": ["methodName", "outcome", "apexClass", "runTime", "fullName"],
      "additionalProperties": false
    },
    "ApexTestRunResultStatus": {
      "type": "string",
      "enum": ["Queued", "Processing", "Aborted", "Passed", "Failed", "Completed", "Skipped"]
    },
    "ApexTestSetupData": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [{ "$ref": "#/$defs/ApexTestResultId" }, { "$ref": "#/$defs/FlowTestResultId" }, { "type": "null" }]
        },
        "stackTrace": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "message": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "asyncApexJobId": { "anyOf": [{ "$ref": "#/$defs/AsyncApexJobId" }, { "type": "null" }] },
        "methodName": { "type": "string" },
        "apexLogId": { "anyOf": [{ "$ref": "#/$defs/ApexLogId" }, { "type": "null" }] },
        "apexClass": {
          "type": "object",
          "properties": {
            "id": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "type": "null" }] },
            "name": { "type": "string" },
            "namespacePrefix": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "fullName": { "type": "string" }
          },
          "required": ["name", "fullName"],
          "additionalProperties": false
        },
        "testSetupTime": {
          "anyOf": [{ "type": "number" }, { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] }]
        },
        "testTimestamp": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "fullName": { "type": "string" },
        "diagnostic": { "anyOf": [{ "$ref": "#/$defs/ApexDiagnostic" }, { "type": "null" }] }
      },
      "required": ["methodName", "apexClass", "testSetupTime", "fullName"],
      "additionalProperties": false
    },
    "ApexCompileError": {
      "type": "object",
      "properties": {
        "_tag": { "type": "string", "enum": ["ApexCompileError"] },
        "operation": { "type": "string", "minLength": 1, "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$" },
        "message": { "type": "string" },
        "line": { "type": "number" },
        "column": { "type": "number" },
        "logBody": { "type": "string" },
        "compileProblem": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["_tag", "operation", "message", "line", "column", "compileProblem"],
      "additionalProperties": false
    },
    "ApexOperationError": {
      "type": "object",
      "properties": {
        "_tag": { "type": "string", "enum": ["ApexOperationError"] },
        "operation": { "type": "string", "minLength": 1, "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$" },
        "message": { "type": "string" },
        "cause": { "type": "string" }
      },
      "required": ["_tag", "operation", "message"],
      "additionalProperties": false
    },
    "ApexResponseDecodeError": {
      "type": "object",
      "properties": {
        "_tag": { "type": "string", "enum": ["ApexResponseDecodeError"] },
        "operation": { "type": "string", "minLength": 1, "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$" },
        "message": { "type": "string" },
        "cause": { "type": "string" }
      },
      "required": ["_tag", "operation", "message"],
      "additionalProperties": false
    },
    "ApexRuntimeError": {
      "type": "object",
      "properties": {
        "_tag": { "type": "string", "enum": ["ApexRuntimeError"] },
        "operation": { "type": "string", "minLength": 1, "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$" },
        "message": { "type": "string" },
        "line": { "type": "number" },
        "column": { "type": "number" },
        "logBody": { "type": "string" },
        "exceptionMessage": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "exceptionStackTrace": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["_tag", "operation", "message", "line", "column", "exceptionMessage", "exceptionStackTrace"],
      "additionalProperties": false
    },
    "TestItem": {
      "type": "object",
      "properties": {
        "className": {
          "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$" }, { "type": "null" }]
        },
        "classId": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "type": "null" }] },
        "testMethods": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$" } },
            { "type": "null" }
          ]
        },
        "namespace": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "category": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "TestLevel": { "type": "string", "enum": ["RunLocalTests", "RunAllTestsInOrg", "RunSpecifiedTests"] },
    "AsyncTestArrayConfiguration": {
      "type": "object",
      "properties": {
        "tests": { "type": "array", "items": { "$ref": "#/$defs/TestItem" } },
        "maxFailedTests": { "type": "number" },
        "testLevel": { "$ref": "#/$defs/TestLevel" },
        "exitOnTestRunId": { "type": "boolean" },
        "skipCodeCoverage": { "type": "boolean" },
        "category": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["tests", "testLevel"],
      "additionalProperties": false
    },
    "AsyncTestConfiguration": {
      "type": "object",
      "properties": {
        "classNames": { "type": "string" },
        "classids": { "type": "string" },
        "suiteNames": { "type": "string" },
        "suiteids": { "type": "string" },
        "maxFailedTests": { "type": "number" },
        "testLevel": { "$ref": "#/$defs/TestLevel" },
        "skipCodeCoverage": { "type": "boolean" },
        "exitOnTestRunId": { "type": "boolean" },
        "category": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["testLevel"],
      "additionalProperties": false
    },
    "BuildSyncPayloadOptions": {
      "type": "object",
      "properties": {
        "testLevel": { "$ref": "#/$defs/TestLevel" },
        "tests": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "classNames": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "category": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "skipCodeCoverage": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] }
      },
      "required": ["testLevel"],
      "additionalProperties": false
    },
    "CodeCoverageResult": {
      "type": "object",
      "properties": {
        "apexId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["ApexClass", "ApexTrigger"] },
        "numLinesCovered": { "type": "number" },
        "numLinesUncovered": { "type": "number" },
        "percentage": { "type": "string" },
        "coveredLines": { "type": "array", "items": { "type": "number" } },
        "uncoveredLines": { "type": "array", "items": { "type": "number" } }
      },
      "required": [
        "apexId",
        "name",
        "type",
        "numLinesCovered",
        "numLinesUncovered",
        "percentage",
        "coveredLines",
        "uncoveredLines"
      ],
      "additionalProperties": false
    },
    "CommonOptions": {
      "type": "object",
      "properties": { "json": { "type": "boolean" }, "loglevel": { "$ref": "#/$defs/LogLevel" } },
      "additionalProperties": false
    },
    "ExecuteAnonymousOptions": {
      "type": "object",
      "properties": { "apexCode": { "type": "string" } },
      "required": ["apexCode"],
      "additionalProperties": false
    },
    "ExecuteAnonymousOutcome": {
      "type": "object",
      "properties": {
        "compiled": { "type": "boolean", "enum": [true] },
        "success": { "type": "boolean", "enum": [true] },
        "logBody": { "type": "string" },
        "line": { "type": "number" },
        "column": { "type": "number" }
      },
      "required": ["compiled", "success", "line", "column"],
      "additionalProperties": false
    },
    "ExecuteAnonymousResponse": {
      "type": "object",
      "properties": {
        "compiled": { "type": "boolean" },
        "success": { "type": "boolean" },
        "logs": { "type": "string" },
        "diagnostic": { "type": "array", "items": { "$ref": "#/$defs/ApexDiagnostic" } }
      },
      "required": ["compiled", "success"],
      "additionalProperties": false
    },
    "LogRecord": {
      "type": "object",
      "properties": {
        "Id": { "type": "string" },
        "Application": { "type": "string" },
        "DurationMilliseconds": { "type": "number" },
        "Location": { "type": "string" },
        "LogLength": { "type": "number" },
        "LogUser": {
          "type": "object",
          "properties": { "attributes": { "type": "object" }, "Name": { "type": "string" } },
          "required": ["attributes", "Name"],
          "additionalProperties": false
        },
        "Operation": { "type": "string" },
        "Request": { "type": "string" },
        "StartTime": { "type": "string" },
        "Status": { "type": "string" }
      },
      "required": [
        "Id",
        "Application",
        "DurationMilliseconds",
        "Location",
        "LogLength",
        "LogUser",
        "Operation",
        "Request",
        "StartTime",
        "Status"
      ],
