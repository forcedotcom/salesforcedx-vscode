{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "AggregateCodeCoverageResult": {
      "type": "object",
      "required": ["codeCoverageResults", "totalLines", "coveredLines"],
      "properties": {
        "codeCoverageResults": { "type": "array", "items": { "$ref": "#/$defs/CodeCoverageResult" } },
        "totalLines": { "$ref": "#/$defs/CoverageLineCount" },
        "coveredLines": { "$ref": "#/$defs/CoverageLineCount" }
      },
      "additionalProperties": false
    },
    "CodeCoverageResult": {
      "type": "object",
      "required": [
        "apexId",
        "name",
        "type",
        "numLinesCovered",
        "numLinesUncovered",
        "percentage",
        "coveredLines",
        "uncoveredLines"
      ],
      "properties": {
        "apexId": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "$ref": "#/$defs/ApexTriggerId" }] },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["ApexClass", "ApexTrigger"] },
        "numLinesCovered": { "$ref": "#/$defs/CoverageLineCount" },
        "numLinesUncovered": { "$ref": "#/$defs/CoverageLineCount" },
        "percentage": { "type": "string" },
        "coveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } },
        "uncoveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } }
      },
      "additionalProperties": false
    },
    "ApexClassId": {
      "type": "string",
      "description": "a string starting with \"01p\"",
      "pattern": "^01p",
      "title": "startsWith(\"01p\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "ApexTriggerId": {
      "type": "string",
      "description": "a string starting with \"01q\"",
      "pattern": "^01q",
      "title": "startsWith(\"01q\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "CoverageLineCount": { "type": "integer", "description": "an integer", "title": "int", "minimum": 0 },
    "CoverageLineNumber": {
      "type": "integer",
      "description": "a positive number",
      "title": "positive",
      "exclusiveMinimum": 0
    },
    "ApexCodeCoverage": {
      "type": "object",
      "required": ["done", "totalSize", "records"],
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/ApexCodeCoverageRecord" } }
      },
      "additionalProperties": false
    },
    "ApexCodeCoverageRecord": {
      "type": "object",
      "required": ["ApexClassOrTrigger", "ApexTestClassId", "TestMethodName", "NumLinesCovered", "NumLinesUncovered"],
      "properties": {
        "ApexClassOrTrigger": {
          "type": "object",
          "required": ["Id", "Name"],
          "properties": {
            "Id": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "$ref": "#/$defs/ApexTriggerId" }] },
            "Name": { "type": "string" }
          },
          "additionalProperties": false
        },
        "ApexTestClassId": { "$ref": "#/$defs/ApexClassId" },
        "TestMethodName": { "type": "string" },
        "NumLinesCovered": { "$ref": "#/$defs/CoverageLineCount" },
        "NumLinesUncovered": { "$ref": "#/$defs/CoverageLineCount" },
        "Coverage": {
          "type": "object",
          "required": ["coveredLines", "uncoveredLines"],
          "properties": {
            "coveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } },
            "uncoveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ApexCodeCoverageAggregate": {
      "type": "object",
      "required": ["done", "totalSize", "records"],
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/ApexCodeCoverageAggregateRecord" } }
      },
      "additionalProperties": false
    },
    "ApexCodeCoverageAggregateRecord": {
      "type": "object",
      "required": ["ApexClassOrTrigger", "NumLinesCovered", "NumLinesUncovered", "Coverage"],
      "properties": {
        "ApexClassOrTrigger": {
          "type": "object",
          "required": ["Id", "Name"],
          "properties": {
            "Id": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "$ref": "#/$defs/ApexTriggerId" }] },
            "Name": { "type": "string" }
          },
          "additionalProperties": false
        },
        "NumLinesCovered": { "$ref": "#/$defs/CoverageLineCount" },
        "NumLinesUncovered": { "$ref": "#/$defs/CoverageLineCount" },
        "Coverage": {
          "type": "object",
          "required": ["coveredLines", "uncoveredLines"],
          "properties": {
            "coveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } },
            "uncoveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ApexOrgWideCoverage": {
      "type": "object",
      "required": ["done", "totalSize", "records"],
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["PercentCovered"],
            "properties": { "PercentCovered": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ApexDiagnostic": {
      "type": "object",
      "required": [],
      "properties": {
        "lineNumber": { "type": "number" },
        "columnNumber": { "type": "number" },
        "exceptionMessage": { "$ref": "#/$defs/NonEmptyString" },
        "compileProblem": { "$ref": "#/$defs/NonEmptyString" },
        "exceptionStackTrace": { "$ref": "#/$defs/NonEmptyString" },
        "className": { "type": "string" }
      },
      "additionalProperties": false
    },
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "ApexExecuteOptions": {
      "type": "object",
      "required": ["apexCode"],
      "properties": { "apexCode": { "type": "string" } },
      "additionalProperties": false
    },
    "ApexLogGetOptions": {
      "type": "object",
      "required": [],
      "properties": {
        "json": { "type": "boolean" },
        "loglevel": { "$ref": "#/$defs/LogLevel" },
        "numberOfLogs": { "type": "number" },
        "logId": { "type": "string" },
        "outputDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LogLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
    "ApexLogListItem": {
      "type": "object",
      "required": ["Id", "LogLength", "StartTime", "Status"],
      "properties": {
        "Id": {
          "type": "string",
          "description": "a string starting with \"07L\"",
          "pattern": "^07L",
          "title": "startsWith(\"07L\")",
          "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
        },
        "Application": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "DurationMilliseconds": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "LogLength": { "type": "number" },
        "LogUserId": {
          "anyOf": [
            {
              "type": "string",
              "description": "a string starting with \"005\"",
              "pattern": "^005",
              "title": "startsWith(\"005\")",
              "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
            },
            { "type": "null" }
          ],
          "title": "startsWith(\"005\")",
          "description": "a string starting with \"005\""
        },
        "LogUser": {
          "anyOf": [
            {
              "type": "object",
              "required": [],
              "properties": { "Name": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "Operation": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "StartTime": { "type": "string" },
        "Status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ApexLogQueryError": {
      "type": "object",
      "required": ["soql", "message", "cause", "_tag"],
      "properties": {
        "soql": { "type": "string" },
        "message": { "type": "string" },
        "cause": { "$id": "/schemas/unknown", "title": "unknown" },
        "_tag": { "type": "string", "enum": ["ApexLogQueryError"] }
      },
      "additionalProperties": false
    },
    "ApexLogBodyFetchError": {
      "type": "object",
      "required": ["message", "_tag"],
      "properties": {
        "message": { "type": "string" },
        "cause": { "$id": "/schemas/unknown", "title": "unknown" },
        "_tag": { "type": "string", "enum": ["ApexLogBodyFetchError"] }
      },
      "additionalProperties": false
    },
    "ListLogsOptions": {
      "type": "object",
      "required": [],
      "properties": {
        "userIds": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a string starting with \"005\"",
            "pattern": "^005",
            "title": "startsWith(\"005\")",
            "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
          }
        },
        "operationContains": { "type": "string" },
        "startTimeAfter": { "type": "string" },
        "cursor": {
          "type": "object",
          "required": ["startTime"],
          "properties": {
            "startTime": { "type": "string" },
            "id": {
              "type": "string",
              "description": "a string starting with \"07L\"",
              "pattern": "^07L",
              "title": "startsWith(\"07L\")",
              "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
            }
          },
          "additionalProperties": false
        },
        "orderBy": { "type": "string", "enum": ["ASC", "DESC"] }
      },
      "additionalProperties": false
    },
    "ApexTestProgressValue": {
      "anyOf": [
        {
          "type": "object",
          "required": ["type", "value", "message"],
          "properties": {
            "type": { "type": "string", "enum": ["StreamingClientProgress"] },
            "value": { "type": "string", "enum": ["streamingTransportUp", "streamingTransportDown"] },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value", "testRunId", "message"],
          "properties": {
            "type": { "type": "string", "enum": ["StreamingClientProgress"] },
            "value": { "type": "string", "enum": ["streamingProcessingTestRun"] },
            "testRunId": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value", "testRunId", "message", "classesCompleted", "classesEnqueued"],
          "properties": {
            "type": { "type": "string", "enum": ["PollingClientProgress"] },
            "value": { "type": "string", "enum": ["pollingProcessingTestRun"] },
            "testRunId": { "type": "string" },
            "message": { "type": "string" },
            "classesCompleted": { "type": "number" },
            "classesEnqueued": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "type": "string", "enum": ["TestQueueProgress"] },
            "value": { "$ref": "#/$defs/ApexTestQueueItem" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value", "message"],
          "properties": {
            "type": { "type": "string", "enum": ["FormatTestResultProgress"] },
            "value": { "type": "string", "enum": ["retrievingTestRunSummary", "queryingForAggregateCodeCoverage"] },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value", "message", "testRunId"],
          "properties": {
            "type": { "type": "string", "enum": ["AbortTestRunProgress"] },
            "value": { "type": "string", "enum": ["abortingTestRun", "abortingTestRunRequested"] },
            "message": { "type": "string" },
            "testRunId": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ApexTestQueueItem": {
      "type": "object",
      "required": ["done", "totalSize", "records"],
      "properties": {
        "done": { "type": "boolean" },
        "totalSize": { "type": "number" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/ApexTestQueueItemRecord" } }
      },
      "additionalProperties": false
    },
    "ApexTestQueueItemRecord": {
      "type": "object",
      "required": ["Id", "Status", "ApexClassId", "TestRunResultId"],
      "properties": {
        "Id": { "type": "string" },
        "Status": { "$ref": "#/$defs/ApexTestQueueItemStatus" },
        "ApexClassId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "TestRunResultId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ApexTestQueueItemStatus": {
      "type": "string",
      "enum": ["Holding", "Queued", "Preparing", "Processing", "Aborted", "Completed", "Failed"]
    },
    "ApexTestResultData": {
      "type": "object",
      "required": ["methodName", "outcome", "apexClass", "runTime", "fullName"],
      "properties": {
        "id": { "anyOf": [{ "$ref": "#/$defs/ApexTestResultId" }, { "$ref": "#/$defs/FlowTestResultId" }] },
        "queueItemId": { "$ref": "#/$defs/ApexTestQueueItemId" },
        "stackTrace": { "anyOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }] },
        "message": { "anyOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }] },
        "asyncApexJobId": { "$ref": "#/$defs/AsyncApexJobId" },
        "methodName": { "type": "string" },
        "outcome": { "$ref": "#/$defs/ApexTestResultOutcome" },
        "apexLogId": { "anyOf": [{ "$ref": "#/$defs/ApexLogId" }, { "type": "null" }] },
        "apexClass": {
          "type": "object",
          "required": ["name", "fullName"],
          "properties": {
            "id": { "$ref": "#/$defs/ApexClassId" },
            "name": { "type": "string" },
            "namespacePrefix": { "anyOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }] },
            "fullName": { "type": "string" }
          },
          "additionalProperties": false
        },
        "runTime": { "type": "number" },
        "testTimestamp": { "$ref": "#/$defs/NonEmptyString" },
        "fullName": { "type": "string" },
        "perClassCoverage": { "type": "array", "items": { "$ref": "#/$defs/PerClassCoverage" } },
        "diagnostic": { "$ref": "#/$defs/ApexDiagnostic" },
        "category": { "type": "string", "enum": ["Apex", "Flow"] }
      },
      "additionalProperties": false
    },
    "ApexTestResultId": {
      "type": "string",
      "description": "a string starting with \"07M\"",
      "pattern": "^07M",
      "title": "startsWith(\"07M\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "FlowTestResultId": {
      "type": "string",
      "description": "a string starting with \"2hU\"",
      "pattern": "^2hU",
      "title": "startsWith(\"2hU\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "ApexTestQueueItemId": {
      "type": "string",
      "description": "a string starting with \"709\"",
      "pattern": "^709",
      "title": "startsWith(\"709\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "AsyncApexJobId": {
      "type": "string",
      "description": "a string starting with \"707\"",
      "pattern": "^707",
      "title": "startsWith(\"707\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "ApexTestResultOutcome": { "type": "string", "enum": ["Pass", "Fail", "CompileFail", "Skip"] },
    "ApexLogId": {
      "type": "string",
      "description": "a string starting with \"07L\"",
      "pattern": "^07L",
      "title": "startsWith(\"07L\")",
      "allOf": [{ "pattern": "^(?:[A-Za-z0-9]{15}|[A-Za-z0-9]{18})$" }]
    },
    "PerClassCoverage": {
      "type": "object",
      "required": [
        "apexClassOrTriggerName",
        "apexClassOrTriggerId",
        "apexTestClassId",
        "apexTestMethodName",
        "numLinesCovered",
        "numLinesUncovered",
        "percentage"
      ],
      "properties": {
        "apexClassOrTriggerName": { "type": "string" },
        "apexClassOrTriggerId": { "anyOf": [{ "$ref": "#/$defs/ApexClassId" }, { "$ref": "#/$defs/ApexTriggerId" }] },
        "apexTestClassId": { "$ref": "#/$defs/ApexClassId" },
        "apexTestMethodName": { "type": "string" },
        "numLinesCovered": { "$ref": "#/$defs/CoverageLineCount" },
        "numLinesUncovered": { "$ref": "#/$defs/CoverageLineCount" },
        "percentage": { "type": "string" },
        "coverage": {
          "type": "object",
          "required": ["coveredLines", "uncoveredLines"],
          "properties": {
            "coveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } },
            "uncoveredLines": { "type": "array", "items": { "$ref": "#/$defs/CoverageLineNumber" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ApexTestResultDataRaw": {
      "type": "object",
      "required": ["methodName", "outcome", "apexClass", "runTime", "fullName"],
      "properties": {
        "id": { "anyOf": [{ "$ref": "#/$defs/ApexTestResultId" }, { "$ref": "#/$defs/FlowTestResultId" }] },
        "queueItemId": { "$ref": "#/$defs/ApexTestQueueItemId" },
        "stackTrace": { "anyOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }] },
        "message": { "anyOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }] },
        "asyncApexJobId": { "$ref": "#/$defs/AsyncApexJobId" },
        "methodName": { "type": "string" },
        "outcome": { "$ref": "#/$defs/ApexTestResultOutcome" },
        "apexLogId": { "anyOf": [{ "$ref": "#/$defs/ApexLogId" }, { "type": "null" }] },
        "apexClass": {
          "type": "object",
          "required": ["name", "fullName"],
          "properties": {
            "id": { "$ref": "#/$defs/ApexClassId" },
            "name": { "type": "string" },
            "namespacePrefix": { "anyOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }] },
            "fullName": { "type": "string" }
          },
          "additionalProperties": false
        },
        "runTime": { "type": "number" },
        "testTimestamp": { "$ref": "#/$defs/NonEmptyString" },
        "fullName": { "type": "string" },
        "perClassCoverage": { "type": "array", "items": { "$ref": "#/$defs/PerClassCoverage" } },
        "diagnostic": { "$ref": "#/$defs/ApexDiagnostic" },
        "category": { "type": "string", "enum": ["Apex", "Flow"] },
        "isTestSetup": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ApexTestRunResultStatus": {
      "type": "string",
      "enum": ["Queued", "Processing", "Aborted", "Passed", "Failed", "Completed", "Skipped"]
    },
    "ApexTestSetupData": {
      "type": "object",
      "required": ["methodName", "apexClass", "testSetupTime", "fullName"],
      "properties": {
        "id": { "anyOf": [{ "$ref": "#/$defs/ApexTestResultId" }, { "$ref": "#/$defs/FlowTestResultId" }] },
        "stackTrace": { "$ref": "#/$defs/NonEmptyString" },
        "message": { "$ref": "#/$defs/NonEmptyString" },
        "asyncApexJobId": { "$ref": "#/$defs/AsyncApexJobId" },
        "methodName": { "type": "string" },
        "apexLogId": { "$ref": "#/$defs/ApexLogId" },
        "apexClass": {
          "type": "object",
          "required": ["name", "fullName"],
          "properties": {
            "id": { "$ref": "#/$defs/ApexClassId" },
            "name": { "type": "string" },
            "namespacePrefix": { "$ref": "#/$defs/NonEmptyString" },
            "fullName": { "type": "string" }
          },
          "additionalProperties": false
        },
        "testSetupTime": { "type": "number" },
        "testTimestamp": { "$ref": "#/$defs/NonEmptyString" },
        "fullName": { "type": "string" },
        "diagnostic": { "$ref": "#/$defs/ApexDiagnostic" }
      },
      "additionalProperties": false
    },
    "ApexCompileError": {
      "type": "object",
      "required": ["operation", "message", "line", "column", "compileProblem", "_tag"],
      "properties": {
        "operation": { "$ref": "#/$defs/NonEmptyTrimmedString" },
        "message": { "type": "string" },
        "line": { "type": "number" },
        "column": { "type": "number" },
        "logBody": { "type": "string" },
        "compileProblem": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "_tag": { "type": "string", "enum": ["ApexCompileError"] }
      },
      "additionalProperties": false
    },
    "NonEmptyTrimmedString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
      "minLength": 1
    },
    "ApexOperationError": {
      "type": "object",
      "required": ["operation", "message", "_tag"],
      "properties": {
        "operation": { "$ref": "#/$defs/NonEmptyTrimmedString" },
        "message": { "type": "string" },
        "cause": { "type": "string" },
        "_tag": { "type": "string", "enum": ["ApexOperationError"] }
      },
      "additionalProperties": false
    },
    "ApexResponseDecodeError": {
      "type": "object",
      "required": ["operation", "message", "_tag"],
      "properties": {
        "operation": { "$ref": "#/$defs/NonEmptyTrimmedString" },
        "message": { "type": "string" },
        "cause": { "type": "string" },
        "_tag": { "type": "string", "enum": ["ApexResponseDecodeError"] }
      },
      "additionalProperties": false
    },
    "ApexRuntimeError": {
      "type": "object",
      "required": ["operation", "message", "line", "column", "exceptionMessage", "exceptionStackTrace", "_tag"],
      "properties": {
        "operation": { "$ref": "#/$defs/NonEmptyTrimmedString" },
        "message": { "type": "string" },
        "line": { "type": "number" },
        "column": { "type": "number" },
        "logBody": { "type": "string" },
        "exceptionMessage": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "exceptionStackTrace": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
