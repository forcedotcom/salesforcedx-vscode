{
  "name": "@salesforce/playwright-vscode-ext",
  "version": "1.7.0",
  "versionedIndependently": true,
  "description": "Shared Playwright utilities, fixtures, and page objects for end-to-end testing of Salesforce DX VS Code extensions.",
  "author": "Salesforce",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-vscode"
  },
  "bugs": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode/issues"
  },
  "homepage": "https://github.com/forcedotcom/salesforcedx-vscode/tree/develop/packages/playwright-vscode-ext",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out/**/*.js",
    "out/**/*.js.map",
    "out/**/*.d.ts",
    "out/**/*.d.ts.map",
    "LICENSE.txt",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@playwright/test": "1.60.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "^0.0.81",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@salesforce/core": "^9.1.9"
  },
  "scripts": {
    "check:circular-deps": "wireit",
    "compile": "wireit",
    "clean": "shx rm -rf node_modules .wireit out .eslintcache tsconfig.tsbuildinfo .circular-deps.json",
    "lint": "wireit",
    "test:web": "wireit",
    "test:web:ui": "DEBUG_MODE=1 pnpm --dir ../.. --filter ./packages/playwright-vscode-ext test:web --headed",
    "test:web:debug": "pnpm --dir ../.. --filter ./packages/playwright-vscode-ext test:web --debug",
    "test:desktop": "wireit",
    "test:desktop:debug": "pnpm --dir ../.. --filter ./packages/playwright-vscode-ext test:desktop --debug",
    "test": "wireit",
    "check:knip": "wireit"
  },
  "wireit": {
    "check:circular-deps": {
      "command": "dpdm --no-warning --no-tree --exit-code circular:1 -o .circular-deps.json src",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json"
      ],
      "output": [
        ".circular-deps.json"
      ]
    },
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "check:circular-deps"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "../../eslint.config.mjs"
      ],
      "output": []
    },
    "test:web": {
      "command": "playwright test --config=test/playwright/playwright.config.web.ts",
      "env": {
        "PLAYWRIGHT_WORKERS": {
          "external": true
        }
      },
      "dependencies": [
        "compile",
        "../salesforcedx-vscode-services:vscode:bundle",
        "../salesforcedx-vscode-services:spans:server"
      ],
      "files": [
        "src/**/*.ts",
        "test/playwright/**/*.ts",
        "package*.json",
        "../../.github/**"
      ],
      "output": []
    },
    "test:desktop": {
      "env": {
        "VSCODE_DESKTOP": "1",
        "E2E_FROM_VSIX": {
          "external": true
        },
        "PLAYWRIGHT_WORKERS": {
          "external": true
        }
      },
      "command": "playwright test --config=test/playwright/playwright.config.desktop.ts",
      "dependencies": [
        "compile",
        "../salesforcedx-vscode-services:vscode:bundle"
      ],
      "files": [
        "test/playwright/**/*.ts",
        "package*.json",
        "../../.github/**"
      ],
      "output": []
    },
    "test": {
      "command": "jest",
      "files": [
        "src/**/*.ts",
        "test/jest/**/*.ts",
        "jest.config.js",
        "../../config/jest.base.config.js"
      ],
      "output": [
        "coverage"
      ]
    },
    "check:knip": {
      "command": "../../node_modules/.bin/knip --directory ../.. --workspace packages/playwright-vscode-ext --cache --cache-location ../../node_modules/.cache/knip-playwright-vscode-ext --include exports,types,nsExports,nsTypes --no-config-hints",
      "files": [
        "../../*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../../.gitignore",
        "../../.pnpmfile.cjs",
        "../../{scripts,test,test-workspaces,config,.github,.opencode}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../drivable-vscode/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../drivable-vscode/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../drivable-vscode/.gitignore",
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        ".gitignore",
        "../salesforcedx-vscode-apex/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex/.gitignore",
        "../salesforcedx-vscode-apex-debugger/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-debugger/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-debugger/.gitignore",
        "../salesforcedx-vscode-apex-log/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-log/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-log/.gitignore",
        "../salesforcedx-vscode-apex-oas/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-oas/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-oas/.gitignore",
        "../salesforcedx-vscode-apex-replay-debugger/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-replay-debugger/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-replay-debugger/.gitignore",
        "../salesforcedx-vscode-apex-testing/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-testing/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-apex-testing/.gitignore",
        "../salesforcedx-vscode-core/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-core/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-core/.gitignore",
        "../salesforcedx-vscode-lightning/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-lightning/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-lightning/.gitignore",
        "../salesforcedx-vscode-lwc/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-lwc/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-lwc/.gitignore",
        "../salesforcedx-vscode-metadata/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-metadata/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-metadata/.gitignore",
        "../salesforcedx-vscode-org/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org/.gitignore",
        "../salesforcedx-vscode-org-browser/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org-browser/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-org-browser/.gitignore",
        "../salesforcedx-vscode-services/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-services/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-services/.gitignore",
        "../salesforcedx-vscode-soql/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-soql/.gitignore",
        "../salesforcedx-vscode-visualforce/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-visualforce/{src,test,typings,scripts,bin,jest,__mocks__,resources}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,yaml,yml}",
        "../salesforcedx-vscode-visualforce/.gitignore"
      ],
      "output": []
    }
  }
}
