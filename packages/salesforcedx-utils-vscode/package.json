{
  "name": "@salesforce/salesforcedx-utils-vscode",
  "displayName": "SFDX Utilities for VS Code",
  "description": "Provides utilities to interface the SFDX libraries with VS Code",
  "version": "65.7.0",
  "publisher": "salesforce",
  "license": "BSD-3-Clause",
  "categories": [
    "Other"
  ],
  "main": "out/src",
  "dependencies": {
    "@salesforce/core": "^9.3.0",
    "@salesforce/effect-ext-utils": "workspace:*",
    "@salesforce/salesforcedx-utils": "workspace:*",
    "@salesforce/vscode-service-provider": "^1.5.0",
    "effect": "^3.21.2",
    "vscode-uri": "^3.1.0",
    "zod": "^4.3.2"
  },
  "devDependencies": {},
  "engines": {
    "vscode": "^1.90.0"
  },
  "scripts": {
    "compile": "wireit",
    "lint": "wireit",
    "clean": "shx rm -rf node_modules out dist coverage .nyc_output .wireit .eslintcache",
    "test": "wireit",
    "test:compile": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "dependencies": [
        "../salesforcedx-utils:compile",
        "../effect-ext-utils:compile"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "test:compile": {
      "command": "tsc -p test/tsconfig.json",
      "dependencies": [
        "compile"
      ],
      "files": [
        "test/**/*.ts",
        "test/tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "test:compile"
      ],
      "files": [
        "test/**/*.ts",
        "vitest.config.mts",
        "../../config/vitest.base.config.mts",
        "../../config/__mocks__/o11y_schema_sf_pdp.js",
        "../../scripts/setupVitest.ts",
        "../../scripts/vscodeMock.ts"
      ],
      "output": [
        "coverage"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "../../eslint.config.mjs",
        "package.json"
      ],
      "output": []
    }
  }
}
