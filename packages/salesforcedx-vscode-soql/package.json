{
  "name": "salesforcedx-vscode-soql",
  "private": true,
  "displayName": "SOQL",
  "description": "Provides code-editing features for SOQL",
  "qna": "https://github.com/forcedotcom/salesforcedx-vscode/issues",
  "bugs": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode/issues"
  },
  "repository": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode"
  },
  "version": "67.15.2",
  "publisher": "salesforce",
  "o11yUploadEndpoint": "https://794testsite.my.site.com/byolwr/webruntime/log/metrics",
  "enableO11y": "true",
  "productFeatureId": "aJCEE0000000mLm4AI",
  "license": "BSD-3-Clause",
  "icon": "images/VSCodeSoql.png",
  "galleryBanner": {
    "color": "#ECECEC",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "soql",
    "salesforce",
    "salesforcedx",
    "sfdx",
    "soql builder"
  ],
  "dependencies": {
    "@salesforce/effect-ext-utils": "*",
    "@salesforce/soql-builder-ui": "*",
    "effect": "^3.21.2",
    "@salesforce/soql-common": "*",
    "@salesforce/soql-model": "*",
    "@salesforce/soql-language-server": "^1.1.0",
    "@salesforce/vscode-i18n": "*",
    "@salesforce/vscode-services": "*",
    "antlr4ts": "^0.5.0-alpha.3",
    "debounce": "^2.2.0",
    "papaparse": "^5.3.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.0.0",
    "@lwc/engine-dom": "^9.0.0",
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@lwc/jest-preset": "^19.6.1",
    "@lwc/rollup-plugin": "^9.3.4",
    "@lwc/synthetic-shadow": "^9.1.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-inject": "^5.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@salesforce/core": "^9.0.0",
    "@salesforce/eslint-config-lwc": "^4.1.2",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/playwright-vscode-ext": "*",
    "@salesforce/ts-types": "^3.0.0",
    "@types/debounce": "^1.2.0",
    "@types/papaparse": "^5.2.3",
    "jest-environment-jsdom": "^30.4.1",
    "rollup": "^4.0.0",
    "salesforcedx-vscode-services": "*"
  },
  "extensionDependencies": [
    "salesforce.salesforcedx-vscode-services"
  ],
  "scripts": {
    "preinstall": "node ../../scripts/require-root-install.js",
    "vscode:bundle": "wireit",
    "compile": "wireit",
    "compile:lit-ui": "wireit",
    "lint": "wireit",
    "clean": "shx rm -rf node_modules out dist dist-migration coverage .nyc_output .wireit .eslintcache *.vsix src/soql-builder-ui/dist src/soql-builder-ui/dist-lit src/soql-builder-ui/node_modules .circular-deps.json",
    "copy:grammars": "wireit",
    "build:soql-builder-ui": "wireit",
    "build:soql-builder-lit": "wireit",
    "test": "wireit",
    "test:soql-builder-ui": "wireit",
    "test:query-results-ui": "wireit",
    "test:ui-bundle-budgets": "wireit",
    "test:lit-foundation": "wireit",
    "run:web": "wireit",
    "test:web": "wireit",
    "test:web:ui": "DEBUG_MODE=1 npm run test:web -- --headed",
    "test:web:debug": "npm run test:web -- --debug",
    "test:desktop": "wireit",
    "test:desktop:debug": "npm run test:desktop -- --debug",
    "test:e2e": "wireit",
    "vscode:package": "wireit",
    "vscode:bundle:migration": "wireit",
    "vscode:package:migration": "wireit",
    "vscode:sha256": "node ../../scripts/generate-sha256.js >> ../../SHA256",
    "vscode:publish": "node ../../scripts/publish-vsix.js",
    "test:compile": "wireit",
    "vscode:package:prerelease": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "dependencies": [
        "../effect-ext-utils:compile",
        "compile:lit-ui",
        "../soql-common:compile",
        "../soql-model:compile",
        "../salesforcedx-vscode-i18n:compile",
        "../salesforcedx-vscode-services:compile"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json",
        "package.nls*.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "compile:lit-ui": {
      "command": "tsc --pretty -p tsconfig.lit.json",
      "dependencies": [
        "../soql-builder-ui:compile",
        "../soql-model:compile"
      ],
      "files": [
        "src/soql-builder-ui/lit/**/*.ts",
        "src/soql-builder-ui/modules/querybuilder/messages/i18n.ts",
        "src/soql-builder-ui/modules/querybuilder/services/globals.ts",
        "src/soql-builder-ui/modules/querybuilder/services/message/**/*.ts",
        "tsconfig.lit.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": []
    },
    "copy:grammars": {
      "command": "shx mkdir -p grammars && shx cp ../../node_modules/@salesforce/apex-tmlanguage/grammars/soql.tmLanguage ./grammars/",
      "files": [
        "../../node_modules/@salesforce/apex-tmlanguage/grammars/soql.tmLanguage"
      ],
      "output": [
        "grammars/soql.tmLanguage"
      ]
    },
    "build:soql-builder-ui": {
      "command": "cd src/soql-builder-ui && rollup -c rollup.config.mjs",
      "dependencies": [
        "../soql-model:compile"
      ],
      "files": [
        "../salesforcedx-vscode-services/src/core/schemas/sObject.ts",
        "src/soql-builder-ui/*.{ts,html}",
        "src/soql-builder-ui/modules/**",
        "src/soql-builder-ui/rollup.config.mjs"
      ],
      "output": [
        "src/soql-builder-ui/dist/**"
      ]
    },
    "build:soql-builder-lit": {
      "command": "node src/soql-builder-ui/esbuild.lit.config.mjs",
      "dependencies": [
        "compile:lit-ui",
        "../soql-builder-ui:compile"
      ],
      "files": [
        "src/soql-builder-ui/lit/**",
        "src/soql-builder-ui/modules/querybuilder/messages/i18n.ts",
        "src/soql-builder-ui/modules/querybuilder/services/globals.ts",
        "src/soql-builder-ui/modules/querybuilder/services/message/**",
        "src/soql-builder-ui/esbuild.lit.config.mjs",
        "../../scripts/bundling/web.mjs",
        "../soql-builder-ui/out/**",
        "package.json"
      ],
      "output": [
        "src/soql-builder-ui/dist-lit/**"
      ]
    },
    "test:soql-builder-ui": {
      "command": "jest --config src/soql-builder-ui/jest.config.js",
      "dependencies": [
        "../soql-builder-ui:compile",
        "../soql-model:compile"
      ],
      "files": [
        "src/soql-builder-ui/lit/**/*.ts",
        "src/soql-builder-ui/modules/**",
        "src/soql-builder-ui/jest.config.js",
        "src/soql-builder-ui/jestSetup/**",
        "test/jest/soql-builder-ui/**"
      ],
      "output": []
    },
    "test:query-results-ui": {
      "command": "jest --config jest.query-results.config.js --runInBand",
      "files": [
        "src/soql-data-view/index.html",
        "src/soql-data-view/queryDataViewController.js",
        "test/jest/queryDataView/queryDataViewController.test.ts",
        "jest.query-results.config.js",
        "../../config/jest.base.config.js",
        "../../scripts/setup-jest.ts"
      ],
      "output": []
    },
    "test:ui-bundle-budgets": {
      "command": "node scripts/check-ui-bundle-budgets.mjs",
      "dependencies": [
        "build:soql-builder-ui"
      ],
      "files": [
        "scripts/check-ui-bundle-budgets.mjs",
        "test/baselines/soql-ui-bundles.json",
        "src/soql-builder-ui/dist/app.js",
        "src/soql-data-view/index.html",
        "src/soql-data-view/queryDataViewController.js",
        "src/soql-data-view/queryDataView.css",
        "src/soql-data-view/tabulator.min.js",
        "src/soql-data-view/tabulator.min.css"
      ],
      "output": []
    },
    "test:lit-foundation": {
      "command": "node scripts/verify-lit-migration-bundle.mjs",
      "dependencies": [
        "build:soql-builder-lit"
      ],
      "files": [
        "scripts/verify-lit-migration-bundle.mjs",
        "src/soql-builder-ui/dist-lit/**"
      ],
      "output": []
    },
    "vscode:bundle": {
      "command": "node ./esbuild.config.mjs",
      "dependencies": [
        "compile",
        "copy:grammars",
        "build:soql-builder-ui"
      ],
      "files": [
        "esbuild.config.mjs",
        "../../scripts/bundling/node.mjs",
        "../../scripts/bundling/web.mjs",
        "out/**",
        "src/soql-builder-ui/dist/**",
        "src/soql-data-view/**"
      ],
      "output": [
        "dist"
      ]
    },
    "vscode:bundle:migration": {
      "command": "node scripts/build-lit-migration.mjs",
      "dependencies": [
        "compile",
        "copy:grammars",
        "test:lit-foundation"
      ],
      "files": [
        "esbuild.config.mjs",
        "scripts/build-lit-migration.mjs",
        "scripts/verify-lit-migration-parity.mjs",
        "../../scripts/bundling/node.mjs",
        "../../scripts/bundling/web.mjs",
        "out/**",
        "src/soql-builder-ui/dist-lit/**",
        "src/soql-data-view/**"
      ],
      "output": [
        "dist-migration"
      ]
    },
    "vscode:bundle:local": {
      "command": "node ./esbuild.config.mjs",
      "dependencies": [
        "compile",
        "copy:grammars",
        "build:soql-builder-ui",
        "../salesforcedx-vscode-services:vscode:bundle:local"
      ],
      "files": [
        "esbuild.config.mjs",
        "../../scripts/bundling/node.mjs",
        "../../scripts/bundling/web.mjs",
        "out/**",
        "src/soql-builder-ui/dist/**",
        "src/soql-data-view/**"
      ],
      "output": [
        "dist"
      ]
    },
    "run:web": {
      "command": "npx vscode-test-web --browserType=chromium --browserOption=--disable-web-security --browserOption=--remote-debugging-port=9222 --extensionDevelopmentPath . --extensionPath ../salesforcedx-vscode-services --extensionPath ../salesforcedx-vscode-metadata --open-devtools --port 3001 --quality stable --verbose --printServerLog",
      "service": true,
      "dependencies": [
        "vscode:bundle:local",
        "../salesforcedx-vscode-services:vscode:bundle:local",
        "../salesforcedx-vscode-metadata:vscode:bundle:local"
      ],
      "files": []
    },
    "test": {
      "command": "jest",
      "dependencies": [
        "test:compile"
      ],
      "files": [
        "test/**/*.ts",
        "jest.config.js",
        "../../config/jest.base.config.js"
      ],
      "output": [
        "coverage"
      ]
    },
    "lint": {
      "command": "../../node_modules/.bin/eslint --color .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "check:circular-deps",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.html",
        "test/**/*.ts",
        "../../eslint.config.mjs",
        ".vscodeignore",
        "package.json",
        "package.nls.json"
      ],
      "output": []
    },
    "check:circular-deps": {
      "command": "dpdm --no-warning --no-tree --exit-code circular:1 --output .circular-deps.json --exclude \"node_modules|out\" src/index.ts",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "package.json"
      ],
      "output": [
        ".circular-deps.json"
      ]
    },
    "test:web": {
      "command": "playwright test --config=test/playwright/playwright.config.web.ts",
      "env": {
        "PLAYWRIGHT_WORKERS": {
          "external": true
        }
      },
      "dependencies": [
        "vscode:bundle",
        "../salesforcedx-vscode-services:vscode:bundle",
        "../salesforcedx-vscode-services:spans:server",
        "../salesforcedx-vscode-metadata:vscode:bundle",
        "../playwright-vscode-ext:compile",
        "../soql-builder-ui:test:browser"
      ],
      "files": [
        "test/playwright/**/*.ts",
        "package*.json",
        "../../.github/**"
      ],
      "output": []
    },
    "test:desktop": {
      "command": "playwright test --config=test/playwright/playwright.config.desktop.ts",
      "env": {
        "VSCODE_DESKTOP": "1",
        "E2E_FROM_VSIX": {
          "external": true
        },
        "PLAYWRIGHT_WORKERS": {
          "external": true
        }
      },
      "dependencies": [
        "vscode:package",
        "../salesforcedx-vscode-services:vscode:package",
        "../salesforcedx-vscode-metadata:vscode:package",
        "../playwright-vscode-ext:compile"
      ],
      "files": [
        "test/playwright/**/*.ts",
        "package*.json",
        "../../.github/**"
      ],
      "output": []
    },
    "test:e2e": {
      "dependencies": [
        "test:web",
        "test:desktop"
      ]
    },
    "vscode:package": {
      "command": "vsce package --allow-package-all-secrets",
      "dependencies": [
        "vscode:bundle"
      ],
      "files": [
        ".vscodeignore",
        "package.json",
        "package.nls*.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.txt",
        "images/**",
        "grammars/**"
      ],
      "output": [
        "*.vsix"
      ]
    },
    "vscode:package:migration": {
      "command": "node scripts/package-lit-migration.mjs",
      "dependencies": [
        "vscode:bundle:migration"
      ],
      "files": [
        "scripts/package-lit-migration.mjs",
        ".vscodeignore",
        "package.json",
        "package.nls*.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.txt",
        "images/**",
        "grammars/**"
      ],
      "output": [
        "salesforcedx-vscode-soql-lit-migration.vsix"
      ]
    },
    "test:compile": {
      "command": "tsc -p test/tsconfig.json",
      "dependencies": [
        "compile",
        "../playwright-vscode-ext:compile"
      ],
      "files": [
        "test/**/*.ts",
        "test/tsconfig.json"
      ],
      "output": []
    },
    "vscode:package:prerelease": {
      "command": "vsce package --allow-package-all-secrets --pre-release",
      "dependencies": [
        "vscode:bundle"
      ],
      "files": [
        ".vscodeignore",
        "package.json",
        "package.nls*.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.txt",
        "images/**",
        "grammars/**"
      ],
      "output": [
        "*.vsix"
      ]
    }
  },
  "main": "dist/index.js",
  "browser": "dist/web/index.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "soqlCustom.soql",
        "displayName": "%soqlCustom_soql%",
        "selector": [
          {
            "filenamePattern": "*.soql"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "soql",
        "aliases": [
          "soql",
          "SOQL"
        ],
        "extensions": [
          ".soql"
        ]
      }
    ],
    "grammars": [
      {
        "language": "soql",
        "scopeName": "source.soql",
        "path": "./grammars/soql.tmLanguage"
      }
    ],
    "commands": [
      {
        "command": "soql.open.new.builder",
        "title": "%soql_open_new_builder%"
      },
      {
        "command": "soql.open.new.text.editor",
        "title": "%soql_open_new_text_editor%"
      },
      {
        "command": "soql.builder.toggle",
        "title": "%soql_builder_toggle%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "soql.walkthrough.open",
        "title": "%soql_walkthrough_open%"
      },
      {
        "command": "sf.data.query.selection",
        "title": "%data_query_selection_text%"
      },
      {
        "command": "sf.data.query.document",
        "title": "%data_query_document_text%"
      },
      {
        "command": "sf.data.query.explain.selection",
        "title": "%query_plan_selection_text%"
      },
      {
        "command": "sf.data.query.explain.document",
        "title": "%query_plan_document_text%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "soql.open.new.builder",
          "when": "sf:project_opened"
        },
        {
          "command": "soql.open.new.text.editor",
          "when": "sf:project_opened"
        },
        {
          "command": "soql.builder.toggle",
          "when": "false"
        },
        {
          "command": "soql.walkthrough.open",
          "when": "sf:project_opened"
        },
        {
          "command": "sf.data.query.selection",
          "when": "sf:project_opened && editorHasSelection && sf:has_target_org"
        },
        {
          "command": "sf.data.query.document",
          "when": "sf:project_opened && resourceExtname == .soql && sf:has_target_org"
        },
        {
          "command": "sf.data.query.explain.selection",
          "when": "sf:project_opened && editorHasSelection && sf:has_target_org"
        },
        {
          "command": "sf.data.query.explain.document",
          "when": "sf:project_opened && resourceExtname == .soql && sf:has_target_org"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .soql",
          "command": "soql.builder.toggle",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%configuration_title%",
      "properties": {
        "salesforcedx-vscode-soql.experimental.validateQueries": {
          "type": "boolean",
          "default": false,
          "description": "%soql_validation_flag%"
        },
        "salesforcedx-vscode-soql.maxQueryLimit": {
          "type": "integer",
          "default": 50000,
          "minimum": 1,
          "description": "%soql_max_query_limit%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "soqlWalkthrough",
        "title": "%soql_walkthrough_title%",
        "description": "%soql_walkthrough_description%",
        "steps": [
          {
            "id": "step1",
            "title": "%soql_walkthrough_step1_title%",
            "description": "%soql_walkthrough_step1_description%",
            "media": {
              "image": "images/soql-builder-walkthrough.gif",
              "altText": "%soql_walkthrough_step1_alt%"
            }
          },
          {
            "id": "step2",
            "title": "%soql_walkthrough_step2_title%",
            "description": "%soql_walkthrough_step2_description%",
            "media": {
              "image": "images/soql-builder-walkthrough.gif",
              "altText": "%soql_walkthrough_step2_alt%"
            },
            "completionEvents": [
              "onCommand:soql.open.new.builder"
            ]
          },
          {
            "id": "step3",
            "title": "%soql_walkthrough_step3_title%",
            "description": "%soql_walkthrough_step3_description%",
            "media": {
              "image": "images/soql-builder-walkthrough.gif",
              "altText": "%soql_walkthrough_step3_alt%"
            }
          },
          {
            "id": "step4",
            "title": "%soql_walkthrough_step4_title%",
            "description": "%soql_walkthrough_step4_description%",
            "media": {
              "image": "images/soql-builder-walkthrough.gif",
              "altText": "%soql_walkthrough_step4_alt%"
            }
          },
          {
            "id": "step5",
            "title": "%soql_walkthrough_step5_title%",
            "description": "%soql_walkthrough_step5_description%",
            "media": {
              "image": "images/soql-builder-walkthrough.gif",
              "altText": "%soql_walkthrough_step5_alt%"
            }
          },
          {
            "id": "step6",
            "title": "%soql_walkthrough_step6_title%",
            "description": "%soql_walkthrough_step6_description%",
            "media": {
              "image": "images/soql-builder-walkthrough.gif",
              "altText": "%soql_walkthrough_step6_alt%"
            }
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onLanguage:soql"
  ]
}
