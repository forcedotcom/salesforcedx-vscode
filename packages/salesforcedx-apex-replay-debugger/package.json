{
  "name": "@salesforce/salesforcedx-apex-replay-debugger",
  "displayName": "Apex Replay Debug Adapter",
  "description": "Implements the VS Code Debug Protocol for the Apex Replay Debugger",
  "version": "65.7.0",
  "publisher": "salesforce",
  "preview": true,
  "license": "BSD-3-Clause",
  "main": "out/src",
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Debuggers"
  ],
  "dependencies": {
    "@salesforce/salesforcedx-utils": "workspace:*",
    "@salesforce/vscode-i18n": "workspace:*",
    "@vscode/debugadapter": "1.68.0",
    "effect": "^3.21.2",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@salesforce/vscode-service-provider": "^1.5.0",
    "@vscode/debugadapter-testsupport": "1.68.0",
    "@vscode/debugprotocol": "1.68.0"
  },
  "scripts": {
    "compile": "wireit",
    "lint": "wireit",
    "clean": "shx rm -rf node_modules out dist coverage .nyc_output .wireit .eslintcache",
    "test": "wireit",
    "test:integration": "wireit",
    "test:compile": "wireit",
    "check:effect-diagnostics": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "dependencies": [
        "../salesforcedx-utils:compile",
        "../salesforcedx-vscode-i18n:compile"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "test:compile": {
      "command": "tsc -p test/tsconfig.json",
      "dependencies": [
        "compile"
      ],
      "files": [
        "test/**/*.ts",
        "test/tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "test:compile"
      ],
      "files": [
        "test/**/*.ts",
        "vitest.config.mts",
        "../../config/vitest.base.config.mts",
        "../../config/__mocks__/o11y_schema_sf_pdp.js",
        "../../scripts/setupVitest.ts",
        "../../scripts/vscodeMock.ts"
      ],
      "output": [
        "coverage"
      ]
    },
    "test:integration": {
      "command": "vitest run --config vitest.integration.config.mts",
      "dependencies": [
        "test",
        "../salesforcedx-vscode-apex-replay-debugger:vscode:bundle",
        "../salesforcedx-vscode-apex-replay-debugger:test"
      ],
      "files": [
        "test/integration/**",
        "vitest.integration.config.mts",
        "package.json",
        "../../pnpm-lock.yaml"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "../../eslint.config.mjs",
        "package.json",
        "package.nls.json"
      ],
      "output": []
    },
    "check:effect-diagnostics": {
      "command": "node ../../scripts/effect-diagnostics.mjs .",
      "dependencies": [
        "compile"
      ],
      "files": [
        "../../config/effect-diagnostics.json",
        "../../scripts/effect-diagnostics.mjs"
      ],
      "output": []
    }
  }
}
