{
  "name": "@salesforce/soql-builder-ui",
  "version": "0.1.0",
  "versionedIndependently": true,
  "description": "Framework-driven SOQL Builder UI for VS Code webviews and standalone browser hosts",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-vscode.git",
    "directory": "packages/soql-builder-ui"
  },
  "bugs": {
    "url": "https://github.com/forcedotcom/salesforcedx-vscode/issues"
  },
  "homepage": "https://github.com/forcedotcom/salesforcedx-vscode/tree/main/packages/soql-builder-ui#readme",
  "type": "module",
  "main": "out/src/index.js",
  "types": "out/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.d.ts",
      "default": "./out/src/index.js"
    }
  },
  "files": [
    "out/**/*.js",
    "out/**/*.d.ts",
    "out/**/*.d.ts.map",
    "LICENSE.txt",
    "README.md"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "preinstall": "node ../../scripts/require-root-install.js",
    "compile": "wireit",
    "lint": "wireit",
    "clean": "shx rm -rf node_modules out coverage .wireit .eslintcache .circular-deps.json",
    "test": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "test": {
      "command": "node --test test/**/*.test.mjs",
      "dependencies": [
        "compile"
      ],
      "files": [
        "out/**",
        "test/**/*.test.mjs"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "check:circular-deps",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.mjs",
        "../../eslint.config.mjs",
        "package.json"
      ],
      "output": []
    },
    "check:circular-deps": {
      "command": "dpdm --no-warning --no-tree --exit-code circular:1 --output .circular-deps.json src/index.ts",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "package.json"
      ],
      "output": [
        ".circular-deps.json"
      ]
    }
  },
  "dependencies": {
    "@vscode-elements/elements": "2.5.1",
    "lit": "3.3.3"
  }
}
