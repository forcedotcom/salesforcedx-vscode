{
  "name": "@salesforce/soql-builder-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Lit and Effect foundation for the SOQL Builder",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-vscode.git",
    "directory": "packages/soql-builder-ui"
  },
  "type": "module",
  "exports": {
    "./application": {
      "types": "./out/src/application.d.ts",
      "default": "./out/src/application.js"
    },
    "./components/soqlBuilderApp": {
      "types": "./out/src/components/soqlBuilderApp.d.ts",
      "default": "./out/src/components/soqlBuilderApp.js"
    },
    "./domain": {
      "types": "./out/src/domain.d.ts",
      "default": "./out/src/domain.js"
    },
    "./register": {
      "types": "./out/src/register.d.ts",
      "default": "./out/src/register.js"
    },
    "./service": {
      "types": "./out/src/effect/soqlBuilderService.d.ts",
      "default": "./out/src/effect/soqlBuilderService.js"
    }
  },
  "sideEffects": true,
  "scripts": {
    "preinstall": "node ../../scripts/require-root-install.js",
    "compile": "wireit",
    "bundle": "wireit",
    "lint": "wireit",
    "clean": "shx rm -rf node_modules out dist coverage .wireit .eslintcache .circular-deps.json",
    "test": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.common.json",
        "package.json"
      ],
      "output": [
        "out/**"
      ]
    },
    "bundle": {
      "command": "node esbuild.config.mjs",
      "dependencies": [
        "compile"
      ],
      "files": [
        "out/**",
        "esbuild.config.mjs",
        "package.json"
      ],
      "output": [
        "dist/app.js"
      ]
    },
    "test": {
      "command": "node --test test/**/*.test.mjs",
      "dependencies": [
        "bundle"
      ],
      "files": [
        "out/**",
        "dist/app.js",
        "test/**/*.test.mjs",
        "../../scripts/release-package-selection.js",
        "package.json"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache .",
      "dependencies": [
        "../eslint-local-rules:compile",
        "check:circular-deps",
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.mjs",
        "esbuild.config.mjs",
        "../../eslint.config.mjs",
        "package.json"
      ],
      "output": []
    },
    "check:circular-deps": {
      "command": "dpdm --no-warning --no-tree --exit-code circular:1 --output .circular-deps.json src/register.ts",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "package.json"
      ],
      "output": [
        ".circular-deps.json"
      ]
    }
  },
  "dependencies": {
    "@vscode-elements/elements": "2.5.1",
    "effect": "^3.21.2",
    "lit": "3.3.3"
  }
}
