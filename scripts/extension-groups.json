{
  "requiredExtensions": ["salesforcedx-vscode-core", "salesforcedx-vscode-services", "salesforcedx-vscode-org"],
  "groups": {
    "apex-log": {
      "label": "Apex Log",
      "extensions": ["salesforcedx-vscode-apex", "salesforcedx-vscode-apex-log"]
    },
    "apex-testing": {
      "label": "Apex Testing",
      "extensions": ["salesforcedx-vscode-apex-testing"]
    },
    "org-browser": {
      "label": "Org Browser",
      "extensions": ["salesforcedx-vscode-org-browser", "salesforcedx-vscode-metadata"]
    },
    "metadata": {
      "label": "Metadata",
      "extensions": ["salesforcedx-vscode-metadata"]
    },
    "apex-replay-debugger": {
      "label": "Apex Replay Debugger",
      "extensions": [
        "salesforcedx-vscode-apex-replay-debugger",
        "salesforcedx-vscode-apex",
        "salesforcedx-vscode-apex-log"
      ]
    },
    "lwc": {
      "label": "Lightning Web Components",
      "extensions": ["salesforcedx-vscode-lwc"]
    },
    "soql": {
      "label": "SOQL",
      "extensions": ["salesforcedx-vscode-soql"]
    }
  }
}
