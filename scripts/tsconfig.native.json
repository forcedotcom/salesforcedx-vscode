{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "**/*.mts",
    "**/*.cts",
    "../test/**/*.mts",
    "../test/**/*.cts",
    "../packages/salesforcedx-vscode-services-types/scripts/**/*.mts",
    "../packages/salesforcedx-lightning-lsp-common/scripts/**/*.mts",
    "../packages/salesforcedx-lightning-lsp-common/scripts/**/*.d.ts",
    "../packages/salesforcedx-aura-language-server/scripts/**/*.mts",
    "../packages/salesforcedx-lwc-language-server/scripts/**/*.mts"
  ]
}
