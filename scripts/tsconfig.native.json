{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "**/*.mts",
    "**/*.cts",
    "../test/**/*.mts",
    "../test/**/*.cts",
    "../packages/salesforcedx-vscode-services-types/scripts/**/*.mts",
    "../packages/salesforcedx-apex/scripts/**/*.mts",
    "../packages/salesforcedx-vscode-apex-log/scripts/**/*.mts",
    "../packages/salesforcedx-vscode-services/scripts/**/*.mts"
  ]
}
