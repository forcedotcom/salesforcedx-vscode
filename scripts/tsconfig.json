{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "types": ["jest", "node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["*.ts"],
  "exclude": ["category-approve.ts"]
}
