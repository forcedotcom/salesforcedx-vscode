{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "drivable-vscode": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "pnpm --filter @salesforce/drivable-vscode compile >&2 && exec node packages/drivable-vscode/bin/drivable-vscode-mcp.js"
        ],
        "timeout": {
          "startup": 120000
        }
      }
    }
  }
}
