// https://www.typescriptlang.org/tsconfig#extends
// The configuration from this file is loaded first, then overridden by those in the inheriting config file. But path-based compiler options (outDir, outFile, rootDir, include, exclude, files) are resolved from the config file they're found in. They cannot be extended (https://github.com/microsoft/TypeScript/issues/29172).
// Config ref: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html
{
  // https://github.com/microsoft/TypeScript/wiki/Node-Target-Mapping
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "paths": {
      "salesforcedx-vscode-services": ["./packages/salesforcedx-vscode-services/out/src/index.d.ts"]
    },
    "noImplicitAny": true,
    // TODO: cleanup unknown usage in catch blocks and remove below setting
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "allowSyntheticDefaultImports": true,
    // Error pins in diagnosticSeverity are "error" (most default to "off" upstream, so they report nothing until pinned); the build gate is config/effect-diagnostics.json enforcedRules. effectFnOpportunity is a "warning" editor override and stays out of enforcedRules.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalFetchInEffect": "error",
          "globalTimersInEffect": "error",
          "missedPipeableOpportunity": "error",
          "nestedEffectGenYield": "error",
          "effectFnOpportunity": "warning"
        }
      },
      { "name": "@salesforce/vscode-i18n/tsPlugin" }
    ]
  }
}
